<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        CVE-2020-29582: False positive on kotlin-stdlib and kotlin-reflect.
        This CVE describes insecure temporary file creation in JetBrains Ktor (web framework),
        not in kotlin-stdlib or kotlin-reflect. The NVD CPE match is overly broad.
    -->
    <suppress>
        <notes>False positive — CVE-2020-29582 affects JetBrains Ktor, not kotlin-stdlib/reflect</notes>
        <gav regex="true">^org\.jetbrains\.kotlin:kotlin-.*$</gav>
        <cve>CVE-2020-29582</cve>
    </suppress>
</suppressions>
