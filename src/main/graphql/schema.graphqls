  """
  Human readable text for return offer status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""This type indicates the offer has been declined by the offeree."""
type ReturnOfferDeclined implements ReturnOfferStatus {
  """A machine-readable return offer status code: `DECLINED`"""
  code: String!
  """
  Human readable text for return offer status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type indicates the offer has expired due to no response from the offeree within the specified time frame.
"""
type ReturnOfferExpired implements ReturnOfferStatus {
  """A machine-readable return offer status code: `EXPIRED`"""
  code: String!
  """
  Human readable text for return offer status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type indicates the offer has been made and is awaiting offeree's response.
"""
type ReturnOfferPending implements ReturnOfferStatus {
  """A machine-readable return offer status code: `PENDING`"""
  code: String!
  """
  Human readable text for return offer status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This interface provides the status of the proposed keep-item partial refund offer.
"""
interface ReturnOfferStatus {
  """
  A machine-readable code identifying the return offer status. For example, `PENDING`, `ACCEPTED`, `DECLINED`, `EXPIRED`.
    
  **Format:** Alphanumeric with underscores
  **Maximum length:** 100 characters
  """
  code: String!
  """
  Human readable text for return offer status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This union type represents all possible return offer terms.

**Note:** This union is forward-compatible. New types may be added without notice.
"""
union ReturnOfferTerm = KeepItemPartialRefundTerm

"""
This type indicates the return is approved by the seller or eBay admin, awaiting processing, in both code and a human-readable description.
"""
type ReturnOpen implements ReturnStatus {
  """A machine-readable code providing the return status: `OPEN`"""
  code: String!
  """
  A human-readable description of the return status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type provides the business policy's options for returns including if returns are accepted, who pays for return shipping, and how refunds are issued.
"""
type ReturnOptions {
  """ This field indicates the refund method offered by the seller. Its value will be MONEY_BACK unless the seller is enabled for Buy online, Pickup in Store or Click and Collect, and then it might be MERCHANDISE_CREDIT. Can be null when returns are not accepted or when not specified. Getting their money back for returned items is always an option for buyers, regardless of what the seller sets in this field. Occurrence: Always 
  """
  refundMethod: RefundType
  """
  The number of calendar days the buyer has to return the item, starting from the date the item is recorded as delivered to the buyer's ship-to address. Most categories support 30-day and 60-day return periods. This field is present only when **returnsAccepted** is `true` and may be null when returns are not accepted or when not specified.
  
  **Occurrence:** Conditional
  """
  returnPeriodInDays: Int
  """
  This field indicates who is responsible for paying for the shipping charges for returning the item. The field can be set to either `BUYER` or `SELLER`. Present only when the **returnsAccepted** field is `true` and may be null when returns are not accepted or when not specified. Responsibility may vary based on the return reason and policy. The seller is always responsible for return shipping costs for 'significantly not as described' (SNAD) issues.
  
  **Occurrence:** Conditional
  """
  returnShippingPaidBy: Invoicee
  """
  Indicates whether the seller accepts returns for this policy.
  - `true`: Returns are accepted 
  - `false`: Returns are not accepted
  
  **Occurrence:** Always
  """
  returnsAccepted: Boolean!
}

"""
This type represents the constraints defined for partial refund terms input.
"""
type ReturnPartialRefundTermConstraint {
  """This object provides the allowed percentage range."""
  allowedPercentageRange: InputPercentageRange!
}

"""
This type provides return specific information about a seller's return policy, including options on whether returns are accepted, who pays for return shipping, and how refunds are issued.
"""
type ReturnPolicyDetails {
  """Return options for domestic returns."""
  domesticReturnOptions: ReturnOptions!
  """Return options for international returns."""
  internationalReturnOptions: ReturnOptions!
  """
  This optional text-based field provides more details on seller-specified return instructions. May be null if no instructions were provided by the seller. This field is no longer supported on many eBay marketplaces. To see if a marketplace and eBay category does support this field, call the <a href="https://developer.ebay.com/api-docs/sell/metadata/resources/marketplace/methods/getReturnPolicies" target="_blank">getReturnPolicies</a> method of the **Metadata API**. 
  
  **Maximum length:** 8000 characters
  """
  returnInstructions: String
}

"""
This error type indicates that the associated return preference could not be found.
"""
type ReturnPreferenceNotFoundError implements BusinessError {
  """A machine-readable error code `RTRN_PREFERENCE_NOT_FOUND`"""
  errorCode: String!
  """
  A human-readable error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
}

"""
An enumerated type that indicates whether the seller's Return Merchandise Authorization (RMA) number requirement is enabled or disabled.
"""
enum ReturnPreferenceStatus {
  """
  This value indicates the seller's RMA requirement is inactive (returns do not require an RMA).
  """
  DISABLED
  """
  This value indicates the seller's RMA requirement is active (returns require an RMA).
  """
  ENABLED
}

"""
This interface provides possible reasons that a member could provide while requesting return.
"""
interface ReturnReason {
  """
  A machine-readable code identifying the return reason. Examples include: `DID_NOT_LIKE_ITEM`, `ORDERED_ACCIDENTALLY`, `ORDERED_WRONG_SIZE`, and similar codes in alphanumeric format with underscores.
    
  **Maximum length:** 100 characters
  """
  code: String!
  """
  A human-readable return reason that is intended for display only. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters.
  """
  displayText: String!
}

"""This type restricts conditions to one or more allowed return reasons."""
type ReturnReasonCondition {
  """One or more return reasons."""
  returnReasonList: [ReturnReason!]!
}

"""
This input type defines the return reasons applicable to an automation return rule template.
"""
input ReturnReasonConditionInput {
  """
  A list of one or more return reasons configured for an automation return rule template.
  """
  returnReasons: [ReturnReasonInput!]!
}

"""
This enumerated type provides values for the reason of a return. Available values can change based on the return request and category of the item. In countries where the Return reason is not mandatory to provide, it returns as `UNDISCLOSED`.
"""
enum ReturnReasonInput {
  """The item is returned because it is counterfeit."""
  COUNTERFEIT
  """The item is returned because it was damaged when received."""
  DAMAGED_ITEM_RECEIVED
  """The item is returned because it is defective."""
  DEFECTIVE
  """
  The buyer is returning the item due to personal preference (they did not like the item).
  """
  DID_NOT_LIKE_ITEM
  """The item is being returned because it did not fit the vehicle."""
  FIT_COMPATIBILITY_ISSUE
  """The item is returned because the buyer found a better price."""
  FOUND_BETTER_PRICE
  """
  The item is returned because one or more parts of the item were missing.
  """
  MISSING_PARTS
  """The item is returned because it was not as described."""
  NOT_AS_DESCRIBED
  """The item is returned as the item is no longer needed."""
  NO_LONGER_NEED_ITEM
  """The item is returned because the buyer purchased it accidentally."""
  ORDERED_ACCIDENTALLY
  """The item is returned because the buyer purchased the wrong size."""
  ORDERED_WRONG_SIZE
  """The customer did not disclose the reason for the return."""
  UNDISCLOSED
  """
  The item is returned as the wrong item was received instead of the one that was purchased.
  """
  WRONG_ITEM_RECEIVED
}

"""
This type indicates that customer did not disclose the reason for the return and displays as **Undisclosed**.
"""
type ReturnReasonUndisclosed implements ReturnReason {
  """A machine-readable reason code: `UNDISCLOSED`"""
  code: String!
  """
  A human-readable description of the return reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This action type represents the action to refer a return case (escalate or appeal) to eBay for help or further review. The action becomes available when the participant is eligible to escalate the return, and includes the list of valid referral reasons that can be selected during submission.
"""
type ReturnReferralAction implements ReturnAction {
  """A machine-readable return action code: `REFER_RETURN_TO_EBAY`"""
  code: String!
  """
  Human readable text for the return action. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
  """
  This list of one or more actions to refer (escalate) an order return for eBay's help or further review, becomes available when the participant is eligible to escalate the return and includes the list of valid referral reasons that may be selected by the user.
  """
  referralReasons: [ReturnReferralReason!]!
}

"""This type represents the constraints defined for return referral."""
type ReturnReferralConstraint {
  """
  List of valid referral reason codes that can be used when submitting a return referral.
  """
  validReferralReasons: [ReturnReferralReason!]!
}

"""
This union type represents the list of referral reasons applicable in return cases. Each reason describes a scenario under which the buyer or seller may refer the return case to eBay for help. All types implement the `PostPurchaseCaseReferralReason` interface and expose a machine-readable `code`.
"""
union ReturnReferralReason = DamagedItemReturned | NoRefundForReturnShipping | OtherReferralReason | ReceivedEmptyBox | RefundNotReceived | RefundedBuyer | ReplacementSent | ReturnNotReceived | ReturnedWrongItem | UnableToReachAgreement | UnresponsiveTradingPartner

"""
This type represents the violations related to referral return reasons.
"""
type ReturnReferralReasonViolation implements SubmitReturnReferralInputViolation {
  """
  A machine-readable code identifying the specific rule that was violated (for example, `RETURN_REFERRAL_REASON_VIOLATION`).
  """
  code: String!
  """Defines the constraints for the return referral."""
  constraint: ReturnReferralConstraint!
  """
  A human-readable message describing the rule violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  Indicates whether the provided referral reason code is invalid or not recognized.
  """
  invalidReferralReason: Boolean!
}

"""
This type represents the range for total refund. The maximum refund amount (**max**) must be greater than the minimum refund amount (**min**). Both **min** and **max** are inclusive.
- if only **max** is specified: The range is **0** to **max**
- if only **min** is specified: The range is **min** to infinity
- negative values will not be accepted
"""
type ReturnRefundRangeCondition {
  """The maximum refund amount."""
  maxRefundAmount: Amount
  """The minimum refund amount."""
  minRefundAmount: Amount!
}

"""
This input type defines the refund range applicable for an automation return rule template:
- if a minimum and maximum are both provided, minimum must be less than or equal to maximum
- if only maximum is provided, the range is `0` to maximum
- negative values will not be accepted
- values are set in currency of listing marketplace
"""
input ReturnRefundRangeConditionInput {
  """Maximum refund amount in currency of listing marketplace."""
  maxAmountInListingCurrency: Decimal!
  """
  The minimum refund amount in currency of listing marketplace. The currency for minimum and maximum must be the same. 
    
  **Note:** A value of `0.0` indicates no minimum.
    
  **Default**: `0.0`
  """
  minAmountInListingCurrency: Decimal = 0
}

"""
This error type indicates that refund terms are required but were not provided in the request.
"""
type ReturnRefundTermsRequiredError implements BusinessError {
  """A machine-readable error code: `RTRN_REFUND_TERMS_REQUIRED`"""
  errorCode: String!
  """
  A human-readable error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
}

"""
This type indicates the return is requested by the buyer or eBay administration, is pending approval, in both code and a human-readable description.
"""
type ReturnRequested implements ReturnStatus {
  """A machine-readable code providing the return status: `REQUESTED`"""
  code: String!
  """
  A human-readable description of the return status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This error type indicates that the request contains an empty line item list, which is not allowed.
"""
type ReturnRequestLineItemRequiredError implements BusinessError {
  """A machine-readable error code: `RTRN_REQ_LINE_ITEM_REQUIRED`"""
  errorCode: String!
  """
  A human-readable error message. 
    
  **Maximum length:** 512 characters 
  **Format:** Alphanumeric
  """
  errorMessage: String!
}

"""
This type represents a required, time-sensitive, primary return action for a specific return, with a due date for completing the action. Use this type to highlight time-sensitive actions required from a buyer or seller.
"""
type ReturnRespondByAction {
  """The required action."""
  respondAction: ReturnAction!
  """The due date for completing the action."""
  responseDueAt: DateTime!
}

"""
This type represents a return response where the buyer keeps the item and no return shipment to the seller is required.
"""
type ReturnResponseKeepItemStrategy implements ReturnResponseStrategy {
  """
  A machine-readable code identifying the rule response strategy: `AUTO_REFUND_KEEP_ITEM`
  """
  code: String!
  """
  A human-readable description of the rule outcome. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type represents a return response where the return request is automatically approved and the buyer must ship the item back to the seller.
"""
type ReturnResponseReturnItemStrategy implements ReturnResponseStrategy {
  """
  A machine-readable code identifying the rule response strategy: `AUTO_APPROVE_RETURN_ITEM`
  """
  code: String!
  """
  A human-readable description of the rule outcome. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type defines the automated response applied to a return request when specific conditions are met. Evaluated during the approval phase of the return workflow, based on the matching conditions in the **conditionSet** whether to instruct the buyer to return the item or allow the buyer to keep it as specified by the corresponding response strategy defined in **responseStrategy**. When the rule outcome corresponds to:
- `APPROVE_RETURN_THE_ITEM`: The buyer is instructed to return the item within the specified return window. A refund is issued once the returned item is received or validated.
- `APPROVE_KEEP_THE_ITEM`: The buyer is allowed to keep the item without returning it, and a refund is issued automatically.
"""
type ReturnResponseRule implements ReturnAutomationRule {
  """
  The conditions associated with this rule. Each set can encapsulate multiple **conditions**.
  """
  conditionSet: ReturnRuleConditionSet!
  """
  The unique name for the rule. No two rules can have the same name.
  Allowed characters: [A-Z, a-z, 0-9, hyphen(-), underscore(_), period(.), colon(:), comma(,), apostrophe(')]
  **Maximum length:** 100 characters
  Format: Alphanumeric
  """
  name: String!
  """
  The rules are processed by ascending priority value (the lowest priority number first). Evaluation stops at the first matching rule. This means that a rule with priority 1 will always be considered before a rule with priority 5. 
    
  **Note:** Each rule must have a unique priority number.
  """
  priority: Int!
  """The automated response to apply when this rule matches."""
  responseStrategy: ReturnResponseStrategy!
  """The unique identifier for the rule."""
  ruleId: ID!
  """
  The current status of the rule. 
    
  **Note:** Only rules with `ENABLED` status are applied.
  """
  status: SellerReturnRuleStatus!
}

"""
This type represents the strategy the system uses to automatically respond to a return when the conditions of a **ReturnResponse** rules are satisfied. Each strategy defines a specific method for determining the automated
response the system should apply to the return.
"""
interface ReturnResponseStrategy {
  """
  A machine-readable code identifying the rule response strategy
    
  **Format:** Alphanumeric with underscores
  **Maximum length:** 50 characters
  """
  code: String!
  """
  A human-readable description of the rule outcome. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This enumerated type provides values that determines how a return request is automatically handled by the system. The values are fixed, non-localized codes that can be safely used in automation logic, integrations, and API responses.
"""
enum ReturnResponseStrategyInput {
  """
  This value automatically refunds the buyer without requiring the item to be shipped back to the seller. This is typically used when the item value is low, return shipping is impractical, or the seller opts to provide a goodwill refund.
  """
  APPROVE_KEEP_THE_ITEM
  """
  This value automatically approves the buyer's return request and requires the item to be shipped back to the seller before a refund is issued. This outcome accelerates the approval flow while still enforcing return-shipment requirements.
  """
  APPROVE_RETURN_THE_ITEM
}

"""
This type represents the validation constraints defined for Return Merchandise Authorization (RMA) number input.
"""
type ReturnRmaNumberConstraint {
  """
  The allowed range for the number of characters (minimum and maximum) allowed for the return RMA number input.
  """
  characterLimit: InputTextLengthRange!
  """When `true`, this value indicates an RMA number is required."""
  rmaNumberRequired: Boolean!
}

"""This type represents the return RMA number input violations."""
type ReturnRmaNumberViolation implements ProvideRmaNumberInputViolation {
  """
  A machine-readable code identifying the specific rule that was violated (for example, `RETURN_RMA_NUMBER_VIOLATION`).
  """
  code: String!
  """Indicates the constraints defined for return RMA number input."""
  constraint: ReturnRmaNumberConstraint!
  """Indicates whether the return note contains invalid characters."""
  containsInvalidCharacters: Boolean!
  """
  A human-readable message describing the rule violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """Indicates whether the return note exceeded the allowed length."""
  exceededLength: Boolean!
}

"""This union type contains all supported condition types."""
union ReturnRuleCondition = ReturnItemCategoryCondition | ReturnItemLocationCountryCondition | ReturnListingGroupCondition | ReturnReasonCondition | ReturnRefundRangeCondition | ReturnShipmentOriginCountryCondition

"""This input type specifies one return rule condition."""
input ReturnRuleConditionInput {
  """
  This object defines return category conditions.
    
  **Note:** Multiple categories can be included in a single condition.
  """
  categoryCondition: ReturnItemCategoryConditionInput
  """Item location countries condition."""
  itemLocationCountriesCondition: ReturnItemLocationCountryConditionInput
  """
  The listing return rule condition. 
    
  **Note:** Only one listing group can be specified per condition.
  """
  listingGroupCondition: ReturnListingGroupConditionInput
  """Return refund amount range condition."""
  refundRangeCondition: ReturnRefundRangeConditionInput
  """
  This object defines return reason conditions.
    
  **Note:** Multiple reasons can be included in a single condition.
  """
  returnReasonCondition: ReturnReasonConditionInput
  """Return-shipment origin countries condition."""
  returnShipmentOriginCountriesCondition: ReturnShipmentOriginCountryConditionInput
}

"""
This type defines the rule set which can encapsulate multiple conditions. The **operator** decides how the child conditions are evaluated.
"""
type ReturnRuleConditionSet {
  """
  The list of rule conditions that belong to this set. Each element defines a specific criterion that must be evaluated against return data (for example, refund amount, item category, return reason).
    
  When evaluated, the overall truth value of this set depends on both the **operator** and the results of these individual conditions.
  """
  conditions: [ReturnRuleCondition!]!
  """Logical operator to apply to the child conditions."""
  operator: ReturnRuleLogicalOperator!
}

"""
This input type defines the business condition to be evaluated for an automation return rule. Presently, conditions are combined using a logical **AND**, meaning an item must satisfy every conditions you provided to be included.
"""
input ReturnRuleConditionSetInput {
  """
  This enumerated value provides the logical operator to combine the conditions.
  """
  operator: ReturnRuleLogicalOperator!
  """Conditions to be evaluated."""
  ruleConditions: [ReturnRuleConditionInput!]!
}

"""
This interface represents a typed validation error for a specific rule condition.
"""
interface ReturnRuleConditionViolation {
  """A machine-readable code identifying the failed condition."""
  code: String!
  """
  A human-readable explanation of the violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
}

"""
This type indicates the rules with `DISABLED` status are inactive and ignored.
"""
type ReturnRuleDisabledStatus implements SellerReturnRuleStatus {
  """A machine-readable code identifying the return as `DISABLED`."""
  code: String!
  """
  This enumerated value identifies who disabled the rule. The rule can be disabled by the seller through an API mutation, or automatically by the eBay system if invalid conditions are detected during rule evaluation or execution. Rules disabled by the system cannot be re-enabled by the seller until all invalid conditions are corrected.
  """
  disabledBy: ReturnRuleDisabler!
  """
  Human-readable text of the rule status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This enumerated type identifies which party disabled the automation return rule.
"""
enum ReturnRuleDisabler {
  """This value indicates the rule was disabled by the `SELLER`."""
  SELLER
  """This value indicates the rule was disabled by the `SYSTEM`."""
  SYSTEM
}

"""
Occurs when a condition is duplicated in the input rule set.
A condition can appear only once in the input rule set.
"""
type ReturnRuleDuplicateConditionViolation implements ReturnRuleConditionViolation {
  """
  A machine-readable code identifying the failed condition: `RTRN_RULE_DUPLICATE_CONDITION`
  """
  code: String!
  """
  A human-readable explanation of the violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  Duplicate condition which is provided in input conditions.
  A condition can appear only once in the input rule set.
  """
  duplicateCondition: [ReturnRuleCondition!]!
}

"""
This error type is returned when the provided **ruleIdsInPriorityOrder** contains duplicate IDs (the input list requires unique rule IDs).
"""
type ReturnRuleDuplicateRuleIdsError implements BusinessError {
  """A list of one or more duplicate rule IDs in the input list."""
  duplicateRuleIds: [ID!]!
  """A machine-readable error code: `RTRN_DUPLICATE_RULE_IDS_IN_LIST`"""
  errorCode: String!
  """
  A human-readable error message for duplicate rule Ids in the ordered list. This check avoids any bad data written to the system. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
}

"""
This type indicates the rules with ENABLED status are active and evaluated.
"""
type ReturnRuleEnabledStatus implements SellerReturnRuleStatus {
  """A machine-readable code identifying the return as `ENABLED`."""
  code: String!
  """
  A human-readable rule status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This error type indicates that the return rules feature is not enabled for the seller. 

**Note:** The seller is authenticated but does not have the required feature capability enabled ramped for them.
"""
type ReturnRuleFeatureNotEnabledError implements BusinessError {
  """A machine-readable error code: `RTRN_FEATURE_NOT_ENABLED`"""
  errorCode: String!
  """
  A human-readable error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
}

"""
This error type indicates the provided **returnRuleConditionSet** contains invalid condition data (for example, the categories are not leaf IDs, invalid country code, or an invalid **refundRange** where the minimum is less than maximum).
Purpose: surface specific validation failures in the condition tree.
"""
type ReturnRuleInvalidConditionsError implements BusinessError {
  """A machine-readable error code `RTRN_RULE_INVALID_CONDITIONS`"""
  errorCode: String!
  """
  A human-readable error message indicating that the rule conditions are invalid. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  A list of violations providing details about each specific invalid condition found in the input.
  """
  ruleConditionViolation: [ReturnRuleConditionViolation!]!
}

"""
This error type is returned when the input includes one or more rule IDs that do not exist for this seller/marketplace (extra or invalid IDs).
"""
type ReturnRuleInvalidRuleIdsError implements BusinessError {
  """A machine-readable error code: `RTRN_INVALID_RULE_IDS_IN_LIST`"""
  errorCode: String!
  """
  A human-readable error message for invalid rules in the ordered list. For example, rule IDs that do not belong to the seller. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  A list of one or more rule IDs which are not found in the seller's existing rules.
  """
  invalidRuleIds: [ID!]!
}

"""Indicates the constraints defined for return rule item condition"""
type ReturnRuleItemCategoryConditionConstraint {
  """Maximum number of categories allowed in the condition."""
  maxAllowedCategory: Int!
}

"""
Category condition violation details.
Provided category IDs must be leaf categories.
Category IDs must be valid/known eBay categories.
"""
type ReturnRuleItemCategoryConditionViolation implements ReturnRuleConditionViolation {
  """
  A machine-readable code identifying the failed condition: `RTRN_INVALID_ITEM_CATEGORY_CONDITION`
  """
  code: String!
  """Indicates the constraints defined for return rule item condition"""
  constraint: ReturnRuleItemCategoryConditionConstraint!
  """
  A human-readable explanation of the violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """List of duplicate category IDs."""
  duplicateCategoryIds: [ID!]
  """Exceeds max number of categories allowed"""
  exceedsAllowedThreshold: Boolean!
  """List of invalid or unknown category IDs."""
  invalidCategoryIds: [ID!]
}

"""
This violation type occurs when invalid or duplicates countries are provided in the item location countries condition:
- a country can appear only once in the input rule set
- country codes must be valid **CountryAlpha2Code**
"""
type ReturnRuleItemLocationCountryViolation implements ReturnRuleConditionViolation {
  """
  A machine-readable code identifying the failed condition: `RTRN_RULE_ITEM_LOCATION_CONDITION`
  """
  code: String!
  """
  A human-readable explanation of the violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
     A list of one or more duplicate countries in item location input condition.
     
  **Note:** A country can appear only once in the input rule set.
  """
  duplicateCountryCodes: [CountryAlpha2Code!]
  """
  A list of one or more invalid country codes provided in item location countries input condition.
  """
  invalidCountryCodes: [CountryAlpha2Code!]
}

"""
This error type is returned when adding this rule would exceed a configured maximum number of rules (organizational or business limit).
"""
type ReturnRuleLimitExceededError implements BusinessError {
  """A machine-readable error code: `RTRN_RULE_LIMIT_EXCEEDED`"""
  errorCode: String!
  """
  A human-readable error message indicating that the rule limit has been exceeded. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  The maximum number of rules allowed for the seller on the specified marketplace.
  """
  maxAllowed: Int!
}

"""
This type details a group containing listing IDs defined by the seller. Each group can contain up to 5000 listing IDs.
"""
type ReturnRuleListingGroup {
  """
  The unique seller provided name of the group. 
    
  **Note:** No two group can have the same name.
    
  **Format:** Alphanumeric
  **Maximum length:** 100 characters
  """
  groupName: String!
  """
  This array contains listings that are part of this group.
  - each Listing can be part of multiple group.
  - listing IDs must be unique within the group
    
  **Note:** A maximum of 5000 listing can be added to a group.   
  """
  listings: [ListingReference!]!
  """
  Maximum of 500 listings will be returned in a single page.
  This value is calculated by the system.
  """
  pagination: Pagination!
  """
  A unique identifier for the listing group. This value is generated by the system when the group is created.
  """
  returnRuleListingGroupId: ID!
}

"""
The listing group condition violation details. The group ID must exist in seller's **availableListingGroups**.
"""
type ReturnRuleListingGroupConditionViolation implements ReturnRuleConditionViolation {
  """
  A machine-readable code identifying the failed condition: `RTRN_INVALID_LISTING_GROUP_CONDITION`
  """
  code: String!
  """
  A human-readable explanation of the violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """The listing group ID provided in the request."""
  invalidReturnRuleListingGroupId: ID!
}

"""
This error type is returned when the input request contains duplicate listing IDs.

**Note:** Clients should deduplicate their list of IDs before re-sending the request.
"""
type ReturnRuleListingGroupDuplicateListingError implements BusinessError {
  """
  An array of one or more listing IDs that were duplicated in the request.
  """
  duplicateListingIds: [ID!]!
  """A machine-readable error code: `RTRN_DUPLICATE_LISTING_IDS_IN_GROUP`"""
  errorCode: String!
  """
  A human-readable message indicating input request contained duplicated listing IDs.
  """
  errorMessage: String!
}

"""
This input type defines the payload for the **returnRuleListingGroup** query, which returns the **listingIds** of a seller created group for use in return automation rules.

**Note:** The **groupId** is a mandatory field.
"""
input ReturnRuleListingGroupInput {
  """
  Use this object to provide the maximum page size and the cursor parameters for fetching pages of results.
  If **maxPageSize** page size is not provided, or is more than 500, the default value of 500 will be used.
    
  **Default:** 500
  """
  pageInfo: PageInfoInput!
  """The unique identifier of a specific group ID to retrieve."""
  returnRuleListingGroupId: ID!
}

"""
This error type is returned when a group with the given name already exists for this seller. 

**Note:** Only unique group names are accepted.
"""
type ReturnRuleListingGroupInvalidNameError implements BusinessError {
  """Indicates whether the rule name contains invalid characters."""
  containsInvalidCharacters: Boolean!
  """
  Indicates whether the rule name is not unique for the seller in given listing marketplace.
  """
  duplicateGroupName: Boolean!
  """A machine-readable error code `RTRN_LISTING_GROUP_NAME_ERROR`"""
  errorCode: String!
  """
     A human-readable message describing the error.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  This object indicates the constraints defined for return rule name input. Constraints include allowed character counts and regular expression pattern for allowed characters.
  """
  nameConstraint: ReturnRuleNameConstraint!
}

"""
This error type indicates that the request attempts to create or expand the listing list which would exceed the list's total item capacity.

**Note:** To fix, clients should lower the total number of items to be added to the list.
"""
type ReturnRuleListingGroupMaxSizeExceededError implements BusinessError {
  """A machine-readable error code: `RTRN_LISTING_GROUP_MAX_SIZE_EXCEEDED`"""
  errorCode: String!
  """A human-readable message describing the capacity violation."""
  errorMessage: String!
  """The configured maximum number of listings allowed per group."""
  groupListingLimit: Int!
}

"""
This error type is returned when the listing group cannot be found. This error typically occurs if the specified listing group ID (**listingId**) does not exist or has been deleted (returned when the append request references an unknown list).
"""
type ReturnRuleListingGroupNotFoundError implements BusinessError {
  """A machine-readable error code: `RTRN_LISTING_GROUP_NOT_FOUND`"""
  errorCode: String!
  """
  A human-readable error message indicating the list was not found. 
    
  **Maximum length:** 512
  """
  errorMessage: String!
  """The listing group ID from the request that could not be found."""
  returnRuleListingGroupId: ID!
}

"""
This base response union type for the **returnRuleListingGroup** query represents a seller-defined list of listing IDs used in return automation rules, or if an error occurred.
"""
union ReturnRuleListingGroupOutput = ReturnRuleListingGroup | ReturnRuleListingGroupNotFoundError

"""
This error type is returned when a seller has reached the maximum number of listing groups allowed for their account. 

**Note:** Currently, a maximum of 20 listing groups for each seller is allowed.
"""
type ReturnRuleListingGroupQuotaExceededError implements BusinessError {
  """
  A machine-readable error code: `RTRN_SELLER_LISTING_GROUP_QUOTA_EXCEEDED`
  """
  errorCode: String!
  """A human-readable message describing the quota violation."""
  errorMessage: String!
  """
  The configured maximum number of listing groups allowed for the seller.
  """
  maxAllowedLists: Int!
}

"""
This error type indicates the request attempts to add more items than the allowed per-request limit. 

**Note:** To fix, clients should split requests into smaller batches.
"""
type ReturnRuleListingIdsPerRequestLimitExceededError implements BusinessError {
  """
  A machine-readable error code: `RTRN_LISTING_PER_REQUEST_LIMIT_EXCEEDED`
  """
  errorCode: String!
  """A human-readable message describing the limit violation."""
  errorMessage: String!
  """The configured maximum number of items allowed per request."""
  perRequestLimit: Int!
  """The number of items the client attempted to add in this request."""
  requestedCount: Int!
}

"""
This enumerated type specifies how to combine multiple child conditions into a single result.
"""
enum ReturnRuleLogicalOperator {
  """
  Conditions will combined using a logical **AND**. All child conditions must be true.
  """
  AND
}

"""
This error type indicates that no conditions were provided in the rule set.

**Note:** A rule must have at least one condition to be valid.
"""
type ReturnRuleMissingConditionError implements BusinessError {
  """
  A machine-readable code identifying the failed condition: `RTRN_RULE_MISSING_CONDITION`
  """
  errorCode: String!
  """
  Human-readable explanation of the error. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
}

"""
This error type is returned when the input contains one or more rule IDs that do not exist among the seller's defined return rules.
"""
type ReturnRuleMissingRuleIdsError implements BusinessError {
  """A machine-readable error code: `RTRN_MISSING_RULE_IDS_IN_LIST`"""
  errorCode: String!
  """
  A human-readable error message for the missing rules in the ordered list. All rules defined must be added to the priority list. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """Missing rule Ids which are not found in the seller's existing rules."""
  missingRuleIds: [ID!]!
}

"""
This type defines validation constraints for the return rule name input.
"""
type ReturnRuleNameConstraint {
  """The regular expression pattern that defines allowed characters."""
  allowedPattern: String!
  """The minimum and maximum number of characters allowed."""
  characterLimit: InputTextLengthRange!
}

"""
This error type indicates that the provided rule name violates allowed format, length, or characters (for example, exceeds maximum length, has disallowed characters).
"""
type ReturnRuleNameError implements BusinessError {
  """
  When `true`, this value indicates the rule name contains invalid characters.
  """
  containsInvalidCharacters: Boolean!
  """
  When `true`, this value indicates the rule name is not unique for the seller in given listing marketplace.
  """
  duplicateRuleName: Boolean!
  """A machine-readable error code `RTRN_RULE_NAME_ERROR`"""
  errorCode: String!
  """
  A human-readable error message indicating that the rule name format is invalid. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  This object indicates the constraints defined for return rule name input, including allowed character counts and regular expression pattern defining allowed characters.
  """
  nameConstraint: ReturnRuleNameConstraint!
}

"""
This error type is returned to indicate the **ruleIds** in the input does not match any existing rule for the seller.
"""
type ReturnRuleNotFoundError implements BusinessError {
  """A machine-readable error code: `RTRN_RULE_NOT_FOUND`"""
  errorCode: String!
  """
  A human-readable error message that the rule was not found. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """The **ruleId** which was not found."""
  requestedRuleId: ID!
}

"""
This type defines the refund range condition violation details:
- the minimum must be less than or equal to maximum
- negative values will not be accepted
"""
type ReturnRuleRefundRangeConditionViolation implements ReturnRuleConditionViolation {
  """
  A machine-readable code identifying the failed condition: `RTRN_INVALID_REFUND_RANGE_CONDITION`
  """
  code: String!
  """
  A human-readable explanation of the violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """When `true`, maximum < minimum."""
  invalidRange: Boolean
  """When `true`, **minAmount** or **maxAmount** is negative."""
  negativeValuesProvided: Boolean
  """Value of minimum and maximum refund values provided in input."""
  providedRefundRangeCondition: ReturnRefundRangeCondition!
}

"""
Occurs when invalid or duplicates countries are provided in the shipment origin countries condition.
A country can appear only once in the input rule set.
Country codes must be valid CountryAlpha2Code.
"""
type ReturnRuleShipmentOriginCountryViolation implements ReturnRuleConditionViolation {
  """
  A machine-readable code identifying the failed condition: `RTRN_RULE_SHIPMENT_ORIGIN_CONDITION`
  """
  code: String!
  """
  A human-readable explanation of the violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  The duplicate country codes that are in the return-shipment origin country input condition.
    
  **Note:** A country can appear only once in the input rule set.
  """
  duplicateCountryCodes: [CountryAlpha2Code!]
  """
  When `true`, invalid country codes were provided in the shipment origin countries input condition.
  """
  invalidCountryCodes: [CountryAlpha2Code!]
}

"""
This error type is returned when the input specifies a status of `ENABLED`, but the rule cannot be enabled because one or more rule conditions are invalid. This prevents activation of rules that contain invalid configurations. The rule conditions must be corrected before the rule can be enabled.
"""
type ReturnRuleStatusUpdateBlockedError implements BusinessError {
  """A machine-readable error code: `RTRN_RULE_STATUS_UPDATE_BLOCKED`"""
  errorCode: String!
  """
  A human-readable error message for blocked rule status update. This will appear when trying to enable a rule with invalid conditions. This alphanumeric string is not localized and may change without notice.
    
  Maximum length: 512 characters
  """
  errorMessage: String!
  """The **ruleId** which was not found."""
  requestedRuleId: ID!
}

"""
This type is used to provide the return shipment label information when a label has not been automatically selected by eBay.
"""
input ReturnShipmentLabelInput {
  """The unique identifier for the uploaded return shipment label."""
  documentId: String!
  """
  The standardized carrier details (for example, UPS, USPS, FEDEX) for the return shipment. It is not nullable, but the entire object may be omitted if tracking information is unavailable.
  """
  shippingCarrier: ReturnShippingCarrierInput!
  """
  The carrier-assigned tracking ID for the return shipment. This optional field is present only when the shipment uses a tracked shipping carrier.
  """
  trackingNumber: String
}

"""
This error type denotes that the attached label document ID was not found.
"""
type ReturnShipmentLabelNotFoundError implements BusinessError {
  """A machine-readable error code: `RTRN_LABEL_DOCUMENT_NOT_FOUND`"""
  errorCode: String!
  """
  A human-readable error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """The invalid document IDs that were not found."""
  requestedDocumentId: [ID!]!
}

"""
This type restricts conditions to return by country. The list of countries can be provided.
"""
type ReturnShipmentOriginCountryCondition {
  """
  Buyer's country from which the return is initiated (initially shipped).
  """
  returnShipmentOriginCountries: [CountryAlpha2Code!]!
}

"""
The type of an automation return rule template for return from countries which are applicable for the rule.
"""
input ReturnShipmentOriginCountryConditionInput {
  """Country code in ISO format. Example `US` for United States."""
  returnShipmentOriginCountries: [CountryAlpha2Code!]!
}

"""
This type represents an event in the tracking history of a return shipment.
"""
type ReturnShipmentTrackingEvent implements ReturnLogisticEvent {
  """The date and time when the tracking event occurred."""
  occurredAt: DateTime!
  """Return Line Items"""
  returnLineItems: [ReturnLineItem!]!
  """
  A machine-readable status code representing the current state of the return shipment. Possible values include: `IN_TRANSIT`, `OUT_FOR_DELIVERY`, `DELIVERED`, `EXCEPTION`, and similar.
    
  **Maximum length:** 100 characters
  **Format:** Alphanumeric with underscores
  """
  status: ShippingTrackingStatus!
  """The shipment tracking info associated with this tracking event."""
  tracking: ShippingCarrierTracking!
}

"""
This type represents the validation constraints defined for return shipping carrier name input.
"""
type ReturnShippingCarrierConstraint {
  """The minimum and maximum number of characters allowed."""
  characterLimit: InputTextLengthRange!
}

"""
This input type specifies the shipping carrier for return fulfillment, including the eBay-standard carrier code and, when applicable, the name of an unsupported carrier.
"""
input ReturnShippingCarrierInput {
  """
  The eBay-standard carrier code for the shipping carrier which must match one of the supported eBay carrier codes for the marketplace. Use the special value `UNSUPPORTED` if the carrier is not supported or recognized by eBay for the marketplace. For unsupported carriers, provide the carrier name in the **unsupportedCarrierName** field.
    
  **Note:** Use the **Metadata API** <a href="https://developer.ebay.com/api-docs/sell/metadata/resources/shipping:marketplace/methods/getShippingCarriers" target="_blank">getShippingCarriers</a> method to retrieve **shippingCarrier** codes for an eBay marketplace.
  """
  carrierCode: String!
  """
  The carrier name as provided by the user when the carrier is not recognized by eBay Marketplace. This optional field is only applicable when `carrierCode` is set to `UNSUPPORTED`.
  """
  unsupportedCarrierName: String
}

"""
This type represents input violations related to the return shipping carrier name.
"""
type ReturnShippingCarrierNameViolation implements AttachReturnShipmentLabelInputViolation & RecordReturnLabelSentOfflineInputViolation {
  """
  A machine-readable code identifying the specific rule that was violated (for example. RETURN_SHIPPING_CARRIER_VIOLATION).
  """
  code: String!
  """
  Indicates the constraints defined for return shipping carrier name input.
  """
  constraint: ReturnShippingCarrierConstraint!
  """
  Indicates whether the shipping carrier name contains invalid characters.
  """
  containsInvalidCharacters: Boolean!
  """
  A human-readable message describing the rule violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  Indicates whether the shipping carrier name exceeded the allowed length.
  """
  exceededLength: Boolean!
}

"""
This error type indicates that the request contains an empty shipping label list, which is not allowed.
"""
type ReturnShippingLabelRequiredError implements BusinessError {
  """A machine-readable error code: `RTRN_SHIPPING_LABEL_REQUIRED`"""
  errorCode: String!
  """
  A human-readable error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
}

"""
This interface provides the status of the return request in code and a human-readable description.
"""
interface ReturnStatus {
  """
  A machine-readable code providing the return status. The format is alphanumeric with underscores. For example: `REQUESTED`, `OPEN`, `DECLINED`, `CANCELLED`, `CLOSED`
    
  **Maximum length:** 100 characters
  """
  code: String!
  """
  A human-readable description providing the return status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type is used to show the domestic return policy or an international return policy (if the seller ships internationally) that is to be used for the listing.
"""
type ReturnTerms {
  """
  This field is used to specify a return business policy to use for the listing. If this field is used, none of the other fields in this container should be
  used since all return policy settings are configured in the business policy instead. The
  [getReturnPolicies](https://developer.ebay.com/api-docs/sell/account/resources/return_policy/methods/getReturnPolicies) method can be used to retrieve
  all return business policies defined for a seller on an eBay marketplace.
  """
  businessPolicy: BusinessPolicy
  """
  This object shows the seller's domestic return policy for a listing, which includes whether or not the seller accepts returns for the item and the duration of the return period. Note that if the listing only has a domestic return policy set up, but the item is shipped internationally, the settings in this container will also apply to international returns.
  """
  domesticReturnTerms: ReturnTermsDetails
  """
  This object shows the seller's international return policy for a listing, which includes whether or not the seller accepts international returns for the item and the duration of the return period. This object is only applicable if the seller has a separate international return policy set up for the listing.
  """
  internationalReturnTerms: ReturnTermsDetails
  """
  This free-form text field provides more details about a seller's return policy. Currently, this field is only supported on the Germany, Austria, France, Italy, and Spain marketplaces.
  """
  returnInstructions: String
}

"""
This type is used to state the seller's domestic or international return policy for a listing, which includes whether or not the seller accepts returns for the item and the duration of the return period.
"""
type ReturnTermsDetails {
  """
  The enumeration value returned here indicates how a buyer will be refunded if an item is returned. This is a mandatory field if the seller accepts returns for the item.
  """
  listingRefundMethod: ListingRefundMethod
  """
  This boolean field indicates whether or not the seller allows the buyer to return the item. This field is mandatory for return policies and returned as 'true' if the seller accepts returns for the item or 'false' if the seller does not accept returns for the item.
  """
  returnAccepted: Boolean
  """
  The enumeration value returned in this field indicates the amount of time that the buyer has to return an item. The return period begins when the item is marked 'delivered' at the buyer's specified ship-to location. This field is mandatory if the seller accepts returns for the item.
  """
  returnDuration: ListingTimeDuration
  """
  The enumeration value returned here indicates either the buyer or the seller as the party who pays for return shipping charges. This is a mandatory field if the seller accepts returns for the item.
  **Note**: The seller is always responsible for return shipping costs when an item is being returned due to a Significantly not as described (SNAD) issue.
  """
  returnShipmentInvoicee: Invoicee
}

"""
This union type is used by the **ReturnTerms** and **BusinessPolicy** type to display return policy terms for a listing, including return period, refund method, and return shipping cost payer.
"""
union ReturnTermsPolicy = BusinessPolicy | ReturnTerms

"""
This error type indicates the provided **returnRuleConditionSet** contains invalid condition data (for example, the categories are not leaf IDs, invalid country codes, or an invalid **refundRange** where the minimum is less than maximum).
Purpose: surface specific validation failures in the condition tree.
"""
type ReturnToAddressRequiredError implements BusinessError {
  """
  A list of violations providing details about each specific invalid condition found in the input.
  """
  addressRoutingStrategy: ReturnToAddressRoutingStrategy!
  """A machine-readable error code `RTRN_ADDRESS_REQUIRED_ERROR`"""
  errorCode: String!
  """
  A human-readable error message indicating that the rule conditions are invalid. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
}

"""This input type selects the return address routing strategy."""
input ReturnToAddressRouteInput {
  """
  These address IDs can be retrieved from **eligibleReturnAddresses** field in **SellerReturnPreferences.returnResponseRules**.
    
  **Note:** This field is required when address routing strategy is `RETURN_TO_SPECIFIC_ADDRESS`.
  """
  addressId: String
  """The address routing option for returns."""
  returnToAddressRoutingStrategy: ReturnToAddressRoutingStrategyInput!
}

"""
This interface represents the strategy the system uses to automatically select a return address when a ReturnToAddress rule's conditions are satisfied. Each strategy defines a specific method for determining which return address should be chosen for routing the return.
"""
interface ReturnToAddressRoutingStrategy {
  """
  A machine-readable code identifying the return address routing strategy .
    
  **Format:** Alphanumeric with underscores
  **Maximum length:** 50 characters
  """
  code: String!
  """
  A human-readable text of the return address routing strategy. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This enumerated type holds different strategies for selecting return address. Only one strategy is applicable for a given rule.
"""
enum ReturnToAddressRoutingStrategyInput {
  """
  This value indicates to route returns to the seller's address which is closest to buyer.
  """
  RETURN_TO_ADDRESS_CLOSEST_TO_BUYER
  """
  This value indicates to route returns to the seller's address from where item was shipped to buyer.
  """
  RETURN_TO_ORIGINAL_SHIP_FROM_ADDRESS
  """
  This value indicates to route returns to the seller's specific address. Specific address ID needs to be provided. Addresses can be managed in address book.
  """
  RETURN_TO_SPECIFIC_ADDRESS
}

"""
This type specifies the **returnAddressRoute** that determines how the return address is selected for seller-managed returns.
"""
type ReturnToAddressRule implements ReturnAutomationRule {
  """Strategy for selecting the return address route"""
  addressRoutingStrategy: ReturnToAddressRoutingStrategy!
  """
  This defines the set of conditions that must be met for this rule to be applied.
  """
  conditionSet: ReturnRuleConditionSet!
  """
  The unique name for the rule. No two rules can have the same name.
    
  **Format:** Alphanumeric
  **Maximum length:** 100 characters
  """
  name: String!
  """
  The rule's priority determines its evaluation order; lower numbers are evaluated first.
  Each rule must have a unique priority value.
  """
  priority: Int!
  """The unique identifier for the rule."""
  ruleId: ID!
  """
  The status of the rule: `ENABLED` or `DISABLED`
    
  **Note:** Only `ENABLED` rules are applied.
  """
  status: SellerReturnRuleStatus!
}

"""
This error type is returned when the provided **addressId** is not eligible as a return address for the seller. This occurs when the **addressId**:
- is not in the seller's eligible return adresses
- does not exist
- not owned by the seller
"""
type ReturnToAddressValidationError implements BusinessError {
  """
  A machine-readable error code for an incorrect **addressId** in the input: `RTRN_RULE_ADDRESS_INVALID`
  """
  errorCode: String!
  """
  A human-readable error message for an incorrect **addressId** in the input. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  The returned invalid **addressId** submitted in the input. The **addressId** must be from the seller's eligible return addresses. This alphanumeric string is not localized and may change without notice.
    
  **Note:** To avoid this error, fetch eligible return addresses before making the mutation call.
    
  **Maximum length:** 512 characters
  """
  invalidAddressId: String!
}

"""
This type automatically routes returned items to the seller's nearest return address based on the buyer's location.
"""
type ReturnToNearestSellerAddressStrategy implements ReturnToAddressRoutingStrategy {
  """
  A machine-readable code identifying the return address routing strategy: `CLOSEST_RETURN_ADDRESS_TO_BUYER`
    
  **Format:** Alphanumeric with underscores
  **Maximum length:** 50 characters
  """
  code: String!
  """
  A human-readable return fulfillment status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type specifies a routing strategy that directs returns to the address from which the item was originally shipped.
"""
type ReturnToOriginalShipFromAddressStrategy implements ReturnToAddressRoutingStrategy {
  """
  A machine-readable code identifying the return address routing strategy: `RETURN_TO_SHIP_FROM_ADDRESS`
    
  **Format:** Alphanumeric with underscores
  **Maximum length:** 50 characters
  """
  code: String!
  """
  A human-readable label identifying the return fulfillment status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type specifies the routing strategy for returns. When set, returned items are sent to the seller's defined return address.

**Note: **Addresses must be defined in the address book before they can be used.
"""
type ReturnToSpecificAddressStrategy implements ReturnToAddressRoutingStrategy {
  """
  A machine-readable code identifying the return address routing strategy: `USE_SPECIFIC_RETURN_ADDRESS`
    
  **Format:** Alphanumeric with underscores
  **Maximum length:** 150 characters
  """
  code: String!
  """
  A human-readable label identifying the return fulfillment status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
  """
  The specific return address to which returns will be routed. This address was set by the seller when rule was created.
  """
  returnAddress: Address!
}

"""
This type represents the constraints defined for return tracking number input.
"""
type ReturnTrackingNumberConstraint {
  """The minimum and maximum number of characters allowed."""
  characterLimit: InputTextLengthRange!
}

"""
This type represents input violations related to the return tracking number.
"""
type ReturnTrackingNumberViolation implements AttachReturnShipmentLabelInputViolation & RecordReturnLabelSentOfflineInputViolation {
  """
  A machine-readable code identifying the specific rule that was violated (for example. RETURN_TRACKING_VIOLATION).
  """
  code: String!
  """Indicates the constraints defined for return tracking number input."""
  constraint: ReturnTrackingNumberConstraint!
  """Indicates whether the tracking number contains invalid characters."""
  containsInvalidCharacters: Boolean!
  """
  A human-readable message describing the rule violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  Indicates whether the tracking number is already in use for another return.
  """
  duplicateTrackingNumber: Boolean!
  """Indicates whether the tracking number exceeded the allowed length."""
  exceededLength: Boolean!
}

"""
This type provides Return Merchandise Authorization (RMA) details for the return shipment.
"""
type RmaDetail {
  """
  The human-readable RMA number to include with the return (you can include it on the packing slip or label).
    
  **Note:** If the seller has waived the RMA requirement, this field may be omitted or empty.
    
  **Format:** Alphanumeric
  **Maximum length:** 100 characters
  """
  rmaNumber: String
  """
  When `true`, the RMA number is not required for this return; `false` indicates the seller requires the RMA number to be included.
  """
  rmaRequirementWaived: Boolean!
}

"""
This type provides the Return Merchandise Authorization (RMA) preference settings.
"""
type RmaPreference {
  """
  Whether the preference status is enabled (`true`) or disabled (`false`).
  """
  preferenceStatus: ReturnPreferenceStatus!
}

"""
This input type configures the seller's Return Merchandise Authorization (RMA) Preference.
"""
input RmaPreferenceInput {
  """The status of the RMA preference for returns."""
  preferenceStatus: ReturnPreferenceStatus!
}

"""
This enumerated type defines the buying format filters that can be used for an advanced search. A buying format filter is used if the user wants the limit the type of listings that are returned in their search.
"""
enum SavedSearchRequestParamBuyingFormat {
  """
  This enum value indicates that all item types (auctions, fixed price, and classified ads) are included in the saved search results
  **Note:** This value indicates that a buying format filter was not used.
  """
  ALL_ITEMS
  """
  This enum value indicates that only auction listings are included in the saved search results.
  """
  AUCTION_ITEMS_ONLY
  """
  This enum value indicates that only classified ad listings are included in the saved search results.
  """
  CLASSIFIED_ITEMS_ONLY
  """
  This enum value indicates that only fixed price listings (and auction listings with Buy It Now enabled) are included in the saved search results.
  """
  FIXED_PRICE_ITEM
}

"""
This type provides details on the advanced search criteria used for the corresponding saved search. Some fields may be null if they were not specified as search criteria.
"""
type SavedSearchRequestParams {
  """
  This field indicates the buying formats that the user searched against. Buying format is an optional filter in advanced search. If the search didn't use this filter, a value of 'ALL_ITEMS' is returned. If this filter is used, the user can limit returned items according to buying format such as 'AUCTION_ITEMS_ONLY' or 'FIXED_PRICED_ITEM'.
  """
  buyingFormat: SavedSearchRequestParamBuyingFormat
  """
  This enumerated value indicates the "Sort by" value that the user specified in the original search. See the **SavedSearchRequestParamSortOption** type for more information on any value that is returned here.
  """
  itemSort: SavedSearchRequestParamSortOption
  """
  This field is returned if the user's search included a filter that limits items located in a specific country. The two-letter ISO-3166 code is returned here.
  """
  itemsAvailableTo: CountryAlpha2Code
  """
  This value indicates that a proximity (Items near me) filter has been specified for the saved search. This value is the maximum distance (in kilometers/miles) away from the buyer's postal code that an item may be located.
  """
  maxDistance: Int
  """
  This field returns either the postal code for the buyer's primary shipping address, or the postal code specified through the proximity (Items near me) filter of a saved search.
  **Format**: Alphanumeric characters and hyphens
  """
  postalCode: String
  """
  The original search string for the buyer's saved search. This is the string that the user input into the search field.
  **Format**: Alphanumeric characters, spaces, and common punctuation
  """
  queryKeywords: String!
  """
     This array will show any additional advanced search filters used, such as charity listings or free shipping. See the SavedSearchRequestParamSearchFlag type for more information on any returned value.
  **Note:** This array may be returned empty.
  """
  savedSearchFlags: [SavedSearchRequestParamSearchFlag!]
}

"""
This enumerated type defines filters that can be used by an eBay Advanced search. These values indicate that the user has specified that they want to include certain listing, such as charity listings, free-shipping listings, and listings with other features, in their search.
"""
enum SavedSearchRequestParamSearchFlag {
  """
  This enum value indicates that only charity listings are included in the saved search results.
  """
  CHARITY
  """
  This enum value indicates that only listings with free shipping are included in the saved search results.
  """
  FREE_SHIPPING
  """
  This enum value indicates that only listings that offer local pickup for the buyer are included in the search results.
  """
  LOCAL_SEARCH
  """
  This enum value indicates that only lot listings (multiple items sold together) are included in the saved search results.
  """
  LOT
}

"""
This enumerated value defines the sort options specified for a saved search. These values indicate the "Sort by" value that the user specified in their saved search.
"""
enum SavedSearchRequestParamSortOption {
  """
  This enum value indicates that the saved search is sorted by Best Match relevance.
  """
  BEST_MATCH
  """
  This enum value indicates that the saved search is sorted by distance from the buyer's location with the nearest returned first.
  """
  DISTANCE
  """
  This enum value indicates that the saved search is sorted by listing end time.
  """
  END_TIME
  """
  This enum value indicates that the saved search is sorted by item price plus shipping cost in descending order.
  """
  PRICE_PLUS_SHIPPING_HIGHEST
  """
  This enum value indicates that the saved search is sorted by item price plus shipping cost in ascending order.
  """
  PRICE_PLUS_SHIPPING_LOWEST
  """
  This enum value indicates that the saved search is sorted by listing start date.
  """
  START_DATE
}

"""
This enumeration type contains the supported duration values for a Second Chance Offer listing. The duration time to use is at the discretion of the seller.
"""
enum SecondChanceListingDurationInDays {
  """
  This enumeration value indicates that the buyer has one day (24 hours) to purchase the item in the Second Chance Offer listing. The clock starts as soon as the seller makes the offer available to the buyer.
  """
  DAYS_1
  """
  This enumeration value indicates that the buyer has 3 full days to purchase the item in the Second Chance Offer listing. The clock starts as soon as the seller makes the offer available to the buyer.
  """
  DAYS_3
  """
  This enumeration value indicates that the buyer has 5 full days to purchase the item in the Second Chance Offer listing. The clock starts as soon as the seller makes the offer available to the buyer.
  """
  DAYS_5
  """
  This enumeration value indicates that the buyer has 7 full days to purchase the item in the Second Chance Offer listing. The clock starts as soon as the seller makes the offer available to the buyer.
  """
  DAYS_7
}

"""
This type is used to set the price and duration of the Second Chance Offer.
"""
input SecondChanceListingTermsInput {
  """
  This field is only applicable for auctions involving motor vehicles or other high-priced items where the Reserve Price was never met and there was no winning bidder. Otherwise, the Second Chance listing price automatically defaults to the recipient user's highest bid during the ending auction and this field should not be included.
  """
  fixedPrice: Decimal
  """
  This field sets the length of time (in days) that the Second Chance listing will be available to the recipient. The supported values are `DAYS_1`, `DAYS_3`, `DAYS_5`, and `DAYS_7`
  """
  listingDuration: SecondChanceListingDurationInDays!
}

"""
Filter criteria to apply when searching for a seller's active listings. When multiple filters are included, they are combined using a logical `AND` operation.

**Example:** Specify the following filters to return active auction listings in the US or UK marketplace with the specified listing IDs:
```
{
listingIds: ['123', '456']            # Results must match one of these IDs
marketplaces: [EBAY_US, EBAY_GB]      # AND be in one of these marketplaces
formatType: AUCTION                   # AND be auction format
}
```
This filter combination returns listings with (listingId IN [123,456]) **AND** (marketplace IN [EBAY_US,EBAY_GB]) **AND** (formatType=AUCTION).
"""
input SellerActiveListingSearchFilterInput {
  """
  Filter seller listings to return those listing that ended within a specified date/time range. This filter requires both `startAt` and `endAt` values be specified, and returns those seller listings that ended between the specified `startAt` date/time (inclusive) and `endAt` date/time (inclusive).
  - If a `startAt` value or `endAt` value is omitted `BAD_INPUT_VALUE` is returned.
  - If both `startAt` and `endAt` values are omitted, no date-range filtering is applied.
  """
  endAtRange: SellerListingDateTimeRangeInput
  """
  Filter seller listings by their listing format type. Refer to `ListingFormatType` for supported values.
  """
  formatType: ListingFormatType
  """
  Filter seller listings by their listing IDs. When multiple listing ID values are provided, they are combined using a logical `OR` operation.
  
  **Note:** The maximum number of returned listings is 200. If more than 200 listings are identified `BAD_INPUT_VALUE` is returned.
  """
  listingIds: [ID!]
  """
  Filter seller listings by the eBay marketplace(s) in which the listings are created (e.g., EBAY_US, EBAY_GB, EBAY_DE). Refer to `ListingMarketplace` for a complete list of supported enumeration values.
  
  When multiple marketplaces are provided, they are combined using a logical `OR` operation. For example. `marketplaces [EBAY_US, EBAY_GB]` returns listings from the US **OR** UK marketplace.
  """
  marketplaces: [ListingMarketplace!]
  """
  Filter seller listings to return those listings that were modified within a specified date/time range. This filter requires both `startAt` and `endAt` values be specified, and returns those seller listings that have been modified between the specified `startAt` date/time (inclusive) and `endAt` date/time (inclusive).
  - If a `startAt` value or `endAt` value is omitted `BAD_INPUT_VALUE` is returned.
  - If both `startAt` and `endAt` values are omitted, no date-range filtering is applied.
  """
  modifiedAtRange: SellerListingDateTimeRangeInput
  """
  Filter seller listings by their primary category ID. When multiple category ids are provided, they are combined using a logical `OR` operation.
  
  **Note:** The maximum number of returned listings is 50. If more than 50 listings are identified `BAD_INPUT_VALUE` is returned.
  """
  primaryCategoryIds: [ID!]
  """
  Filter seller listings by Stock Keeping Unit (SKU) values. An SKU is a seller-defined identifier that can be assigned when listing an item using **AddItem** and related calls. eBay preserves SKUs for items allowing users to access them before and after order line items are created.
  
  When multiple SKU values are provided, they are combined using a logical `OR` operation. For example, filtering seller listings using `skus ["SKU-1", "SKU-2"]` returns listings that exactly match SKU-1 **OR** SKU-2.
  
  **Notes:**
  - SKU filter values are case-senstive and must match an item's SKU exactly.
  - A single SKU may match multiple listings; SKUs are not required to be unique.
  - This filter returns all listings where the SKU exactly matches any value in the array.
  - The maximum number of returned listings is 200. If more than 200 listings are identified `BAD_INPUT_VALUE` is returned.
  
  **Maximum filter length:** 50 characters. If more than 50 characters are specified `BAD_INPUT_VALUE` is returned.
  """
  skus: [String!]
  """
  Filter seller listings to return those listing that became active within a specified date/time range. This filter requires both `startAt` and `endAt` values be specified, and returns those seller listings that became active between the specified `startAt` date/time (inclusive) and `endAt` date/time (inclusive).
  - If a `startAt` value or `endAt` value is omitted `BAD_INPUT_VALUE` is returned.
  - If both `startAt` and `endAt` values are omitted, no date-range filtering is applied.
  """
  startAtRange: SellerListingDateTimeRangeInput
}

"""
Criteria to apply when searching for a seller's active listings. It is strongly recommended that criteria be specified in order to limit the number of listings returned. If no criteria are specified, the search will require more time and the request may timeout.
"""
input SellerActiveListingSearchInput {
  """The filter(s) to apply when searching for a seller's active listings."""
  filters: SellerActiveListingSearchFilterInput
  """
  Pagination information to control the number of listings returned, the number of pages of data to return, and the starting point.
  - The maximum number of pages of data to be returned is 200.
  - The maximum number of listings that can be retrieved is 50,000.
  
  To retrieve more than 50,000 records, apply additional filters to narrow the search or use date range filters to segment the queries.
  
  **Default Values:**
  - maxPageSize: 5
  - pageIndex: 0 (zero-indexed)
  
  **Constraints:**
  - maxPageSize <= 200
  - (maxPageSize * (pageIndex + 1)) <= 50,000
  
  Exceeding the above limit returns a `BAD_INPUT_VALUE` error in the response.
  """
  pagination: PaginationInput
  """
  Sort field and sort order to be applied to the search results. If not specified, by default the results will be sorted in ascending order by their respective `START_TIME`.
  """
  sort: SellerListingSortField
}

"""
This entity type represents a seller-defined set of shipping preferences that are applied
to a listing independently of a `listingId`. It exists to enable multiple subgraphs to extend
the shared `ShippingOptionDetails` type with additional fields.

The fields `shippingRateTableId`, `combinedShippingRuleId`, and `promotionalShipping`
act as entity keys. They are used to resolve the corresponding seller-defined preferences
exposed by `shippingRateTable`, `combinedShippingRule`, and `promotionalShippingRule`.
"""
type SellerAppliedShippingPreference {
  """
  The actual seller-defined combined shipping rule associated with the  provided **combinedShippingRuleId**. This field returns null if **combinedShippingRuleId** is null or invalid.
  """
  combinedShippingRule: SellerCombinedShippingRule
  """
  The actual seller-defined promotional shipping rule when **promotionalShipping** is 'true'. If **promotionalShipping** is 'false', this field is returned null.
  """
  promotionalShippingRule: SellerPromotionalShippingRule
  """
  The actual seller-defined shipping rate table associated with the provided 'shippingRateTableId'. This field returns null if **shippingRateTableId** is null or invalid.
  """
  shippingRateTable: SellerShippingRateTable
}

"""This type represents the seller-defined combined shipping rule."""
type SellerCombinedShippingRule {
  """
  The monetary amount of the shipping fee charged for each additional item. This field is applicable when the **ruleType** is `FLAT` and the **ruleSubType** is `EachAdditionalAmount`. This field is returned null for all other rule types and subtypes.
  """
  amount: Amount
  """
  The monetary amount of the shipping fee to be reduced for each additional item. This field is applicable when the **ruleType** is `FLAT` and the **ruleSubType** is `EachAdditionalAmountOff`. This field is returned null for all other rule types and subtypes.
  """
  amountReduction: Amount
  """The unique identifier of the combined shipping rule."""
  combinedShippingRuleId: ID!
  """
  The unique identifier of the active successor rule, if any. This field is applicable when the **ruleType** is `CALCULATED`.
  """
  mappedActiveRuleId: ID
  """
  The percentage to reduce the shipping fee for each additional item. This value is expressed as a fractional decimal. This field is applicable when the **ruleType** is `FLAT` and the **ruleSubType** is `EachAdditionalPercentOff`. This field returns null for all other rule types and subtypes.
  **Note**: The value of this field must be between '0.00' and '0.99'. Up to two decimal places are supported.
  """
  percentageReduction: Decimal
  """The seller-provided rule name."""
  ruleName: String
  """
  The further classification of the rule.
  - When **ruleType** is `CALCULATED`, the **subTypes** can be `CombinedItemWeight`, `IndividualItemWeight`, `WeightOff`.
  - When **ruleType** is `FLAT`, the **subTypes** can be `EachAdditionalAmount`, `EachAdditionalAmountOff`, `EachAdditionalPercentOff`.
  """
  ruleSubType: String!
  """
  The high-level classification of the rule. This field indicates whether the rule is `CALCULATED` or `FLAT`.
  - `CALCULATED`: The shipping discount is computed dynamically based on weight or other criteria.
  - `FLAT`: A fixed discount or surcharge applied per additional item.
  """
  ruleType: String!
}

"""This type indicates that seller confirmed the shipment."""
type SellerConfirmedShipment implements PostPurchaseCaseReferralReason {
  """A machine-readable code indicating the type of outcome."""
  code: String!
  """
  The human-readable text of the case referral reason.
  **Max length**: 100 characters
  **Format**: Alphanumeric
  """
  displayText: String!
}

"""
This input type defines the payload for the **sellerContractCancellations** query, which searches for contract cancellations.
