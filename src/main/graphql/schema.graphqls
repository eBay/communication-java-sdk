  """
  CENTIMETER
  """
  This enumeration value indicates that the shipping package dimensions are measured in feet.
  """
  FEET
  """
  This enumeration value indicates that the shipping package dimensions are measured in inches.
  """
  INCH
  """
  This enumeration value indicates that the shipping package dimensions are measured in meters.
  """
  METER
}

