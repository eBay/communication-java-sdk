  """
  cases: [PostPurchaseCase!] @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.resolution.read&eBayUser", "https://api.ebay.com/oauth/api_scope/buy.resolution.read&eBayUser"])
  """The date the return request was resolved and closed."""
  closedAt: DateTime
