"""
This base response union type for the **orderReturn** query includes the result and any errors encountered.
"""
union OrderReturnOutput = OrderReturn | ReturnNotFoundError

"""
This enumerated type defines the sorting order for the returned orders.
"""
enum OrderReturnSortField {
  """Sort by the date the return was requested."""
  REQUESTED_AT
}

"""
This input type is used to define the field and sort direction used to order the returned line item results.
"""
input OrderReturnSortInput {
  """
  Specifies the field by which the order line item results are sorted.
    
  **Default:** Sorts by the date the return was requested
  """
  sortField: OrderReturnSortField = REQUESTED_AT
  """
  Specifies the sort direction of the order lines items returned in the result, either:
  * `ASC` ascending (oldest to newest)
  * `DESC` descending (newest to oldest)
    
  **Default:** `ASC`
  """
  sortOrder: SortOrder = ASC
}

"""Reward information associated with an order."""
type OrderReward {
