  """
  sellerAvailableActions: AvailableReturnActions @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.return.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.return&eBayUser"])
  """
