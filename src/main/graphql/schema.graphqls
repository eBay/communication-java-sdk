"""
This type represents a single refund that was executed on a purchase contract. 
"""
type Refund {
  """The unique identifier of the refund."""
  refundId: ID!
  """
  This container provides a breakdown of the refund for the buyer. This can be requested only if the user context is the buyer on the contract.
  """
  buyerRefundBreakdown: BuyerRefundBreakdown!
  """
  This array specifies how the refund was distributed to the payee. The payee could be the buyer who receives the funds from the refund, or eBay that receives the funds due to withholding for label costs or eBay coupons that funded the original payment.
  **Note:** This field cannot be accessed by a seller.
  """
  distributions: [PayeeRefundDistribution!]!
  """
  This array specifies how the refund was funded by the payer. The payer could be the seller who is funding the amount or an eBay partner funding the amount.
     **Note**: This field cannot be accessed by a buyer.
  """
  fundings: [PayerRefundFunding!]!
  """The current status of the refund."""
  refundStatus: RefundStatus!
  """
  This container provides a breakdown of the refund for the seller. This can only be requested if the user context is the seller on the contract.
  """
  sellerRefundBreakdown: SellerRefundBreakdown!
}

"""
Refund Adjustment type
A refund refers to the process of returning money to a customer for a purchase they made,
typically due to dissatisfaction with the product or service, cancellation of the order,
or a mistake in processing the transaction.
"""
type RefundAdjustment implements OrderAdjustment {
  """User-friendly ID of the adjustment."""
  adjustmentId: ID!
  """Creation date of the adjustment."""
  createdAt: DateTime!
  """Refund event associated to this adjustment."""
  refund: Refund!
  """State of the adjustment."""
  state: OrderAdjustmentState!
  """Last updated date-time of the adjustment."""
  updatedAt: DateTime!
}

