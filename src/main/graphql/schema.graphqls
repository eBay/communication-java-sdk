  """
  This field sets the pictogram code(s) for product safety Pictogram(s) for the listing. If your product contains substances or mixtures,
  please select the values corresponding to the hazard pictograms that are stated on your product's Safety Data Sheet.
  This field is an empty list if there are no pictogram codes.
    
  This should not be null unless an error has occurred. Please see the error section of the response for more details
  """
  pictogramCodes: [ID!]
  """
  This container is used by the seller to provide product safety information for the listing. This field is required if product safety
  information is supplied. This field is empty if there are no statement codes.
    
  This should not be null unless an error has occurred. Please see the error section of the response for more details
  """
  statementCodes: [ID!]
}

"""This interface defines the address structure of a user’s profile."""
interface ProfileAddress {
  """
  The first line of the street address (e.g., house number and street name).
  
  **For example:**
  - '2025 Hamilton Avenue'
  - '221B Baker Street'
  - 'Building 12'
  
  **Notes:**
  - This field is required in most countries that utilize street addresses (e.g., United States, United Kingdom).
  - This field may be null in regions that rely primarily on district/building names rather than street numbers (e.g., Hong Kong).
  - This field may be null for pure P.O. Box formats or institutional addresses where this line is not used separately (e.g., UAE, certain Qatar addresses).
  """
  addressLine1: String
  """
  The second line of the street address, such as apartment number, suite number, building, floor, or additional delivery detail.
  
  **For example:**
  - 'Apt. 5B'
  - 'Suite 1200'
  - 'Room 303, East Wing'
  
  **Notes:**
  - A second line is common and often included in the U.S., Canada, and the U.K. for unit-level delivery information.
  - This field will return a null value when no information is provided or applicable.
  """
  addressLine2: String
  """
  The city, town, or locality name associated with the user's address.
  
  **For example:**
  - 'San Jose'
  - 'London'
  - 'Toronto'
  
  **Notes:**
  - This field may return a null value in those regions that use district/municipality without a conventional "city" field (e.g., Hong Kong, Macau).
  - This field may return a null vlaue for rural/local addresses that rely on townland or parish concepts (e.g., some legacy Irish addresses).
  """
  city: String
  """
  This enumeration value is the two-letter country code representing the user's country.
  
  **For example:**
  - 'US', 'GB', 'CA', 'IE', 'HK'
  """
  countryCode: CountryAlpha2Code
  """
  The postal code, ZIP code, or PIN code associated with the user's address and used for mail routing.
  
  **For example:**
  - '95110' (U.S. ZIP)
  - 'SW1A 1AA' (UK postal code)
  - 'H3Z 2Y7' (Canada postal code)
  
  **Notes:**
  - This field will return a null value in those countries or territories that do not use postal codes (e.g., Hong Kong, many UAE addresses relying on P.O. boxes).
  """
  postalCode: String
  """
  The state, province, region, or administrative area code or name associated with the user's address.
  
  **For example:**
  - 'CA' or 'California' (U.S. state)
  - 'ON' or 'Ontario' (Canadian province)
  - 'NB' or 'New Brunswick'
  
  **Notes:**
  - This field will return a null value in those countries that do not have a state/province concept (e.g., Singapore, Hong Kong).
  - This field will return a null value when the combination of locality and postal code provide sufficient routing and the region does not require this field.
  - May be specified as either a code or full name depending on upstream normalization.
  """
  stateOrProvince: String
}

