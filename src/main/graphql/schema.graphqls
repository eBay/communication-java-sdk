}

"""
This type indicates that the return item has not been received by the seller.
"""
type ReturnNotReceived implements PostPurchaseCaseReferralReason {
  """Machine-readable reason code: 'RETURN_NOT_RECEIVED'."""
  code: String!
  """
  The human-readable text of the case referral reason.
  **Max length**: 100 characters
  **Format**: Alphanumeric
  """
  displayText: String!
}

"""
This type represents a single return offer made in the context of the return.
"""
type ReturnOffer {
