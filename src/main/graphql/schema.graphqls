  A message explaining the content moderation block error.
  **Maximum length**: 100 characters
  """
  blockMessage: String
  """
  A compact message explaining the content moderation block error.
  **Maximum length**: 50 characters
  """
  blockShortMessage: String
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

