  """The destination account of the payee which will receive the payment."""
  destinationAccount: FundAccount!
  """
  This timestamp indicates the deadline by which the payment must be completed.
    
  **Note**: May be null if no strict deadline is set.
  """
  paymentDeadline: DateTime
  """
  This array shows payment methods intended to fund this plan.
    
  **Note**: May be null if the information is unavailable.
  """
  paymentMethods: [PurchasePaymentMethod!]
  """
  This timestamp indicates the specific date and time when the payment is scheduled to occur.
    
  **Note**: May be null if the payment is not tied to a fixed schedule.
  """
  scheduledFor: DateTime
  """
  The total amount to be transferred from the source account to the destination account under this plan.
  """
  total: AmountSet!
}

"""
This interface provides the details on how the refund is distributed to the payees. 
"""
interface PayeeRefundDistribution {
  """
  This array returns a list of distribution execution associated with the refund.
  """
  distributionExecutions: [RefundDistributionExecution!]
  """This container provides the distribution state of a refund."""
  distributionState: RefundDistributionState!
}

"""
This type is used to indicate that the payer’s payment was manually marked as paid by the seller.
"""
type PayerMarkedPaid {
  """This timestamp indicates when when the payment was marked as paid."""
  markedAt: DateTime
}

"""
This type shows detailed monetary information related to the execution of a payment by the payer.
"""
type PayerMonetaryExecution {
  """The total amount successfully paid by the payer."""
  paidAmount: Amount
  """
  This container indicates whether the payer's payment has been completed or is pending.
  """
  paidState: MonetaryExecutionPaymentState
  """The current balance associated with the payer."""
  payerBalance: Amount
  """This array shows the list of payment actions carried out by the payer."""
  payerExecutions: [MonetaryExecution!]
}

"""
This union type provides information about payer’s monetary execution record. This includes both standard monetary executions and manually marked-as-paid items.
"""
union PayerMonetaryExecutionUnion = PayerMarkedPaid | PayerMonetaryExecution

"""
This type is used to provide details on executed payments within the corresponding payment plans, in relation to the payer.
"""
type PayerPaymentExecution implements PaymentExecution {
  """
  This timestamp indicates the date and time when the payment execution was attempted. It is returned regardless of success or failure, but can be null if the payment execution has not started.
  """
  attemptedAt: DateTime
  """
  This timestamp indicates the date and time when the payment execution was completed. It is returned regardless of success or failure, but can be null if the payment execution has not completed.
  """
  completedAt: DateTime
  """The payment method that is used to fund the payment. """
  paymentMethod: PurchasePaymentMethod!
  """The source account of the payer which will fund the payment."""
  sourceAccount: FundAccount!
  """This container shows the current state of payment execution."""
  state: PaymentsState!
  """
  The total amount transferred from the source account to the destination account.
  """
  total: AmountSet!
}

"""
This type is used to provide details about a scheduled payment plan from the perspective of the payer.
"""
type PayerPaymentPlan implements PaymentPlan {
  """
  This timestamp indicates the deadline by which the payment must be completed.
    
  **Note**: May be null if no strict deadline is set.
  """
  paymentDeadline: DateTime
  """
  This array lists one or more payment methods intended to fund this plan.
    
  **Note**: May be null if the information is unavailable.
  """
  paymentMethods: [PurchasePaymentMethod!]
  """
  This timestamp indicates the specific date and time when the payment is scheduled to occur.
    
  **Note**: May be null if the payment is not tied to a fixed schedule.
  """
  scheduledFor: DateTime
  """The source account of the payer which will fund the payment."""
  sourceAccount: FundAccount!
  """
  The total amount to be transferred from the source account to the destination account under this plan.
  """
  total: AmountSet!
}

"""
This interface provides details on how the refund is being funded by a payer.
"""
interface PayerRefundFunding {
  """
  This array returns a list of funding execution details associated with the refund.
  """
  fundingExecutions: [RefundFundingExecution!]
  """This container provides the funding state of the refund."""
  fundingState: RefundFundingState!
}

"""
Payment Adjustment type
A payment adjustment refers to the process of modifying or correcting the amount paid for an order,
typically due to issues such as pricing errors, additional charges, discounts, partial refunds,
or changes in the order after the initial payment has been made.
"""
type PaymentAdjustment implements OrderAdjustment {
  """User-friendly ID of the adjustment."""
  adjustmentId: ID!
  """Creation date of the adjustment."""
  createdAt: DateTime!
  """
  Reference ID from the external system initiating the payment adjustment.
  """
  externalReference: DomainIdentifier!
  """
  Monetary details, if applicable, such as any replacement fees or adjustments.
  """
  monetaryDetails: MonetaryDetails
  """A list of one or more affected by the payment adjustment."""
  orderLineItems: [OrderLineItem!]!
  """State of the adjustment."""
  state: OrderAdjustmentState!
  """Last updated date-time of the adjustment."""
  updatedAt: DateTime!
}

"""
This interface is used to provide details on executed payment(s) involved in the corresponding payment plan(s).
"""
interface PaymentExecution {
  """
  This timestamp indicates the date and time when the payment execution was attempted. It is returned regardless of success or failure, but can be null if the payment execution has not started.
  """
  attemptedAt: DateTime
  """
  This timestamp indicates the date and time when the payment execution was completed. It is returned regardless of success or failure, but can be null if the payment execution has not completed.
  """
  completedAt: DateTime
  """The payment method that is used to fund the payment. """
  paymentMethod: PurchasePaymentMethod!
  """This container shows the current state of payment execution."""
  state: PaymentsState!
  """
  The total amount transferred from the source account to the destination account.
  """
  total: AmountSet!
}

"""
This union type provides details on any active or released payment holds.
"""
union PaymentHoldState = PaymentOnHold | PaymentReleased

"""This enumerated type defines supported payment methods."""
enum PaymentMethods {
  """ This enumeration value indicates that the payment method will be cash, and the transaction will occur in-person. 
  """
  CASH_IN_PERSON
  """
  This enumeration value indicates that the payment method will be cash,
  and the transaction will occur when the buyer picks up the item.
  """
  CASH_ON_PICKUP
  """ This enumeration value indicates that the payment can be processed via money order. 
  """
  MONEY_ORDER
  """ This enumeration value indicates that a personal check is accepted for payment. 
  """
  PERSONAL_CHECK
}

"""This interface is used to identify a payment method used for payment."""
interface PaymentMethodType {
  """The unique identifier of a payment method. """
  code: ID!
  """The descriptive name of a payment method."""
  descriptiveName: String!
  """
  The display name of a payment method (for example, `PAYPAL`, `EBAY_PAYMENTS`, or similar methods).
  """
  displayName: String!
}

"""This type provides details on any active payment hold."""
type PaymentOnHold implements Labeled {
  """
  This timestamp indicates the date and time when the hold is expected to be released. This may be null when the data is not yet available.
  """
  expectedReleaseAt: DateTime
  """This timestamp indicates the date and time when the hold was placed."""
  holdPlacedAt: DateTime!
  """
  The human-readable label for the active payment hold.
  **Maximum length**: 100 characters
  """
  label: String!
  """
  The reason for the payment hold. This field may be null if the reason is not available.
  """
  reason: DisplayableId
}

"""
This interface is used to provide details about a scheduled payment plan.
"""
interface PaymentPlan {
  """
  This timestamp indicates the deadline by which the payment must be completed.
    
  **Note**: May be null if no strict deadline is set.
  """
  paymentDeadline: DateTime
  """
  This array shows payment methods intended to fund this plan.
    
  **Note**: May be null if the information is unavailable.
  """
  paymentMethods: [PurchasePaymentMethod!]
  """
  This timestamp indicates the specific date and time when the payment is scheduled to occur.
    
  **Note**: May be null if the payment is not tied to a fixed schedule.
  """
  scheduledFor: DateTime
  """
  The total amount to be transferred from the source account to the destination account under this plan.
  """
  total: AmountSet!
}

"""
This type defines the seller's payment configuration for a payment policy including accepted payment methods, immediate payment requirements, and motors specific settings (for example, a deposit requirement).
"""
type PaymentPolicyDetails {
  """
  This array lists the seller's payment methods that are accepted for the payment business policy. 
  
  **Note:** Sellers are not required to specify any electronic payment methods for listings. This array may often be returned empty unless the payment business policy is intended for motor vehicle listings or other items in categories where offline payments are required or supported. 
  
  **Occurrence:** Always
  """
  acceptedPaymentMethods: [PaymentMethods]
  """
  This container provides motor vehicle listing deposit requirements. Applicable if the **categoryTypes.name** field is set to `MOTORS_VEHICLES` and returned only if the seller requires an initial deposit. The container shows the amount due for the deposit and when it is due (typically within 1-3 days after commitment to purchase, unless the listing requires immediate payment). May be null when no deposit is required. 
  
  **Occurrence:** Conditional
  """
  depositDetails: BusinessPolicyMotorVehicleDepositDetails
  """
  When `true`, this field indicates immediate payment is required from the buyer. This can occur in the following scenarios:
  - Fixed-price item
  - An auction where the buyer uses **Buy It Now**
  - A deposit for a motor vehicle
  
  **Note:** Immediate payment does not apply to auction listings with a winning bid, purchases involving Best Offer, or transactions completed offline.
  
  **Occurrence:** Always
  """
  immediatePaymentRequired: Boolean
  """
  This field indicates whether this payment policy applied to motor vehicles.
  - `true`: This is a motor vehicle payment policy 
  - `false`: This is a standard (non-motor vehicle) payment policy
  """
  motorVehiclePolicy: Boolean
  """
  Although this field may be returned for some older payment business policies, payment instructions are no longer supported by payment business policies. If this field is returned, it can be ignored as these payment instructions will not appear in any listings that use the corresponding business policy. May be null when no instructions were provided. 
  
  **Maximum length:** 1000 characters
  **Occurrence:** Conditional
  """
  paymentInstructions: String
}

"""
This type represents the state of a payment hold that has been released through a human-readable label.
"""
type PaymentReleased implements Labeled {
  """
  The human-readable label for the released payment hold.
  **Maximum length**: 100 characters
  """
  label: String!
  """
  The reason for the payment hold. This field may be null if the reason is not available.
  """
  reason: DisplayableId
  """This timestamp indicates the date and time when the hold was released."""
  releasedAt: DateTime
}

"""
This type indicates that the payment process has been completed successfully through a human-readable label.
"""
type PaymentsCompleted implements Labeled {
  """The human-readable label representing this state."""
  label: String!
}

"""
This type indicates that the payment process has failed through a human-readable label.
"""
type PaymentsFailure implements Labeled {
  """The human-readable label representing this state."""
  label: String!
}

"""
This type indicates that the payment process is currently in progress through a human-readable label.
"""
type PaymentsInProgress implements Labeled {
  """The human-readable label representing this state."""
  label: String!
}

"""
This type indicates that the payment process has not yet started through a human-readable label.
"""
type PaymentsNotStarted implements Labeled {
  """The human-readable label representing this state."""
  label: String!
}

"""
This union type is used to show the current state of payments within a monetary plan. 
"""
union PaymentsState = PaymentsCompleted | PaymentsFailure | PaymentsInProgress | PaymentsNotStarted

"""
This enumerated type defines the payment state values applicable for a refund.
"""
enum PaymentState {
  """This enum value indicates that the payment has cancelled."""
  CANCELLED
  """This enum value indicates that the payment has been completed."""
  COMPLETED
  """This enum value indicates that the payment has failed."""
  FAILURE
  """This enum value indicates that the payment is currently in progress."""
  IN_PROGRESS
  """
  This enum value indicates that the payment process has not been started.
  """
  NOT_STARTED
}

"""
Specifies the payment terms defined by seller like payment method, payment instructions, etc
"""
type PaymentTerms {
  """Business policy container for specifying policy ID ."""
  businessPolicy: BusinessPolicy
  """
  This field is set to 'true' if the seller requires immediate payment for fixed price listings and auction listings where the 'Buy it Now' option is used.
  **Default**: false
  """
  immediatePay: Boolean
  """
  This array is used to specify one or more payment methods for listings that support offline transactions.
  Use the [getCategoryPolicies](https://developer.ebay.com/api-docs/sell/metadata/resources/marketplace/methods/getCategoryPolicies) method to see the
  payment methods supported for a leaf category.
    
  Currently the only payment methods supported are for offline payments
    
  This array will be null if there are no payment methods
  """
  listingPaymentMethods: [ListingPaymentMethod!]
  """
  This field is used when the seller requires a deposit to secure the purchase of a motor vehicle. The settings under this container include the amount of
  the deposit, when the deposit is due, and when the full payment of the motor vehicle is due.
  """
  motorVehicleDeposit: MotorVehicleDeposit
  """
  Payment instructions (or message) from the seller to the buyer. These instructions appear on eBay's View Item page and on eBay's checkout page when the buyer pays for the item.
  """
  paymentInstructions: String
}

"""
This union type is used by the **PaymentTerms** and **BusinessPolicy** type to display payment terms for a listing, including immediate payment requirement, accepted offline payment methods, and motor vehicle deposit details.
"""
union PaymentTermsPolicy = BusinessPolicy | PaymentTerms

"""This type is used to identify PayPal as the payment method."""
type PayPal implements PaymentMethodType {
  """The unique identifier of the PayPal payment method."""
  code: ID!
  """The descriptive name of the PayPal payment method."""
  descriptiveName: String!
  """The display name of the PayPal payment method."""
  displayName: String!
}

"""
This type defines the business rule error that occurs when there is an active pending offer for the item/buyer.
"""
type PendingOffer implements OfferBusinessRuleViolation {
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

"""
A percentage value that must be between 0 and 100 inclusive.
Represents a whole number percentage.
"""
scalar Percentage

"""This container stores telephone number information."""
type Phone {
  """
  This enumeration value is the two-letter country code representing the country where the telephone number is registered.
  """
  countryCode: CountryAlpha2Code
  """
  The numeric international calling code associated with the country where the telephone number is registered.
  """
  dialCode: String
  """
  The telephone number. Only area code, prefix, and local exchange are stored. Neither the international prefix (i.e., `dialCode`,) nor the country code (i.e., `countryCode`,) are stored. Hyphens and brackets may be included.
      
  **For example:**
  - '4155552671'
  - '02079460000'
  - '07911234567'
  """
  phoneNumber: String
  """Stores the type of telephone number (e.g., mobile, landline, etc.)."""
  phoneNumberType: String
}

"""
This type provides details about a pickup step in progress, and includes the pickup step state and the list of line items associated with this pickup step.
"""
type PickupExecution {
  """
  This array lists the line items that have been picked up or are scheduled for pickup.
  """
  lineItemReferences: [LineItemReference!]
  """
  This timestamp shows the actual time that the pickup step was completed. This field is returned if applicable and available.
  """
  pickedUpAt: DateTime
  """
  This container shows the current state of fulfillment that this pickup step is contributing towards (e.g. PENDING, COMPLETED).
  """
  pickupState: LogisticsFulfillmentState
}

"""This type shows details of a pickup logistics option."""
type PickupLogisticsOption implements PurchaseQuoteLogisticsOption {
  """
  This container shows the cost of the pickup logistics option. If the pickup logistics option is free to the buyer, this container will show a value of '0.0'.  
  **Note**: If the authenticated user uses a different currency than the default currency used by the eBay marketplace, this amount will also be shown in that user's currency.
  """
  cost: AmountSet!
  """The display name of the pickup logistics option."""
  displayName: String!
}

"""
This type is used to add or modify one pickup logistics option that is provided by the seller.
"""
input PickupLogisticsOptionInput {
  """
  This container is used to specify the cost (if any) to pick up the order if the pickup option specified in the corresponding **displayName** field is used. If the pickup option is free to the buyer, this container must still be inclued with the value set to '0.0'.  
  **Note**: The default currency of the eBay listing marketplace should be used.
  """
  cost: AmountInput!
  """
  The display name of the logistics option.
  **Format**: Alphanumeric characters and may include spaces.
  **Minimum length**: 1 character
  **Maximum length**: 100 characters
  """
  displayName: String!
}

"""
This type provides details about a planned pickup step prior to execution.
"""
type PickupPlan {
  """
  This timestamp shows the latest acceptable time by which the pickup should be completed. This field is returned if applicable and available.
  """
  pickupBy: DateTime
  """
  This timestamp shows the scheduled time when the pickup is expected to occur. This field is returned if applicable and available.
  """
  scheduledAt: DateTime
}

"""
This union type provides the **PickupPlan** object to provide details about a planned pickup step and by the **PickupExecution** object to provide details about a pickup step in progress.
"""
union PickupPlanOrExecution = PickupExecution | PickupPlan

"""
This type is used to convey information about a pickup logistics point involved in a fulfillment plan. 
"""
type PickupPoint implements LogisticsPoint {
  """The physical address associated with this pickup logistics point."""
  address: PurchaseAddress
  """
  The user-friendly name of the pickup logistics point (for example, 'San Jose Warehouse').
  """
  name: String!
  """
  The seller-defined unique identifier for the pickup location, if applicable.
    
  **Note**: Only applicable for 'Buy online, pick up in store' (BOPIS) or 'Click and Collect' orders.
  """
  pickupLocationId: ID
  """
  The eBay-generated unique identifier of a store that is used for pickup of items in a 'Buy online, pick up in store' (BOPIS) or 'Click and Collect' order.
    
  **Note**: Only applicable for 'Buy online, pick up in store' (BOPIS) or 'Click and Collect' orders.
  """
  storeId: ID
  """
  The functional role of the shipping point in the logistics flow (for example, 'PICKUP').
  """
  type: DisplayableId!
}

"""
This type convey details of a pickup logistics step involved in a fulfillment plan. 
"""
type PickupStep implements LogisticsStep {
  """
  This container shows the user-friendly description and unique identifier of the party responsible for handling this pickup logistics step.
  """
  handler: DisplayableId
  """
  This container shows the user-friendly description and unique identifier of the pickup logistics step.
  """
  methodName: DisplayableId!
  """
  The unique identifier of a store location that has the item. This ID may or may not be applicable or returned.
    
  **Note**: This identifier is generally applicable to 'Buy online, pick up in store' (BOPIS) or 'Click and Collect' orders.
  """
  pickupCode: ID
  """
  This container shows details on the pickup location, including the user-friendly name, location type, and a full street address. 
  """
  pickupLocation: LogisticsPoint!
  """
  The information shown in this container is dependent on the state of the logistics step. If the logistics step has not yet started and there is no hold associated with the logistics step, it may get returned as empty or null. If the logistics step is active or completed, the state and full  details for this pickup step will be shown. 
  """
  planOrExecution: PickupPlanOrExecution!
}

"""
This type indicates that the buyer was unable to arrange pickup for the order. Applicable only for local pickup orders.
"""
type PickupUnavailableCancellation implements ContractCancellationReason {
  """
  The unique cancellation reason code for this use case. For this type, the value is `PICKUP_UNAVAILABLE`.
  """
  code: String!
  """
  A human-readable description of the cancellation reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This union type represents different types of business policy details for return, shipping, and payment policies.
"""
union PolicyDetails = PaymentPolicyDetails | ReturnPolicyDetails | ShippingPolicyDetails

"""
This input type is used to configure postal code display preferences. This input allows clients to specify how postal codes should be displayed, with support for data masking based on user privileges and access levels.
**Default**: `DISPLAY`
**Note:** Postal code visibility may be restricted based on the requesting user's data access level and relationship to the data owner.
"""
input PostalCodeInput {
  """
  This field specifies how postal codes are displayed.
  
  Supported Values are:
  - `"DISPLAY"`: Display the postal code when a user has appropriate access level.
  
  **Default value:** `"DISPLAY"`
  **Maximum length:** 50 characters
  **Format:** Alphabetic
  
  **Data Privacy Notes:**
  - Postal codes may be masked or omitted if the requesting user lacks sufficient privileges to view this sensitive location data.
  """
  type: String = "DISPLAY"
}

"""
This enumerated type identifies which party performs the post-purchase action.
"""
enum PostPurchaseActorRole {
  """
  This enum value indicates that the actor is the buyer who made the purchase.
  """
  BUYER
  """
  This enum value indicates that the actor is eBay Customer Support, an eBay Partner involved in post-purchase flows, or an automated process which is triggering the post-purchase flow action.
  """
  EBAY
  """
  This enum value indicates that the actor is the seller who sold the item.
  """
  SELLER
}

"""
This type represents a review case associated with a post-purchase flow, such as an order inquiry or a return. This type captures the review status, referral reason, involved parties, decision history, and current outcome.
"""
type PostPurchaseCase {
  """The unique identifier of the post-purchase case."""
  caseId: ID!
  """
  This array returns the history of past decisions made in this case, scoped to the entity under review.
  **Note:** This list can be empty if no prior decisions exist.
  """
  decisionHistory: [PostPurchaseCaseDecision!]!
  """
  The actor who initiated the review request (e.g., 'BUYER', 'SELLER', 'SYSTEM').
  """
  initiator: PostPurchaseActorRole!
  """
  The most recent decision made as part of the review.
  **Note**: This field is optional. If null, the case is still under review or no decision has been made yet.
  """
  latestDecision: PostPurchaseCaseDecision
  """
  The reason the case was referred for review, provided during escalation or referral.
  """
  reason: PostPurchaseCaseReferralReason!
  """The current status of the review (e.g., 'OPEN', 'ON_HOLD', 'CLOSED')."""
  status: PostPurchaseCaseStatus!
}

"""
This type indicates that the review case has been closed. This may happen after a final decision has been made (e.g., refund granted or denied), or the case may be automatically closed due to resolution or expiration of the review window. This type applies to both order inquiries and return cases.
"""
type PostPurchaseCaseClosed implements PostPurchaseCaseStatus {
  """The machine-readable code for the status. In this case, 'CLOSED'."""
  code: String!
  """
  The human-readable text of the case status.
  **Max length**: 100 characters
  **Format**: Alphanumeric
  """
  displayText: String!
}

"""
This type represents a party-scoped decision made as part of a post-purchase case review. Each decision applies to either the buyer or the seller and may reference a previous decision or include appeal history. This type applies to both order inquiries and returns, and captures metadata about who made the decision, when it was made, which party it favored, and any associated outcomes or review requests.
"""
type PostPurchaseCaseDecision {
  """The timestamp when the decision was made."""
  decidedAt: DateTime!
  """The unique identifier of the decision."""
  decisionId: ID!
  """
  The party the decision was made in favor of (e.g., 'BUYER', 'SELLER', 'NONE').
  """
  inFavorOf: PostPurchaseCaseDecisionFavor!
  """
  An optional note or reasoning provided at the time of decision.
  **Note**: If null, no note was added.
  **Maximum length**: 512 characters
  **Format**: Alphanumeric
  """
  note: String
  """
  This array returns a list of one or more outcomes associated with the decision (e.g., refund granted, credit issued). This field is required and must contain at least one outcome.
  """
  outcomes: [PostPurchaseCaseDecisionOutcome!]!
  """
  An optional review request (appeal) submitted against this decision.
  **Note:** If returned null, no appeal has been submitted for this decision.
  """
  reviewRequest: PostPurchaseCaseDecisionReview
}

"""
This enumerated type indicates who a case or appeal decision decision was in favor of.
"""
enum PostPurchaseCaseDecisionFavor {
  """
  This enum value indicates that the decision favored both parties (e.g., partial resolution).
  """
  BOTH
  """This enum value indicates that the decision favored the buyer."""
  BUYER
  """
  This enum value indicates that the decision favored neither party (e.g., insufficient evidence, courtesy closure).
  """
  NONE
  """This enum value indicates that the decision favored the seller."""
  SELLER
}

"""
This interface represents the outcome of a decision made on an order inquiry. Each implementing type describes a specific kind of resolution, such as issuing a refund, crediting the seller, or upholding a previous decision.
"""
interface PostPurchaseCaseDecisionOutcome {
  """A machine-readable code indicating the type of outcome."""
  code: String!
  """
  The human-readable text of the case decision outcome.
  **Max Length 100 characters 
  **Format**: Alphanumeric
  """
  displayText: String!
}

"""
This type represents a review request (appeal) submitted against a decision made on a post-purchase case. This type applies to both order inquiries and return cases, and captures who submitted the request, when it was submitted, the referral reason, status, and any accompanying justification.
"""
type PostPurchaseCaseDecisionReview {
  """The referral reason associated with the review request."""
  reason: PostPurchaseCaseReferralReason!
  """The timestamp when the review request was submitted."""
  requestedAt: DateTime!
  """The party who submitted the review request (e.g., 'BUYER', 'SELLER')."""
  requester: PostPurchaseActorRole!
  """
  An optional note or explanation provided by the requester as part of the review.
  **Maximum length*: 512 characters
  *Format*: Alphanumeric
  **Note:** If returned null, no additional note was supplied.
  """
  requesterNote: String
}

"""
This type indicates that the review case is currently on hold. This typically occurs when the case is waiting for an action from a participant, such as the buyer uploading evidence or the seller providing a response. This type applies to both order inquiries and return cases.
"""
type PostPurchaseCaseOnHold implements PostPurchaseCaseStatus {
  """The machine-readable code for the status. In this case, 'ON_HOLD'."""
  code: String!
  """
  The human-readable text of the case status.
  **Max length**: 100 characters
  **Format**: Alphanumeric
  """
  displayText: String!
}

"""
This type indicates that the review case is open and actively under evaluation. This status means the case has been referred or escalated, and is within the review window, but a final decision has not yet been made. This type applies to both order inquiries and return cases.
"""
type PostPurchaseCaseOpen implements PostPurchaseCaseStatus {
  """The machine-readable code for the status. In this case, 'OPEN'."""
  code: String!
  """
  The human-readable text of the case status.
  **Max length**: 100 characters
  **Format**: Alphanumeric
  """
  displayText: String!
}

"""
This type represents a reason associated with a decision, review, or appeal in a case flow.
"""
interface PostPurchaseCaseReferralReason {
  """
  A machine-readable reason code. For example: 'CONFIRMED_DELIVERY'.
