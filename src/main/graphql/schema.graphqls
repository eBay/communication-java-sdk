"""
This type defines the business rule error that occurs when an account is on hold by a resolution, and offers are not allowed.
"""
type OfferNotAllowedOnUserAccountHoldByResolution implements OfferBusinessRuleViolation {
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
