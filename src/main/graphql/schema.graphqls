"""
This enumerated type defines how the return label was provided to the buyer.
"""
enum OfflineReturnLabelChannelInput {
  """
  This value indicates the label was provided to the buyer through an offline channel (for example, email or printed separately).
  """
  COMMUNICATED_TO_BUYER
  """
  This value indicates the return label was included in the box with the item.
  """
  RETURN_LABEL_IN_THE_BOX
}

"""
This enumeration type contains the values that sets the operation mode for a mutation, indicating whether the intent is to create/update a live listing or only to validate the input data.
"""
enum OperationMode {
  """
  This mode is used when the user wants to create or update a live listing with the provided data. This is the default value if **operationMode** is omitted.
  """
  EXECUTE
  """
  This mode is used when the user only wants to validate the input data and check for errors, without creating or updating a live listing.
  """
  VALIDATE
}

"""
This type defines the unique identifier of an order, which is an confirmed request by a customer to purchase one or more products or services through an e-commerce platform. It contains all relevant details required to process, fulfill, and track the transaction, including customer information, items purchased, payment details, shipping data, and state updates.
"""
type Order {
  """The unique identifier of the order."""
  orderId: ID
  """
  The customer who placed the order. This field references the user associated with the purchase.
  """
  buyer: User!
  """Information related to the cancellation of the order, if applicable."""
  cancellations: [CancellationAdjustment!]
  """The site or platform where the checkout for the order was completed."""
  checkoutMarketplace: Marketplace!
  """
  The timestamp when the customer completed the checkout process which confirms the order. At this point, payment is typically processed, and if successful, the order transitions from a draft or cart state to a finalized purchase ready for fulfillment.
    
  **Note:** This field could be null for an order which was created but yet confirmed and is still being processed.
  """
  confirmedAt: DateTime
  """
  Logistics information associated with the order, describing how the purchased items
  will be fulfilled, delivered, or made available to the buyer.
  """
  logistics: PurchaseLogistics!
  """
  Monetary record associated with the order.
  Each entry represents a distinct payment-related detail within the order lifecycle.
  """
  monetaryDetails: MonetaryDetails!
  """This field contains all the addon services related to the order."""
  orderAddOnService: OrderAddOnService!
  """
  A non-empty list of line items included in the order. Each line item represents an item and inlcudes details like quantity, pricing, and any other relevant information.
    
  **Note:** An order can contain multiple types of items.
  """
  orderLineItems: [OrderLineItem!]!
  """
  The current state of the order providing specific details related to that state. Separate calls can make a model of the lifecycles of an order by providing the sequence of steps.
  """
  orderState: OrderState!
  """All tags associated with the order."""
  orderTags: PurchaseTags
  """
  Details of any post-purchase payment adjustments made to the order,
  such as additional charges applied to the buyer (e.g., for added shipping or corrected fees).
  This field is populated only when such adjustments occur.
  """
  paymentAdjustments: [PaymentAdjustment!]
  """
  The timestamp when the order was initially created which marks the start of the order lifecycle.
    
  **Note:** This is a non-null field, always.
  """
  placedAt: DateTime!
  """
  Information related to any refund associated with the order, if applicable.
  """
  refunds: [RefundAdjustment!]
  """
  Information related to any return associated with the order, if applicable.
  """
  returns: [ReturnAdjustment!]
  """Comprehensive tax-related information for the order,"""
  taxes: OrderTaxes!
  """
  The full set of calculated monetary totals associated with the order,
  covering all relevant amounts in supported currencies.
  """
  totals: OrderTotals!
  """
  The timestamp when the order was last updated. This timestamp captures changes made to order details, state, or related information.
    
  **Note:** This is a non-null field, always.
  """
  updatedAt: DateTime!
}

"""A state representing when the order was abandoned before completion."""
type OrderAbandoned implements Labeled {
  """The date and time when the order was abandoned."""
  abandonedAt: DateTime!
  """A human-readable description of the order's state."""
  label: String!
  """The reason the order was abandoned, if available."""
  reason: String
}

"""
This type indicates additional optional features or services are associated with the order.
"""
type OrderAddOnService {
  """This field provides information about the eBayPlus addon service."""
  eBayPlus: EbayPlusAddOnService
  """
  This field provides information about exports if this order has international shipping addon service.
  """
  exports: ExportsAddOnService
  """
  This field provides information about the global shipping addon service.
  """
  globalShipping: GlobalShippingAddOnService
}

"""
Order Adjustment, refer to any adjustment happens after order was successfully created.
for example, return, cancel and refund etc.
"""
interface OrderAdjustment {
  """User-friendly ID of the adjustment."""
  adjustmentId: ID!
  """Creation date of the adjustment."""
  createdAt: DateTime!
  """State of the adjustment."""
  state: OrderAdjustmentState!
  """Last updated date-time of the adjustment."""
  updatedAt: DateTime!
}

"""
This type indicates that an order adjustment was abandoned (not completed and not explicitly canceled) through a human-readable label.
"""
type OrderAdjustmentAbandoned implements Labeled {
  """A human-readable label for the state."""
  label: String!
}

"""
This type indicates that an order adjustment was canceled and will not be applied through a human-readable label.
"""
type OrderAdjustmentCancelled implements Labeled {
  """A human-readable label for the state."""
  label: String!
}

"""
This type indicates that an order adjustment has been successfully applied or completed through a human-readable label.
"""
type OrderAdjustmentCompleted implements Labeled {
  """A human-readable label for the state."""
  label: String!
}

"""
This type indicates that an order adjustment has been created and is pending processing through a human-readable label.
"""
type OrderAdjustmentCreated implements Labeled {
  """A human-readable label for the state."""
  label: String!
}

"""
This type represents the current state of an order adjustment. Each variant is a labeled, type that describes a specific phase of the adjustment lifecycle.
"""
union OrderAdjustmentState = OrderAdjustmentAbandoned | OrderAdjustmentCancelled | OrderAdjustmentCompleted | OrderAdjustmentCreated

"""
This type represents the cancellation of an order contract. 

**Note:** The `lineItems` field contains a field named `orderLineItem` that the represents the original order line item.
"""
type OrderCancellation implements ContractCancellation {
  """ The buyer involved in this order cancellation. """
  buyer: User!
  """
  This field provides available actions for the buyer involved in the order cancellation request, and contains a primary action and deadline. If no action is available based on current cancellation status, this field will not be set.
  """
  buyerAvailableActions: ContractCancellationActions @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.cancellation.read&eBayUser", "https://api.ebay.com/oauth/api_scope/buy.cancellation&eBayUser"])
  """ The unique identifier of this order cancellation. """
  cancellationId: ID!
  """If closed, the date when the order cancellation was closed."""
  closedAt: DateTime
  """ Line-level entries included in the order cancellation. Always contains at least one line item. 
  """
  lineItems: [OrderCancellationLineItem!]!
  """ The reason provided for the order cancellation. """
  reason: ContractCancellationReason!
  """
  A list of one or more refunds resulting from this order cancellation. Present only if refund processing was initiated during cancellation; otherwise, null.
  """
  refunds: [Refund!] @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.refund.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.refund.read&eBayUser"])
  """ The timestamp when the order cancellation was requested. """
  requestedAt: DateTime!
  """ The entity that requested the order cancellation (for example, `BUYER`). 
  """
  requester: PostPurchaseActorRole!
  """
  An optional note provided when requesting the order cancellation, if the requester provided a note; otherwise, null.
  """
  requesterNote: String
  """ The seller involved in this order cancellation. """
  seller: User!
  """
  This field provides available actions for the seller involved in the order cancellation request, and contains a primary action and deadline. If no action is available based on current cancellation status, this field will not be set.
  """
  sellerAvailableActions: ContractCancellationActions @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.cancellation.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.cancellation&eBayUser"])
  """ The present status of this order cancellation. """
  status: ContractCancellationStatus!
}

"""
This type represents an ineligibility reason indicating that the cancellation window on an order has elapsed.
"""
type OrderCancellationConflictWithWindowElapsed implements OrderCancellationIneligibilityReason {
  """
  Machine-readable eligibility failure reason code. For this type, the value is `CNCL_CANCELLATION_WINDOW_ELAPSED`.
  """
  code: String!
  """
  Human-readable message of the eligibility failure reason: It's too late to cancel this order. Please contact the buyer to see if you can work something out.`. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  The ID of the order ID whose cancellation was blocked by order level eligibility rules.
  """
  orderId: ID!
}

"""
This type represents order-level ineligibility reasons that prevent cancellation. The `ineligibilityReasons` field lists the order‑level reasons the cancellation cannot be performed at this time.

**Note:** Clients should use **errorCode** and **ineligibilityReasons** for programmatic handling; **errorMessage** is intended for display.
"""
type OrderCancellationEligibilityError implements BusinessError {
  """
  The machine-readable error code for this business error. For this type, the value is `CNCL_ORDER_ELIGIBILITY_ERROR`.
  """
  errorCode: String!
  """
  A human-readable description of the error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  A list of one or more order-level contract cancellation ineligibility reasons that block creation of a cancellation. For example, `CancellationExistsConflict` applies when the whole order is already cancelled or a cancellation is in progress. This field is required and contains at least one reason when this error is returned.
  """
  ineligibilityReasons: [OrderCancellationIneligibilityReason!]!
}

"""
This type represents an ineligibility reason indicating that the requested order already has a cancellation on file.
"""
type OrderCancellationExistsConflict implements OrderCancellationIneligibilityReason {
  """
  Machine-readable eligibility failure reason code. For this type, the value is `CNCL_CANCELLATION_EXISTS_CONFLICT`.
  """
  code: String!
  """
  A human-readable description of the error message of the eligibility failure reason. For this type, the value is `You cannot cancel this order because a cancellation exists on this contract.`. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """Identifier of the order for which cancellation is ineligible."""
  orderId: ID!
}

"""
This interface type represents reasons at the order level cancellation ineligible, thereby blocking the creation of a cancellation.

**Note:** Additional interfaces may be added to this union in the future; clients should handle unrecognized interfaces gracefully.
"""
interface OrderCancellationIneligibilityReason {
  """The machine-readable code eligibility failure code."""
  code: String!
  """
  A human-readable failure ineligible reason for display purposes. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  The order ID whose cancellation was blocked by line item level eligibility rules.
  """
  orderId: ID!
}

"""
Line item in an **Order** cancellation.
Provides a direct pointer to the original order line item via `orderLineItem`.
"""
type OrderCancellationLineItem implements ContractCancellationLineItem {
  """Unique identifier of this cancellation line item."""
  cancellationLineItemId: ID!
  """
  Quantity cancelled for original order line item.
  Present only when the order cancellation is completed.
  """
  cancelledQuantity: Int
  """The reference for cancelled item reference."""
  item: ContractCancellationItemReference
  """
  The restock details for the cancelled listing.
  Present only when listing restock is requested through cancellation mutations.
  This can be a list in case we will support restock for individual listing inside one item bundle.
  """
  listingRestockTasks: [PostPurchaseListingRestockTask!] @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.cancellation.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.cancellation&eBayUser"])
  """Reference to the original order line item."""
  orderLineItem: OrderLineItem!
  """Quantity requested for cancellation on original order line item."""
  requestedQuantity: Int!
}

"""
This type represents an ineligibility reason indicating a policy issue that blocked cancellation.
"""
type OrderCancellationReasonNotAllowed implements OrderCancellationIneligibilityReason {
  """Applicable cancellation reasons for current actor."""
  availableReasons: [ContractCancellationReason]!
  """
  The unique machine-readable contract cancellation reason code for this use case. For this type, the value is `CNCL_REASON_NOT_ALLOWED`.
  """
  code: String!
  """
  A human-readable description of the eligibility failure reason: `The cancellation reason you selected is not allowed by policy. Please choose a different reason and try again.`. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  The ID of the order whose cancellation was blocked by order level cancellation eligibility rules.
  """
  orderId: ID!
}

"""A state representing when the order was canceled."""
type OrderCancelled implements Labeled {
  """The cancellation state of the order."""
  cancelState: ContractCancelState
  """The date and time when the order was canceled."""
  cancelledAt: DateTime!
  """A human-readable description of the order's state."""
  label: String!
  """The reason for the cancellation, if available."""
  reason: String
}

"""Represents the origin of a line item in the order."""
union OrderCheckoutSource = ItemCommitment | PurchaseQuote

"""
This type indicates that the order was confirmed after a successful checkout. Payment has been processed and the order is ready for fulfillment.
"""
type OrderConfirmed implements Labeled {
  """The cancellation state, if applicable."""
  cancelState: ContractCancelState
  """The date and time that the order was officially confirmed."""
  confirmedAt: DateTime!
  """
  The current state of the fulfillment process. 
    
  Note: Use this field to track logistics progress for this order.
  """
  fulfillmentState: LogisticsFulfillmentState!
  """
  The current state of the funding process. 
    
  **Note:** Use this field to track and manage funding.
  """
  fundingState: PaymentsState!
  """A human-readable description of the order's state."""
  label: String!
  """
  The current state of the payment hold associated with this order.
    
  **Note:** This field would be null if not applicable.
  """
  paymentHoldState: PaymentHoldState
  """
  The current state of the refund process. 
    
    **Note:** If null,  no refund activity has occurred or is not applicable.
  """
  refundState: ContractRefundState
  """
  The current state of the return process.
    
  **Note:** If null, no return activity has occurred or is not applicable.
  """
  returnState: ContractReturnState
}

"""
This type indicates the item is returned because the buyer purchased it accidentally. Displays as **Ordered accidentally**.
"""
type OrderedAccidentally implements ReturnReason {
  """A machine-readable reason code: `ORDERED_ACCIDENTALLY`"""
  code: String!
  """
  A human-readable return reason that is intended for display only. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type indicates the item is returned because the buyer purchased the wrong size. Displays as **Ordered wrong size**.
"""
type OrderedWrongSize implements ReturnReason {
  """A machine-readable reason code: `ORDERED_WRONG_SIZE`"""
  code: String!
  """
  A human-readable return reason that is intended for display only. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters.
  """
  displayText: String!
}

"""
This type indicates that an exports duty account used as a destination account.
"""
type OrderExportsDutyAccount implements FundAccount {
  """The unique identifier of the domain or type of the account."""
  domain: ID!
  """The unique identifier of the account used for fund transfers."""
  identifier: ID!
}

"""
This type is used to identify a seller's financial account used to charge against for eBay listing and order-related fees.
"""
type OrderFeeAccount implements FundAccount {
  """The unique identifier of the domain or type of the account."""
  domain: ID!
  """The unique identifier of the account that will be charged with fees."""
  identifier: ID!
}

"""
This type indicates that AU Benefit / Incentive account was used as the source account.
"""
type OrderIncentiveAccount implements FundAccount {
  """The domain or type of the account."""
  domain: ID!
  """The unique identifier of the account used for fund transfers."""
  identifier: ID!
  """The details of the offers applied to this account."""
  incentiveDetails: [OrderIncentiveDetails!]
}

"""
This type provides loyalty offer details for gift cards, incentives, benefits, and similar promotions.
"""
type OrderIncentiveDetails {
  """The offer code applied (for example, `GIFT_CARD`)."""
  appliedOfferCode: ID!
  """
  The unique fulfillment reference ID generated by the loyalty system when the offer is evaluated.
  """
  offerFulfillmentId: String!
  """The payment method used to fund the offer."""
  paymentMethod: PurchasePaymentMethod!
}

"""
This interface represents an inquiry such as Item Not Received (INR) or other buyer-seller issue. The fields in this interface capture the full lifecycle of an inquiry from initiation through buyer and seller interactions, shipping events, participant, refunds, and final resolution. 
"""
interface OrderInquiry {
  """
  The timestamp when the inquiry was closed.
  **Note**: This container will be returned null if the inquiry is still open.
  """
  closedAt: DateTime
  """The timestamp when the inquiry was created."""
  createdAt: DateTime!
  """The actor who originally initiated the inquiry (e.g., buyer)."""
  initiator: PostPurchaseActorRole!
  """
  This array returns a list of all actors who have inquired about the same subject within this inquiry — starting with the original initiator, and including any other parties (e.g., buyer, seller, participant, or system) who later engaged. For example, the system might initiate the inquiry after handling time + 1 business day to prompt a seller response, and the buyer might inquire later on EDD + 1 day. Both actors would be listed here as having inquired about the same issue.
  **Note:** This field is required and will always contain at least one actor.
  """
  inquirers: [PostPurchaseActorRole!]!
  """The unique identifier of the inquiry."""
  inquiryId: ID!
  """
  This array returns a list of line items associated with this inquiry. 
  **Note:** This list is guaranteed to be non-null but may be empty in certain valid cases. In most typical cases, it will contain at least one line item.
  """
  lineItems: [OrderInquiryLineItem!]!
  """
  This array returns a list of information or evidence provided by inquiry participants in response to system or CS requests. This includes user-submitted files, text notes, or structured responses.
  **Note:** This array may be an empty list if no additional information was provided.
  """
  providedInformation: [OrderInquiryInformation!]!
  """
  This array returns a list of information or evidence requests made during the inquiry lifecycle. These requests may be generated by the system or manually initiated by participants and are typically used to collect supporting documentation or clarifications from one or more involved parties (e.g., buyer or seller). Examples include requests for tracking details, signature confirmation, proof of delivery or other relevant evidence.
  **Note**: This list may be empty if no additional information was requested.
  """
  requestedInformation: [OrderInquiryInformationRequested!]
  """
  The user or party expected to respond to the inquiry (e.g., seller or eBay agent).
  """
  responder: PostPurchaseActorRole!
  """
  A list of actions currently available to the seller for this inquiry. This container may be returned null if:
  - The viewer is not the seller.
  - No actions are currently available based on the inquiry state and role.
  - The inquiry is in a terminal state (e.g., 'CLOSED').
  """
  sellerAvailableActions: OrderInquiryActions
  """The current overall status of the inquiry (e.g., 'OPEN', 'CLOSED')."""
  status: OrderInquiryStatus!
  """The refund estimation for the return entity."""
  refundEstimate: RefundEstimate
}

"""
This type represents a generic inquiry action that can be taken by an actor (e.g., buyer or seller). Common actions include sending a message, issuing a refund, escalating the case, or closing it.
"""
interface OrderInquiryAction {
  """
  A stable, machine-readable identifier for inquiry action. Example values include `SEND_MESSAGE`, `REFUND`, `ESCALATE`, 'PROVIDE_INFO'.
  **Max length**: 100 characters. 
  **Format**: Alphanumeric.
  """
  code: String!
  """
  The human-readable text for inquiry action.
  **Max length**: 100 characters. 
  **Format**: Alphanumeric.
  """
  displayText: String!
}

"""
This type represents a business error that occurs when a caller attempts to perform an action on an order inquiry, but the action is not permitted in the inquiry’s current state or context. This error is returned when the requested operation is not allowed due to business rules, such as actor permissions, or the inquiry's lifecycle stage.
"""
type OrderInquiryActionNotPermittedError implements BusinessError {
  """
  This array returns a list of actions that are available to the user in the current state. This can be used to guide the user on what actions they can take.
  """
  availableActions: [OrderInquiryAction!]
  """
  The unique identifier for this specific error type - 'ORDER_INQUIRY_ACTION_NOT_PERMITTED_ERROR'
  """
  errorCode: String!
  """
  The human-readable error message for the order inquiry error. 
  **Maximum length**: 500 characters
  **Format**: Alphanumeric
  """
  errorMessage: String!
}

"""
This type represents the set of actions available to a participant during an inquiry. This includes the primary response action and any additional secondary actions that the participant may take before a specific due date.
"""
type OrderInquiryActions {
  """
  This container returns the primary action that the participant is expected to take, along with the deadline by which it must be completed.
  """
  respondByAction: OrderInquiryRespondByAction
  """
  This array returns a list of optional or supporting actions that the seller can take in addition to the primary response.
  """
  secondaryActions: [OrderInquiryAction!]
}

"""This type represents a 'close' action available during an inquiry."""
type OrderInquiryCloseAction implements OrderInquiryAction {
  """
  A stable, machine-readable identifier for the 'close' inquiry action (e.g., 'CLOSE').
  """
  code: String!
  """
  The human-readable text for the 'close' inquiry action.
  **Max length**: 100 characters 
  **Format**: Alphanumeric
  """
  displayText: String!
}

"""This type represents an inquiry that is closed for the participant."""
type OrderInquiryClosed implements OrderInquiryStatus {
  """
  A stable, machine-readable identifier for the 'closed' inquiry status. In this case, `CLOSED`.
  """
  code: String!
  """
  The human-readable text of the 'closed' inquiry status.
  **Max length**: 100 characters
  **Format**: Alphanumeric
  """
  displayText: String!
}

"""
This type represents metadata about a document associated with an inquiry — such as uploaded evidence of signature confirmation, proof of shipping, or delivery.
"""
type OrderInquiryDocument {
  """The unique identifier of the document."""
  documentId: ID!
  """
  The original or display name of the document file, as provided during upload.
  **Minimum value**: 1 
  **Maximum value**: 100
  **Format**: Alphanumeric
  """
  documentName: String!
  """
  The file name extension or format of the document (e.g., 'PDF', 'JPG', 'DOCX') as defined in the **FilenameExtension** enum.
  """
  filenameExtension: FilenameExtension!
  """The timestamp indicating when the document was uploaded."""
  uploadedAt: DateTime!
}

"""
This input represents the filters that can be used when searching for order inquiries.
"""
input OrderInquiryFilterInput {
  """
  Filters the response to only include inquiries in a specified creation date range. This filter defaults to the last 30 days if it is not provided.
  **Note**: Only inquiries created within the last 18 months are supported.
  """
  createdBetween: DateTimeRangeInput
  """
  Filters the response to only include inquiries with a specific listing ID. 
  **Note**: If an invalid or ineligible listing ID is provided, the search will return an empty result.
  """
  listingId: ID
  """
  Filters the response to only include inquiries with a specific order ID. 
  **Note**: If an invalid or ineligible order ID is provided (e.g., the order doesn't belong to the requester), the search will return an empty result.
  """
  orderId: ID
  """
  Filters the response by preset filters to narrow down the order inquiries.
  **Default**: 'AWAITING_SELLER_ACTION', where immediate action is required by seller.
  """
  presets: OrderInquiryFilterPreset! = AWAITING_ACTION_FROM_SELLER
}

"""
This enumerated type defines a set of preset filters useable to filter order inquiries.
"""
enum OrderInquiryFilterPreset {
  """
  This enum value indicates that only inquiries that are awaiting eBay action will be returned. This includes inquiries that are referred to eBay and awaiting eBay decision and action.
  """
  AWAITING_ACTION_FROM_EBAY
  """
  This enum value indicates that only inquiries that are awaiting seller action will be returned. This includes inquires that are awaiting a seller to provide shipment fulfillment detail to buyer or provide a refund.
  """
  AWAITING_ACTION_FROM_SELLER
  """
  This enum value indicates that only inquiries that are closed will be returned. This includes inquires resolved with refund by a seller or by eBay and inquires closed by a buyer or by eBay.
  """
  CLOSED
}

"""
This type represents a participant’s response to an information request within an inquiry. This may include document uploads, notes, tracking numbers, or any evidence submitted in response to a prior information request.
"""
type OrderInquiryInformation {
  """The timestamp when this information was submitted."""
  submittedAt: DateTime!
  """
  This array returns a list of documents or files associated with the submission.
  **Note**: This array may return an empty list if the response was purely textual.
  """
  submittedInformation: [OrderInquiryInformationProvided!]!
  """The party who submitted this information."""
  submitter: PostPurchaseActorRole!
}

"""
This union type represents the structured data provided in response to an information request. The actual type depends on the expected **OrderInquiryInformation** type. For example:
- 'SHIPMENT_TRACKING_INFO' → **OrderInquiryShipmentTracking**
- 'SIGNATURE_CONFIRMATION_INFO' → **OrderInquirySignatureConfirmation**
"""
union OrderInquiryInformationProvided = OrderInquiryShipmentTracking | OrderInquirySignatureConfirmation

"""
This type represents a request for specific information or documentation within an inquiry. Requests can originate from the system or a participant and specify the type of evidence required to support resolution (e.g., tracking number, proof of delivery).
"""
interface OrderInquiryInformationRequested {
  """The timestamp when the request was created."""
  requestedAt: DateTime!
  """The actor who initiated the information request."""
  requester: PostPurchaseActorRole!
}

"""This type defines the pagination input for an order inquiry response. """
input OrderInquiryInitialPageInput {
  """
  This container can be used to specify optional filters to further narrow down the results.
  **Default**: all open order inquiries created in the last 30 days.
  """
  filter: OrderInquiryFilterInput!
  """
  This container can be used to specify sorting options for order inquiries.
  **Default**: Sort by `CREATED_AT` in ascending order.
  """
  sort: OrderInquirySortInput!
}

"""This input is used to retrieve an inquiry by its unique identifier."""
input OrderInquiryInput {
  """The unique identifier of the inquiry."""
  inquiryId: ID!
}

"""
This type represents a business error that occurs when the specified date range exceeds the allowed limit or has an invalid start and end date order.
"""
type OrderInquiryInvalidDateRangeError implements BusinessError {
  """
  The unique identifier for this specific error type - 'INQRY_INVALID_DATE_RANGE'
  """
  errorCode: String!
  """
  The human-readable error message for the order inquiry error. 
  **Maximum length**: 512 characters
  **Format**: Alphanumeric  
  """
  errorMessage: String!
}

"""
This type represents a business error that occurs when the specified page size exceeds the allowed limit.
"""
type OrderInquiryInvalidPageSizeError implements BusinessError {
  """
  The unique identifier for this specific error type - 'INQRY_INVALID_PAGE_SIZE'
  """
  errorCode: String!
  """
  The human-readable error message for the order inquiry error. 
  **Maximum length**: 512 characters
  **Format**: Alphanumeric   
  """
  errorMessage: String!
  """The maximum allowed page size."""
  maxAllowedPageSize: Int!
  """The minimum allowed page size."""
  minAllowedPageSize: Int!
  """The requested page size."""
  requestedPageSize: Int!
}

"""
This type represents a business error that occurs when the search request must include either initial search input or page cursor information.
"""
type OrderInquiryInvalidSearchInputError implements BusinessError {
  """
  The unique identifier for this specific error type - 'INQRY_INVALID_SEARCH_INPUT'
  """
  errorCode: String!
  """
  The human-readable error message for the order inquiry error. 
  **Maximum length**: 512 characters
  **Format**: Alphanumeric  
  """
  errorMessage: String!
}

"""
This type represents a specific item in an order involved in the inquiry.
"""
type OrderInquiryLineItem {
  """The unique identifier of the order inquiry line item."""
  inquiryLineItemId: ID!
  """The unique identifier of the order line item that was purchased."""
  orderLineItem: OrderLineItem!
  """
  The quantity of the item under inquiry.
  **Note**: This field may be returned null if the quantity is not applicable to the inquiry context.
  """
  quantity: Int
}

"""
This type represents the constraints defined for inquiry message input.
"""
type OrderInquiryMessageConstraint {
  """The length of characters allowed for inquiry message input."""
  characterLimit: InputTextLengthRange!
}

"""This type represents the order inquiry message input field violation."""
type OrderInquiryMessageFieldViolation implements SendOrderInquiryMessageInputViolation & SubmitOrderInquiryReferralInputViolation {
  """The machine-readable code (for example: 'INQRY_MESSAGE_VIOLATION')."""
  code: String!
  """
  This container represents the acceptable characters and length for inquiry message input.
  """
  constraint: OrderInquiryMessageConstraint!
  """
  This boolean indicates whether the inquiry message contains invalid characters or not.  If 'true', the message contains invalid characters.
  """
  containsInvalidCharacters: Boolean!
  """
  The human-readable error message describing the issue. 
  **Maximum length**: 512 characters
  """
  displayMessage: String!
  """
  This boolean indicates whether the inquiry message exceeded the allowed length or not. If 'true', the message exceeds the allowed length. 
  """
  exceededLength: Boolean!
}

"""
This type represents a business error that occurs when the provided order inquiry identifier does not match any known inquiry. This error is returned when the inquiry referenced in the input does not exist, is not accessible to the caller, or has been deleted.
"""
type OrderInquiryNotFoundError implements BusinessError {
  """
  The unique identifier for this specific error type - 'ORDER_INQUIRY_NOT_FOUND_ERROR'
  """
  errorCode: String!
  """
  The human-readable error message for the order inquiry error. 
  **Maximum length**: 500 characters
  **Format**: Alphanumeric  
  """
  errorMessage: String!
  """The unique identifier of the requested inquiry that was not found."""
  inquiryId: ID!
}

"""
This type represents an inquiry that is open and awaiting responder action.
"""
type OrderInquiryOpen implements OrderInquiryStatus {
  """
  A stable, machine-readable identifier for the 'open' inquiry status. In this case, `OPEN`.
  """
  code: String!
  """
