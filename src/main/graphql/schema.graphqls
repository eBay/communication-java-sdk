"""
This type is used to show a monetary amount that is converted to a different currency, such as the buyer's or seller's currency. The **amount** and  **exchangeRate** values are only estimates or projections if the actual conversion has not happened yet.
"""
type ExchangeAmount {
  """
  The converted monetary amount in the buyer's or seller's currency.
    
  **Note**: This value is only an estimate or projection if the actual conversion has not happened yet.
  """
  amount: Amount!
  """
  The timestamp indicates when the currency conversion happened at the rate found in the **exchangeRate** field.
    
  **Note**: Will be null if currency conversion has not happened or if the the timestamp is unavailable.
  """
  exchangeAt: DateTime
  """
  The exchange rate that was used or will be used for the currency conversion.
    
  **Note**: This rate fluctuates until the currency conversion has taken place, but currency conversion happens, the rate no longer changes.
  """
  exchangeRate: Decimal
}

"""
The values in this enumeration type are used to indicate if the corresponding monetary amount is being shown in the buyer's or seller's currency.
"""
enum ExchangeAmountScenario {
  """
  This value indicates that the corresponding monetary amount is being shown in the buyer's currency. 
  """
  BUYER_CURRENCY
  """
  This value indicates that the corresponding monetary amount is being shown in the seller's currency. 
  """
  SELLER_CURRENCY
}

"""
This union type is used by the **ExchangeAmount** type in the case of a successful conversion and by the **InvalidExchangeScenarioInputError** in the case of a failed conversion.
"""
union ExchangeScenarioResult = ExchangeAmount | InvalidExchangeScenarioInputError

"""
This type contains details about exports addon service related information.
"""
