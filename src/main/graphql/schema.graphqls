  """
  name: String!
}

"""
This type indicates the cancellation reason is late delivery of the item.
"""
type LateDeliveryCancellation implements ContractCancellationReason {
  """
  The unique machine-readable contract cancellation reason code for this use case. For this type, the value is `LATE_DELIVERY`.
  """
  code: String!
  """
  A human-readable description of the cancellation reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type provides optional add-on features or services associated with an order line item.
"""
type LineItemAddOnService {
  """
  This field is returned when a third-party authenticator performs the authentication verification inspection add-on service on the order line item. The returned value indicates if the item passed or failed the inspection.
  """
  authenticityVerification: AuthenticityVerificationAddOnService
  """
  This field provides information about the selected eBay vault program for the order. This is returned only for those items that are eligible for the eBay Vault add-on service.
  """
  eBayVault: EbayVaultAddOnService
  """
  This field provides export details for orders using an international shipping add-on service.
  """
  exports: ExportsAddOnService
  """
  This field provides details about an order line item handled by fulfillment add-on service.
  """
  fulfillment: FulfillmentAddOnService
  """This field provides information about the Global Shipping Program."""
  globalShipping: GlobalShippingAddOnService
  """
  This field provides details for a line item that uses the motor purchase add-on service.
  """
  motorPurchase: MotorPurchaseAddOnService
}

"""
This union type is used by the **ItemCommitment**, **PurchaseQuoteLineItem**, and **OrderLineItem** types to provide the unique identifier of a line item within any one of those three different entities.
"""
union LineItemReference = ItemCommitment | OrderLineItem | PurchaseQuoteLineItem

"""
This error type represents details about a specific line item retrieval failure.
"""
type LineItemsByIdsError {
  """
  A human-readable description of the error message. This string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  The machine-readable error code for this business error. For this type, the available values are:
  - `INVALID_INPUT`: The input data is invalid; retry will not succeed.
  - `TEMPORARILY_NOT_AVAILABLE`: The service is temporarily unavailable; retry may succeed.
  """
  errorCode: String!
  """The ID of the line item ID that could not be retrieved."""
  inputLineItemId: ID!
  """
  When `true`, the operation can be retried and may succeed. When `false`, a retry will not succeed.
  """
  retryable: Boolean!
}

"""
Represents a set of monetary totals related to a line item,
shared across different contexts like orders, purchaseQuotes, or itemCommitments.
"""
interface LineItemTotals {
  """LineItemTotal refers to the total cost of all items"""
  lineItemTotal: AmountSet!
  """
  Subtotal refers to the total cost of all items
  before any additional charges or discounts are applied
  """
  subtotal: AmountSet!
}

"""Linked line item (wrapper for reuse across entities)."""
type LinkedLineItem {
  """
  Linked line item detail information; may be null if data is not available.
  """
  linkedLineItem: LineItemReference
  """Order ID of the linked line item."""
  linkedOrderId: String!
  """Line item ID of the linked line item."""
  linkedOrderLineItemId: String!
}

"""Container for the category info of the item listed in current listing"""
type ListingCategory {
  """Unique identifier of an eBay category. This is always required."""
  primaryCategory: Category!
  """
  Unique identifier of an eBay category. Returned only if it is specified by the seller.
  """
  secondaryCategory: Category
  """
  Unique identifier of a primary custom category in which to list the item. A custom category is a category that the seller created in their eBay Store.
  """
  storePrimaryCategory: StoreCategory
  """
  Unique identifier for the secondary custom category in which to list the item. This field is set to a root-level custom category or a custom category that has no child categories (subcategories). Returned only if it is specified by the seller.
  """
  storeSecondaryCategory: StoreCategory
}

"""
Containing details of the item condition descriptors and associated values.
"""
type ListingConditionDescriptor {
  """
  This field provides additional information about a condition descriptor. One example is using this field to specify the **Certification Number** for a graded card.
  """
  additionalInformation: String
  """The name of the condition descriptor."""
  conditionDescriptor: ConditionDescriptor
  """The value of the condition descriptor."""
  conditionDescriptorValues: [ConditionDescriptorValue!]
}

"""
This enumeration type contains the values that indicate the block of days when a classified ad seller can be contacted by potential buyers to answer questions about an item.
"""
enum ListingDaysCode {
  """
  This enumeration value indicates that the corresponding support hours are effective each day of the week. If the **anyTime** boolean field is 'true', that would indicate that the seller may be contacted 24 x 7.
  """
  EVERYDAY
  """
  This enumeration value indicates that the corresponding support hours are effective each weekday (Monday through Friday).
  """
  WEEKDAYS
  """
  This enumeration value indicates that the corresponding support hours are effective on weekends (Saturday and Sunday).
  """
  WEEKENDS
}

"""
This type is used to indicate the radius for a Motors local listing, making it available to buyers within that specified area. The seller's supplied **postalCode** or **location** field value will be used as the center point for this radius.
"""
type ListingDistance {
  """
  The numeric value for the radius. The unit of measurement for this value is specified in the **distanceUnit** field. This value defines the radius of the area around the seller's location where the listing will be visible to local buyers.
  """
  distance: Int
  """ The unit of measure for the distance """
  distanceUnit: DistanceUnit
}

"""
This enumeration type contains the listing duration values that can be used for listings. Supported listing duration times can vary be eBay marketplace, eBay category, and listing type.
"""
enum ListingDurationInDays {
  """
  This enumeration value indicates that the listing duration is one day (24 hours). This duration time is common for auction listings.
  """
  DAYS_1
  """
  This enumeration value indicates that the listing duration is ten days. This duration time is common for auction listings.
  """
  DAYS_10
  """
  This enumeration value indicates that the listing duration is 120 days.
  """
  DAYS_120
  """This enumeration value indicates that the listing duration is 14 days."""
  DAYS_14
  """This enumeration value indicates that the listing duration is 21 days."""
  DAYS_21
  """
  This enumeration value indicates that the listing duration is three days. This duration time is common for auction listings.
  """
  DAYS_3
  """
  This enumeration value indicates that the listing duration is 30 days. This duration time is common for classified ad listings.
  """
  DAYS_30
  """
  This enumeration value indicates that the listing duration is five days. This duration time is common for auction listings.
  """
  DAYS_5
  """This enumeration value indicates that the listing duration is 60 days."""
  DAYS_60
  """
  This enumeration value indicates that the listing duration is seven days. This duration time is common for auction listings.
  """
  DAYS_7
  """This enumeration value indicates that the listing duration is 90 days."""
  DAYS_90
  """
  This enumeration value indicates that the listing will remain active until it is cancelled by the seller or the item is sold out (without the seller have Out of Stock option enabled).
  `GTC` stands for *Good 'Til Cancelled*. All fixed-price listings must have `GTC` set as their listing duration.
  As long as the listing has inventory, eBay will automatically renew the listing each month. Note that insertion fees may apply with renewal each month.
  """
  GTC
}

"""
This enumeration type lists the type of discounts that may be applied towards a seller's listing-related fees.
"""
enum ListingFeeDiscount {
  """
  This enum value indicates that a promotional offer is being applied against the seller's listing fee.
  """
  PROMOTION
  """
  This enum value indicates that a special offer is being applied against the seller's listing fee.
  """
  SPECIAL_OFFER
}

"""
This enumeration type contains the list of fees that can be charged to a seller when creating or updating a listing.
"""
enum ListingFeeType {
  """
  This enum value indicates a Bold title fee was charged for the listing. Sellers have the option of their title appearing in bold type in search results for a small fee.
  """
  BOLD
  """
  This enum value indicates a Buy it Now fee was charged for the auction listing. If a seller adds a Buy it Now option to an auction listing, a user will have the opportunity to buy the item at that price before competitive bidding begins. Once an auction listing gets its first qualifying bid, the Buy it Now feature will be disabled, but the seller will still be liable for this listing-related fee.
  """
  BUYITNOW
  """
  This enum value indicates a Listing Designer fee was charged for the listing.
  **Note**: This fee type is deprecated.
  """
  DESIGNER
  """
     This enum value indicates an Extended Listing Duration fee was charged for the listing.
  **Note**: This fee type is deprecated.
  """
  EXTENDED_DURATION_LISTING
  """
     This enum value indicates a Gallery fee was charged for the listing.
  **Note**: This fee type is deprecated.
  """
  GALLERY
  """
  This enum value indicates a Gallery Plus fee was charged for the listing. With Gallery Plus, the listing's main image will show in search results with a larger picture.
  """
  GALLERY_PLUS
  """
  This enum value indicates an Insertion fee was charged for the listing. Sellers get a certain amount of zero insertion fee listings per month, but if and when they exceed that threshold, an insertion fee may apply.
  """
  INSERTION
  """
  This enum value indicates an International site visibility (also known as 'Cross Border Trade') fee was charged for the listing. With International site visibility, sellers have the option of exposing their item on other marketplaces for a small fee.
  Fee for international listing option
  """
  INTERNATIONAL_LISTING
  """
  This enum value indicates a Picture Pack fee was charged for the listing.
  **Note**: This fee type is deprecated.
  """
  PHOTO_COUNT
  """
     This enum value indicates a Private Listing fee was charged for the listing.
  **Note**: This fee type is deprecated.
  """
  PRIVATE_LISTING
  """
  This enum value indicates a Reserve Price fee was charged for the auction listing. A reserve price is the lowest price that a seller is willing to sell an item for through an auction listing. If this price is not matched or exceeded by the scheduled end of the listing, there will be no winning bidder.
  """
  RESERVE
  """
  This enum value indicates a Scheduled Listing fee was charged for the listing. With a schedule listing, a seller creates a listing but opts to publish the listing at a future date instead of publishing it immediately. 
  """
  SCHEDULED
  """
  This enum value indicates a Subtitle fee was charged for the listing. Sellers have the option of adding a subtitle to their listing for a small fee. A subtitle may help a listing get better search results due to more keywords being used and may also help an item stand out more than other comparable listings without subtitles. 
  """
  SUBTITLE
}

"""
This enumeration type contains the list of available listing formats used for eBay listings.
"""
enum ListingFormatType {
  """
  This enumeration value indicates that the listing is an auction listing. In an auction listing, prospective buyers engage in a competitive bidding process. In addition to the competitive bidding process, a seller may also enable the 'Buy it Now' feature or they can accept Best Offers, but not both at the same time. Once an auction listing has a qualifying bid, either the 'Buy it Now' feature (if set) or the Best Offer feature (if set) is disabled for the duration of the listing. Although listing durations may vary by eBay marketplace and category, typical listing durations for auctions are 1, 3, 5, 7, and 10 days.
  """
  AUCTION
  """
  This enumeration value indicates that the listing is a classified ad listing. Limited eBay categories support classified ad listings, and the actual sales transaction, if one occurs, will happen off of eBay's platform. Since classified ads do not generate revenue for eBay through the Final Value Fee, eBay will charge a higher insertion fee upfront. The amount of this fee varies based on the eBay category.
  """
  CLASSIFIED_AD
  """
  This enumeration value indicates that the listing is a fixed price listing. In a fixed price listing, the 'Buy it Now' price is set, although it is still possible for the seller to enable the Best Offer feature and accept/decline Best Offers from prospective buyers. The different versions of fixed-price listings include a single item with a quantity of '1', multiple quantity of an identical item, or a multiple-variation listing where slightly different variations of the same item are made available for sale.
  """
  FIXED_PRICE
}

"""
This type is used to display a Global Trade Item Number (GTIN) for the item. A GTIN is a globally unique product identifier and includes UPCs, EANs, and ISBNs.
"""
type ListingGlobalProductIdentifiers {
  """
  The European Article Number (EAN) identifier associated with the product, if any. An EAN is a 13-digit barcode standard used internationally outside of the US and Canada for retail product identification.
  """
  ean: ID
  """
  The International Standard Book Number (ISBN) identifier associated with the product, if any. An ISBN is a 13-digit (modern format) or 10-digit (old format) barcode standard used internationally for book identification.
  """
  isbn: ID
  """
  The Universal Product Code (UPC) identifier associated with the product, if any. A UPC is a 12-digit barcode standard used primarily in North America for retail product identification.
  """
  upc: ID
}

"""
A type used for identifying listings using either system-generated IDs or seller-defined SKUs. One of these identifiers must be provided to identify the listing to take action on.
"""
input ListingIdentifierInput {
  """
     The unique identifier of an eBay listing that is generated as soon as a listing is successfully created. This ID is permanent throughout the life of a listing and can be used for all subsequent operations on the listing.
  **Note**: Either a **listingId** or a **sku** value must be used.
  """
  listingId: ID
  """
     The seller-defined Stock Keeping Unit (SKU) for the product. SKU values are optional for single-variation listings but required for multiple-variation listings. The **sku** value can be used as an alternative to the **listingId** to identify the listing in **Listing API** mutations and queries.
     **Max length**: 50 characters.
  **Note**: Either a **listingId** or a **sku** value must be used.
  """
  sku: String
}

"""
This error is returned when the number of listing IDs provided for the `sellerListingSearch` query exceeds the maximum allowed limit.
"""
type ListingIdsExceedMaxError implements SellerListingSearchInputError {
  """The actual number of listing IDs provided."""
  actualCount: Int!
  """
  Technical description of the error for developers and debugging purposes.
  """
  errorDescription: String!
  """The maximum number of listing IDs allowed."""
  maxAllowed: Int!
  """
  User-friendly suggestion on how to fix the error. This can be displayed to end users to help them correct their input.
  """
  remedy: String!
}

"""
This type is used to show the URL of an image that is attached to an eBay listing and the display order of that image in the View Item gallery. If the seller used an externally-hosted image, the URL of that image is also shown.
"""
type ListingImage {
  """
  The fully-qualified eBay Pictures Services (ePS) URL to an image that is attached to the listing.
  """
  ebayImageUrl: HttpsUrl
  """
  The fully-qualified URL to an image that is hosted on an external server for which an ePS image was created for and attached to the listing. This field will only be shown to the seller and only if a URL for am image on an external server was provided when the seller created or revised the listing.
  """
  externalImageUrl: HttpsUrl
  """
  Seller provided order of the picture in which the image should be displayed
  """
  order: Int
}

"""
This type is used to define some key details of a purchasable item within a listing, including its sku value, price, quantity, and any applicable global product identifiers. Every listing contains at least one item.

**Important**: This type contains only the seller's input data and is distinct from other item-related types that may include additional data not provided directly by the seller when creating, updating, or relisting the item.
"""
type ListingItem {
  """
  The unique identifier of the ID of the item. This can serve as a key to reference a specific item in a listing.
  
  **Note**: This ID is not the same as **listingId**.
  """
  itemId: ID
  """
  This container is mandatory for a multiple-SKU listing to identify each variation's unique combination of trait values through the **traits** array. The **globalIdentifiers** container will show any Global Trade Item Numbers (GTINs)or eBay Product IDs (ePIDs) that are associated with the product.
  """
  itemSellerProduct: ItemSellerProduct
  """
  This container is used to display the price and quantity of a purchaseable item, and is also used to provide an eco-participation fee for a product, if applicable.
  """
  itemTerms: ItemTerms
  """
  This field is the seller-defined Stock Keeping Unit (SKU) value for the item. An item-level **sku** value is mandatory for multiple-SKU listings, but optional for single-SKU listings. The seller has the option to identify the listing by SKU value as opposed to **listingId**.
  """
  sku: String
}

"""
This type is used to display auction-specific price settings for auction listings. Not applicable for multiple-SKU listings.
"""
type ListingItemAuctionPrice {
  """
  This field shows the lowest price at which the seller is willing to sell an item in an auction listing. A small fee is charged to use this feature. If the **reservePrice** field value is not met or surpassed during bidding, the auction will end without a winning bidder. This price must be higher than the **startingBidPrice**. The price will be in the default currency for the marketplace for this listing.
  """
  reservePrice: ConvertedAmount
  """
  This field is mandatory for auction listings and sets the starting bid amount. The first bid must meet or exceed this value or it will be rejected. The price will be in the default currency for the marketplace for this listing.
  """
  startingBidPrice: ConvertedAmount
}

"""
This type is used to display the available quantity and quantity sold for a purchasable item.
"""
type ListingItemAvailability {
  """
  The quantity available for an item. For auction listings, this value will always be 1. For a multiple-SKU listing, each item variation can have its own quantity value, allowing sellers to manage inventory for each variation independently.
  **Note**: For a multiple-SKU listing, the quantity for an item variation may be 0 if the SKU is temporarily out of stock, but a seller wishes to retain the variation and restock inventory at a later time.
  **Note**: This should not be null unless an error has occurred.
  """
  quantityAvailable: Int
  """
  The quantity of the item sold during the duration of the listing.
  **Note**: This should not be null unless an error has occurred.
  """
  quantitySold: Int
}

"""
This type is used by the response of a **bulkUpdateInventory** mutation to indicate which items were successfully updated and which items failed to be updated. For both the **successes** and **failures** arrays, either the **listingId** or **sku** value or both will indicate the items that were successfully updated and those that failed, respectively. 

**On a successful update:**
The identifier will contain the `listingId` and/or `SKU` for the item. This may differ from the information that was provided in the input in certain cases. For example, if you provide only a `SKU` in the request, a successful response will include both the `SKU` and the corresponding `listingId` that the system resolved for that item.

**On a failed update:**
The identifier contains an exact echo of the `listingId` and/or `SKU` exactly as it was provided in the request for the specific item that failed. This helps you identify which input item caused the error. If a field was omitted in the input (e.g., `listingId` was not provided), it will also be absent (null) in this identifier.
"""
type ListingItemIdentifier {
  """
     The unique identifier of the listing that was successfully updated (if returned in the **successes** array) or which failed to be updated (if returned in the **failures** array).
  **Note**: If an item was successfully updated, this field will be returned along with the **sku** field even if it was the **sku** that was used to identify the item in the input. If an item failed to be updated, this field will only be returned if it was used to identify the item in the input.
  """
  listingId: ID
  """
     The seller-defined SKU of the item that was successfully updated (if returned in the **successes** array) or which failed to be updated (if returned in the **failures** array).
  **Note**: This field will only be returned if it was used to identify the item in the input.
  """
  sku: ID
}

"""
This type is used to identify a specific item to update. An item within a single-SKU listing can be identified with a **listingId** or a **sku** value (if a sku value is defined in the listing). A **sku** value must be used for an item within a multiple-SKU listing. 
"""
input ListingItemIdentifierInput {
  """
     The unique identifier for the single-SKU fixed price listing to update. 
  **Note**: This field cannot be used to identify an item within a multiple-SKU listing, and the **sku** field must be used instead.
  """
  listingId: ID
  """
  The seller-defined Stock Keeping Unit (SKU) for the item to update. This field is required to identify a specific item within a multiple-SKU listing. For a single-SKU listing, either this field (if a SKU is defined in the listing) or the **listingId** can be used to identify the item.
  **Format**: Alphanumeric string.
  """
  sku: ID
}

"""
This type provides pricing and other settings related to the Minimum Advertised Price, Strikethrough Pricing, or eBay Outlet features. All three of these features are restricted and sellers must qualify to use them.
"""
type ListingItemMarketingPrice {
  """
  This container displays the **Made for Outlet** comparison price for a listing, and can only be used if the listing will be displayed on an eBay Outlet page. This is a restricted feature that sellers must qualify to use.
  """
  madeForOutletComparisonPrice: ConvertedAmount
  """
  This container displays the Minimum Advertised Price (MAP) for a listing. MAP is an agreement between suppliers (or manufacturers (OEM)) and the retailers (sellers) stipulating the lowest price a listing is allowed to be advertised at. Sellers can offer prices below MAP by means of other discounts. This only applies to fixed price listings and auction listings with the 'Buy It Now' option. This is a restricted feature that sellers must qualify to use.
  """
  minimumAdvertisedPrice: ConvertedAmount
  """
  This field is only applicable for the Minimum Advertised Price feature, and indicates whether the discounted price is shown to buyers prior to checkout by the buyer clicking on a link on the View Item page, or the discounted price is shown just prior to checkout when the buyer has clicked the Buy button.
  """
  minimumAdvertisedPriceExposure: ListingMinimumAdvertisedPriceExposure
  """
  This price must be provided if a qualified seller is using the Strikethrough Price feature. The **originalRetailPrice** value is the actual retail price set by the manufacturer (OEM). The price in this field should always be more than the price specified in the **fixedPrice** field.
  """
  originalRetailPrice: ConvertedAmount
  """
  This field is only applicable for the Strikethrough Price feature, and is used to indicate whether or not the same item was being sold on another e-commerce site at the manufacturer suggested (OEM) retail price. If the Strikethrough Price feature is being used, either this field or the **soldOnEbay** field must be included and set to 'true', and it is acceptable for them both to be included and set to 'true'.
  """
  soldOffEbay: Boolean
  """
  This field is only applicable for the Strikethrough Price feature, and is used to indicate whether or not the same item was being sold on an eBay marketplace at the manufacturer suggested (OEM) retail price. If the Strikethrough Price feature is being used, either this field or the **soldOffEbay** field must be included and set to 'true', and it is acceptable for them both to be included and set to 'true'.
  """
  soldOnEbay: Boolean
}

"""
This type is used to display price data for an item in a listing, including the price for a fixed price listing or the 'Buy it Now' price for an auction listing. Other price fields include auction starting bid price, auction reserve price, and other settings related to discount pricing features.
"""
type ListingItemPricingTerms {
  """
  This container provides auction-specific price settings including starting bid price and reserve price (if set). This container does not apply for multi-sku listings.
  """
  auctionPrice: ListingItemAuctionPrice
  """
  This field shows the price of a fixed price item or the 'Buy it Now' price for an auction listing. This field is mandatory for fixed price listings. The 'Buy it Now' option is disabled for an auction listing as soon as that listing has a qualifying bid. The price will be in the default currency for the marketplace for this listing.
  """
  fixedPrice: ConvertedAmount
  """
  This container provides pricing and other settings related to the Minimum Advertised Price, Strikethrough Pricing, or eBay Outlet features. All three of these features are restricted and sellers must qualify to use them.
  """
  marketingPrice: ListingItemMarketingPrice
}

"""
Specifies the lifecycle details for the listing like stateDate, EndDate, Duration, etc.
"""
type ListingLifecycle {
  """The time that the listing actually becomes ended on eBay"""
  actualEndAt: DateTime
  """Date and time the listing was created."""
  createdAt: DateTime
  """
  The reason to end the listing. It will be used to provide the reason for ending the listing.
  This will be null if the listing has not ended.
  """
  endListingReason: EndListingReason
  """
  This field indicates the time duration of the listing. All fixed price listings must be set to
  `GTC`(Good 'til Cancelled), but the listing duration days of auction and ad listings may vary based on
  marketplace and category.
    
  The [getListingTypePolicies](https://developer.ebay.com/api-docs/sell/metadata/resources/marketplace/methods/getListingTypePolicies)
  method can be used to see supported durations for each leaf category.
  """
  listingDurationInDays: ListingDurationInDays
  """Allowed values:SCHEDULED, ACTIVE, ENDED"""
  listingStatus: ListingStatusEnum
  """
  The time that the listing is supposed to be ended on eBay. This will be null if the end date has not been scueduled
  """
  scheduledEndAt: DateTime
  """
  A time in the future that the listing becomes active on eBay. To schedule the listing start time, specify a time in the future in GMT format.
  When you schedule a start time, the start time is randomized within 15-minute intervals. Randomized start times applies to the following sites:
  AT, BEFR, BENL, CH, DE, ES, FR, IE, IT, NL, PL, UK
    
  This will be null if the startDate was not specified.
  """
  startAt: DateTime
}

"""
This enumeration type contains the list of eBay marketplaces in which listings may be created.
"""
enum ListingMarketplace {
  """
  This enumeration value indicates the applicable marketplace is eBay Austria.
  """
  EBAY_AT
  """
  This enumeration value indicates the applicable marketplace is eBay Australia.
  """
  EBAY_AU
  """
  This enumeration value indicates the applicable marketplace is Dutch language version of eBay Belgium.
  """
  EBAY_BE
  """
  This enumeration value indicates the applicable marketplace is English language version of eBay Canada.
  """
  EBAY_CA
  """
  This enumeration value indicates the applicable marketplace is eBay Switzerland.
  """
  EBAY_CH
  """
  This enumeration value indicates the applicable marketplace is eBay Germany.
  """
  EBAY_DE
  """
  This enumeration value indicates the applicable marketplace is eBay Spain.
  """
  EBAY_ES
  """
  This enumeration value indicates the applicable marketplace is eBay France.
  """
  EBAY_FR
  """
  This enumeration value indicates the applicable marketplace is eBay UK.
  """
  EBAY_GB
  """
  This enumeration value indicates the applicable marketplace is eBay Hong Kong.
  """
  EBAY_HK
  """
  This enumeration value indicates the applicable marketplace is eBay Ireland.
  """
  EBAY_IE
  """
  This enumeration value indicates the applicable marketplace is eBay Italy.
  """
  EBAY_IT
  """
  This enumeration value indicates the applicable marketplace is eBay Malaysia.
  """
  EBAY_MY
  """
  This enumeration value indicates the applicable marketplace is eBay Netherlands.
  """
  EBAY_NL
  """
  This enumeration value indicates the applicable marketplace is eBay Philippines.
  """
  EBAY_PH
  """
  This enumeration value indicates the applicable marketplace is eBay Poland.
  """
  EBAY_PL
  """
  This enumeration value indicates the applicable marketplace is eBay Singapore.
  """
  EBAY_SG
  """
  This enumeration value indicates the applicable marketplace is eBay US.
  """
  EBAY_US
}

"""
The enumeration values in this type control how/when the Minimum Advertised Price is exposed to the buyer.
"""
enum ListingMinimumAdvertisedPriceExposure {
  """
  This enumeration value indicates that the buyer must add the item to his/her cart before the discounted price can be displayed.
  """
  DURING_CHECKOUT
  """
  This enumeration value indicates that the discounted price will only be shown to the buyer once the buyer reaches the eBay Checkout page.
  """
  PRE_CHECKOUT
}

"""
This type is needed for motor vehicle listings to provide the Vehicle Identification Number (VIN)
or the Vehicle Registration Mark (VRM) for the motor vehicle.

If this type is provided, then either vin or vrm will be present.
"""
type ListingMotorVehicleIdentifier {
  """
  The Vehicle Identifier Number (VIN) of the motor vehicle that is to be sold.
  The VIN or the VRM IDs are needed for motor vehicle listings.
  """
  vin: ID
  """
  The Vehicle Registration Mark (VRM) of the motor vehicle that is to be sold.
  The VIN or the VRM IDs are needed for motor vehicle listings.
  """
  vrm: ID
}

"""
This type allows a user to run a mutation in validation mode, which means that the listing object will be validated, but a successful mutation will not create/update/relist a listing. 
"""
input ListingOptionsInput {
  """
     This field controls whether a successful mutation will actually create/update a live listing or validation mode can be used where all data is checked and validated, but no new listing is created nor an existing listing updated. If this field is omitted, the mutation will be processed in `EXECUTE` mode. To validate only, this field must be included and set to `VALIDATE`.
  **Default**: EXECUTE
  """
  operationMode: OperationMode = EXECUTE
}

"""
This type is used to specify the dimensions of the shipping package and the unit of measurement used.
"""
type ListingPackageDimensions {
  """
  The height (or depth) of the shipping package in the unit of measurement specified in the corresponding **unit** field.
  """
  height: Float
  """
  The length of the shipping package in the unit of measurement specified in the corresponding **unit** field.
  """
  length: Float
  """
  The unit of measurement used for the dimensions of the shipping package.
  """
  unit: DimensionUnitType
  """
  The width of the shipping package in the unit of measurement specified in the corresponding **unit** field.
  """
  width: Float
}

"""
This enumerated type contains the shipping package type values that can be used in the **packageType** field. Note that supported package types will depend on the shipping service used.
"""
enum ListingPackageType {
  """
  This enumeration value is used as the package type for large, heavy items that might not fit standard shipping packages and require special handling.
  """
  BULKY_GOODS
  """
  This enumeration value is used as the package type for shipping mobile homes or trailers.
  """
  CARAVAN
  """
  This enumeration value is used as the package type for shipping motor vehicles through an auto transport service.
  """
  CARS
  """
  This enumeration value is used as the package type for freight shipping in Europe using a standardized pallet.
  """
  EURO_PALLET
  """
  This enumeration value is used as the package type when shipping items in flexible bags that can expand to fit bulkier/unusually shaped items.
  """
  EXPANDABLE_TOUGH_BAGS
  """
  This enumeration value is used as the package type when shipping items in a very large package.
  """
  EXTRA_LARGE_PACK
  """
  This enumeration value is used as the package type when shipping furniture.
  """
  FURNITURE
  """
  This enumeration value is used as the package type for shipping industrial vehicles and equipment, farm machinery, etc.
  """
  INDUSTRY_VEHICLES
  """
  This enumeration value is used as the package type for shipping a large shipping box offered by Canada Post.
  """
  LARGE_CANADA_POST_BOX
  """
  This enumeration value is used as the package type for shipping a large padded envelope offered by Canada Post. This packaging is appropriate for shipping fragile items through Canada Post.
  """
  LARGE_CANADA_POST_BUBBLE_MAILER
  """
  This enumeration value is used as the package type for shipping a large envelope or flat mailer. This packaging is appropriate for shipping
  documents or flat items. Shipping carriers often use flat rates for this package type.
  """
  LARGE_ENVELOPE
  """
  This enumeration value is used as the package type for shipping a standard letter envelope. This packaging is appropriate for shipping
  documents or flat items. Shipping carriers often use flat rates for this package type.
  """
  LETTER
  """
  This enumeration value is used as the package type for shipping a standard corrugated cardboard box of various sizes.
  """
  MAILING_BOXES
  """
  This enumeration value is used as the package type for shipping a medium-sized shipping box offered by Canada Post.
  """
  MEDIUM_CANADA_POST_BOX
  """
  This enumeration value is used as the package type for shipping a medium-sized padded envelope offered by Canada Post. This packaging is appropriate for shipping fragile items through Canada Post.
  """
  MEDIUM_CANADA_POST_BUBBLE_MAILER
  """
  This enumeration value is used as the package type for shipping motorcycles.
  """
  MOTORBIKES
  """
  This enumeration value can be used as the package type value when the packaging type is not relevant or when
  the seller will determine appropriate packaging based on the item.
  """
  NONE
  """
  This enumeration value is used as the package type value when a heavy/bulky item is being shipped on a pallet.
  """
  ONE_WAY_PALLET
  """
  This enumeration value is used as the package type for shipping an item in a thick protective envelope. This package type is generally used for items that need more protection than a standard envelope but don't require a box.
  """
  PACKAGE_THICK_ENVELOPE
  """
  This enumeration value is used as the package type for shipping an item in a padded shipping bag. This package type is generally used for
  items that need some protection but don't require a rigid box.
  """
  PADDED_BAGS
  """
  This enumeration value is used as the package type for shipping a standard parcel or padded envelope.
  """
  PARCEL_OR_PADDED_ENVELOPE
  """
  This enumeration value is used as the package type for shipping a cylindrical shipping container. This package might be one that you use to ship a poster or blueprints,
  """
  ROLL
  """
  This enumeration value is used as the package type for shipping a small shipping box offered by Canada Post.
  """
  SMALL_CANADA_POST_BOX
  """
  This enumeration value is used as the package type for shipping a small padded envelope offered by Canada Post. This packaging is appropriate for shipping fragile items through Canada Post.
  """
  SMALL_CANADA_POST_BUBBLE_MAILER
  """
  This enumeration value is used as the package type for shipping an item in a heavy-duty shipping bag. This packaging is appropriate for items that need protection but don't require the structure of a box.
  """
  TOUGH_BAGS
  """
  This enumeration value is used as the package type for shipping an item through a UPS letter envelope.
  """
  UPS_LETTER
  """
  This enumeration value is used as the package type for shipping an item through a USPS flat-rate envelope.
  """
  USPS_FLAT_RATE_ENVELOPE
  """
  This enumeration value is used as the package type for shipping an item through a USPS large package.
  """
  USPS_LARGE_PACK
  """
  This enumeration value is used as the package type for shipping an item in a very large package, which may require special handling.
  """
  VERY_LARGE_PACK
  """
  This enumeration value is used as the package type for shipping wine or other glass bottles safely.
  """
  WINE_PAK
}

"""
This type is used to specify the weight of the shipping package according to the unit of measurement applicable to the marketplace. The weight of the shipping package is required when the listing is using the calculated shipping cost type. For English measurement system, the supported unit of measurement is pounds for **majorUnit** and ounces for **minorUnit**. For Metric measurement system, the supported unit of measurement is kilograms for **majorUnit** and grams for **minorUnit**.
"""
type ListingPackageWeight {
  """
  The major weight value of the shipping package according to the unit of measurement applicable to the marketplace. The major weight value is the whole number part of the weight. For English measurement system, the supported unit of measurement for **majorUnit** is pounds. For Metric measurement system, the supported unit of measurement for **majorUnit**
  is kilograms.
    
  Note: If the package weighs less than one pound or one kilogram, 0 may be returned as the value for this field.
  """
  majorUnit: Int
  """
  The minor weight value of the shipping package according to the unit of measurement applicable to the marketplace. The minor weight value is the decimal part of the weight. For English measurement system, the supported unit of measurement for **minorUnit** is ounces. For Metric measurement system, the supported unit of measurement for **minorUnit** is grams.
  """
  minorUnit: Int
  """The unit of measurement used for the weight of the shipping package."""
  unit: WeightUnitType
}

"""
This type consists of the offline payment methods that sellers can specify as available payment methods if the sales transaction happens off an eBay. Note that availability of specific offline payment methods may vary by eBay marketplace and category. The [getCategoryPolicies](https://developer.ebay.com/api-docs/sell/metadata/resources/marketplace/methods/getCategoryPolicies) method can be used to see which payment methods are supported by a leaf category.
"""
enum ListingPaymentMethod {
  """
  This enumeration value specifies/indicates that 'Cash on Delivery' is a payment method accepted by the seller for a sales transaction that happens off of eBay's platform. With this option, the shipping carrier collects payment from the buyer at the time of delivery and forwards it to the seller.
  """
  CASH_ON_DELIVERY
  """
  This enumeration value specifies/indicates that cash is a payment method accepted by the seller for a sales transaction that happens off of eBay's platform between the buyer and seller (e.g. Local Pickup).
  """
  CASH_ON_PICKUP
  """
  This enumeration value specifies/indicates that a money order or a cashier's/bank check is a payment method accepted by the seller for a sales transaction that happens off of eBay's platform between the buyer and seller (e.g. Motor Vehicle sale).
  """
  MONEY_ORDER_CASHIERS_CHECK
  """
  This enumeration value specifies/indicates that for motor vehicle listings, the seller will provide custom payment instructions to buyers. The seller's payment instructions will appear on the eBay listing page and during checkout, allowing the seller to specify alternative payment arrangements for motor vehicle purchases.
  """
  PAYMENT_SEE_DESCRIPTION
  """
  This enumeration value specifies/indicates that a personal check is a payment method accepted by the seller for a sales transaction that happens off of eBay's platform between the buyer and seller (e.g. motor vehicle sale).
  """
  PERSONAL_CHECK
}

"""
This type shows the listing previews, and the external product details used to generate each of the listing previews. A listing preview provides recommended details for key fields to be used in an eBay listing, such as eBay product ID (if found), the title, the product description, the eBay category ID, one or more eBay Picture Service (ePS) image URLs, product aspect name-value pairs, and SKU (if provided).

A listing preview is neither a draft nor a live listing, but rather information generated from external product details that sellers can leverage when creating a listing in a subsequent step using eBay listing APIs.
"""
type ListingPreview {
  """
  eBay's recommended product aspect name-value pairs for the product, or if an eBay catalog product was found, the product aspect name-value pairs associated with the catalog product.
  """
  aspects: [ListingPreviewProductAspect!]
  """
  eBay's recommended eBay leaf category in which to list the product, or if an eBay catalog product was found, the eBay leaf category associated with the catalog product. A null value signifies that the data is unavailable or undefined under certain exceptional conditions.
  """
  category: Category
  """
  This container shows the provided details of the external product that was mapped to an eBay listing preview.
  """
  clientProvidedProductDetails: ExternalProductDetails!
  """
  eBay's recommendation for the description of the product, or if an eBay catalog product was found, the description used for the catalog product. A null value signifies that the data is unavailable or undefined under certain exceptional conditions.
  """
  description: String
  """
  An array of one or more EPS image URLs that can be used with the listing. If images were provided through the **images** array in the mutation request, eBay returns the corresponding EPS image URLs. Additionally, if an eBay catalog product was matched for the external product, the field may also include the catalog product's stock photo URL(s). If no images are available, the array will be null.
  """
  images: [HttpOrHttpsUrl!]
  """
  The unique identifier of this listing preview. Use this 25-character ID when creating or revising a listing based on the listing preview via related APIs.
  
  **Maximum length:** 25 characters
  """
  mappingReferenceId: String!
  """
  The eBay product ID (ePID) field under this container shows the eBay catalog product that the external product was matched to. An ePID value can be used in eBay listing APIs to prefill a listing with product title, product description, product aspects, stock photo(s), and eBay category. If the external product could not be mapped to an ePID, this field will be null.
  """
  product: Product
  """
  The seller-defined SKU of the external product. If the SKU was not provided for an external product, this field returns null.
  """
  sku: String
  """
  eBay's recommendation for the title of the product, or if an eBay catalog product was found, the title used for the catalog product. eBay listings only allow 80 characters for a listing title, so this recommended title may be shorter than the title provided for the external product. A null value signifies that the data is unavailable or undefined under certain exceptional conditions.
  """
  title: String
}

"""
This type shows eBay's recommended product aspect name-value pairs for the product. Each aspect is defined by a name and a list of one or more values. The value in the **values.confidence** field will indicate how confident eBay is about that value being the right value for that corresponding aspect.
**Edge cases to consider**
While most aspects are expected to have a single value associated with it, some aspects may accept multiple values.
Please cross-reference aspect properties for any given category through the **Taxonomy APIs**.
For such aspects, multiple `PREFILL` values may be returned when available.
For example, an aspect could be `Color` with values like `Red`, `Blue`, and `Green` and confidence levels `PREFILL` or `HINT`.
"""
type ListingPreviewProductAspect {
  """An array of one or more values for the aspect."""
  aspectValues: [String!]! @deprecated(reason: "This field is deprecated and has been superseded by the **values** array.")
  """The name of the aspect."""
  name: String!
  """
  An array that has one or more values for the corresponding aspect, and a **confidence** field that indicate how confident eBay is about indicate how confident eBay is about that value being the right value for that corresponding aspect
  """
  values: [ListingPreviewProductAspectValue!]!
}

"""
This type shows the corresponding value(s) for an aspect and the confidence level that eBay has that a value is the right value for that  aspect.
"""
type ListingPreviewProductAspectValue {
  """
  The confidence level of the aspect value. See the **ListingPreviewProductAspectValueConfidenceEnum** type for descriptions of each supported value. This field will only be null under exceptional circumstances.
  """
  confidence: ListingPreviewProductAspectValueConfidenceEnum
  """
  The value of the aspect. This field will only be null under exceptional circumstances.
  """
  value: String
}

"""
An enumerated type that represents the confidence level that eBay has that a recommended product aspect value is the correct one.
"""
enum ListingPreviewProductAspectValueConfidenceEnum {
  """
  This value indicates a medium to high confidence threshold for the suggested aspect value, making sellers more likely to select one of the recommended or hinted values from a set.
  """
  HINT
  """
  This value indicates a high confidence threshold for the suggested aspect value, meaning sellers are more likely to select this prefilled value over other options, when this aspect value is prefilled.
  """
  PREFILL
}

"""
This type shows the ID and the results of a listing previews task that was generated with the mutation request. This asynchronous task can take some time to complete. The listing preview results cannot be returned until the task is complete.
"""
type ListingPreviewsCreationTask {
  """
     The unique identifier of the task. It is returned after a successful **StartListingPreviewsCreation** mutation.
  
  **Max length**: 25
  """
  id: ID!
  """
  This container provides the status and results of the listing previews creation Task. It remains null until the task has completed execution.
  """
  result: ListingPreviewsCreationTaskResult
}

"""
The base type of the **listingPreviewsCreationTaskById** query request, where the **id** value for a listing preview task is passed in.
"""
input ListingPreviewsCreationTaskByIdInput {
  """
   The unique identifier of the listing preview task to retrieve. This **id** value is returned in the **StartListingPreviewsCreation** mutation response.
  **Max length**: 25 characters 
  """
  id: ID!
}

"""
The base type of the **listingPreviewsCreationTaskById** query response. A successful query will return the **id** value for the task, and the listing preview results cannot be returned until the task is complete.
"""
type ListingPreviewsCreationTaskByIdOutput {
  """
  If a **ListingPreviewsCreationTask** corresponding to the **requestId** value exists, it will be returned here.
  If no task with the **requestId** exists, this field will be null.
  """
  listingPreviewsCreationTask: ListingPreviewsCreationTask
  """
  The unique identifier of the listing preview task that was passed into the query request.
  **Max length** 25 characters
  """
  requestedId: ID!
}

"""
This type is used to describe the outcome of a listing preview creation task.
"""
enum ListingPreviewsCreationTaskCompletionStatus {
  """
  This enumeration value indicates that the task has completed successfully with no errors.
  """
  COMPLETED
  """
  This enumeration value indicates that the task has completed successfully, but with one or more errors. Issues that would lead to this status include one or more products being invalid and/or unmapped. The task may have still completed successfully for other products.
  """
  COMPLETED_WITH_ERROR
  """
  This enumeration value indicates that the task was not completed successfully, and no listing previews were generated for any of the external products.
  """
  FAILED
}

"""
This type is used to show the final outcome of a listing previews creation task, and includes the completion status and the actual eBay listing previews. If applicable, unprocessed external products, unmapped external products, and invalid external products are displayed in separate arrays.
"""
type ListingPreviewsCreationTaskResult {
  """ This enumeration value indicates the success or failure of the **StartListingPreviewsCreation** mutation. Applicable values are `COMPLETED`, `COMPLETED_WITH_ERROR`, or `FAILED` 
  """
  completionStatus: ListingPreviewsCreationTaskCompletionStatus!
  """ An array of invalid external products that could not be processed. Each invalid product will include a **description** field that indicates why the external product details could not be used to create a listing preview. This field is intended to be a debugging aid for humans. The description is not localized and is subject to change. Do not use this description field for client-side handling logic. This array will be empty if there are no invalid products. 
  """
  invalidProducts: [InvalidExternalProductDetails!]!
  """ This array will show the eBay listing previews that were successfully created based on the seller's provided external products. Each listing preview will contain the eBay product ID (if found), the title, the product description, the eBay category ID, one or more eBay Picture Service (ePS) image URLs, product aspect name-value pairs, and SKU (if provided). Additionally, this container will also have the **clientProvidedProductDetails** container that shows the client-provided details for the external products. 
  """
  listingPreviews: [ListingPreview!]!
  """ An array of valid external products that were not successfully mapped by eBay into listing previews. These products should not be retried by the client. This array will be empty if there are no unmapped products. 
  """
  unmappedProducts: [ExternalProductDetails!]!
  """ An array of external products that were not processed due to unforeseen circumstances. All of the details provided for each external product in the mutation request are returned under this array. Unprocessed external products can be included in a subsequent mutation request. This array will not be returned or will be null if there are no unprocessed products.
  """
  unprocessedProducts: [ExternalProductDetails!]!
}

"""
This type shows any Global Trade Item Number (GTIN) values and/or an eBay Product ID (ePID) that is associated with an item. When creating or revising a listing, a GTIN or an ePID value can be provided for a product, and if the identifier is matched to an eBay catalog product, the product title, product description, item specifics, and stock photo defined for that product will be used in the resultant listing. A seller leveraging an eBay catalog product can lead to improved listing quality, discoverability, and streamlined listing creation.
"""
type ListingProductIdentifiers {
  """
  The unique identifier of an eBay catalog product. If this field is provided, the title, description, item specifics, and stock photo defined for that ebay product will be used in the resultant listing, overriding the seller provided information. The [search](https://developer.ebay.com/api-docs/commerce/catalog/resources/product_summary/methods/search) method of the **Catalog API**     can be used to search for eBay catalog products and get their IDs.
  """
  ebayProduct: Product
  """
  This container will show any UPC, EAN, or ISBN value for a product. One or more of these values may be explicitly specified by the seller, or they may be picked up from the eBay catalog product if one is used for the item.
  """
  globalIdentifiers: ListingGlobalProductIdentifiers
  """
  This boolean indicates whether or not an eBay catalog product is leveraged to prefill a listing with that catalog product's details, including product title, product description, item specifics, and stock photo.
  """
  includeEbayProductDetails: Boolean
}

"""
ListingReference is a reference to a listing.
This should be used by subgraphs who wish to extend ListingV2 or resolve ListingV2 type based on the listingID.
Using ListingV2 interface for resolving the listing details has its limitations so we strongly recommend using this type instead.
When ULP providers needs to extend Listing schema to add more fields in listing, it can be done in 2 ways.
1. Define the ListingV2 interface as InterfaceObject and add fields to it. But this approach has its limitations as the subgraph will not be able to
refer to concrete types like SingleSkuListing and VariationListing in their schema. So the subgraph will not be able to add fields to these concrete types.
2. Extend the concrete types like SingleSkuListing and VariationListing and add fields to it.
We strongly recommend using the second approach as it will allow the subgraph to add fields to concrete types like SingleSkuListing and VariationListing.
"""
type ListingReference {
  """The listing corresponding to the listingId"""
  listing: ListingV2
  """ID of the listing"""
  listingId: ID!
}

"""
This enumerated type consists of the refund methods that can be used in case of a returned item.
"""
enum ListingRefundMethod {
  """
  This value indicates that the buyer will receive their money back when an item is returned.
  """
  MONEY_BACK
  """
  This value indicates that the buyer can either receive their money back when an item is returned, or the seller can send them a replacement item if there was something wrong with the original item. A seller can offer this if they have a replacement item available, but it is the buyer's choice what they prefer.
  """
  MONEY_BACK_OR_REPLACEMENT
}

"""
This type is used for classified ad listings, and provides contact information for the seller, including days and hours when the seller accepts inquiries from potential buyers.
"""
type ListingSellerContact {
  """The first line of the street address of the seller."""
  addressLine1: String
  """
  The second line of the seller's street address. This field is not always used, but can be used for secondary address information such as 'Suite Number' or 'Apt Number'.
  """
  addressLine2: String
  """This field shows the company name (if any) associated with the seller."""
  companyName: String @deprecated(reason: "Company name is no longer supported")
  """
  This boolean field indicates whether or not potential buyers can contact the seller of the listing by email.
  """
  contactByEmailEnabled: Boolean
  """
  This field shows the two-letter code representing the country where the seller is located.
  """
  country: CountryAlpha2Code
  """
  This field shows the county where the seller is located. This field is only returned if available/applicable.
  """
  county: String
  """
  This field shows the seller's primary phone number. This field is only returned if provided by the seller.
  """
  phone: String
  """
  This object is used to provide the seller's primary support days and hours. This will generally show support hours on weekdays.
  """
  primarySellerContactHours: ListingSellerContactHours
  """
  This object is used to provide the seller's secondary support days and hours. This will generally show support hours on weekends if the support hours vary on weekends.
  """
  secondarySellerContactHours: ListingSellerContactHours
}

"""
This type is used to specify the days and times when a seller may be contacted regarding a classified ad listing. This type is used by the **primarySellerContactHours** and **secondarySellerContactHours** objects and the days specified here should not overlap between the two. This type alos has an **anyTime** boolean and if the value of theat field is 'true', it means that the seller can be contacted at any time during the specified day(s).
"""
type ListingSellerContactHours {
  """
  This boolean field indicates whether or not the seller is available to be contacted 24 hours a day during the range of days specified.
  """
  anyTime: Boolean
  """
  This field is used to indicate the end time of support hours for the days specified through the **supportOnDays** field. Military time is used here and times will be on the hour or half hour (e.g. 9:00, 9:30, etc.). The **supportHoursStart** and **supportHoursEnd** fields are always used together and the **supportHoursStart** value should always be earlier than the **supportHoursEnd** value.
  """
  supportHoursEndAt: Time
  """
  This field is used to indicate the start time of support hours for the days specified through the **supportOnDays** field. Military time is used here and times will be on the hour or half hour (e.g. 9:00, 9:30, etc.). The **supportHoursStart** and **supportHoursEnd** fields are always used together and the **supportHoursStart** value should always be earlier than the **supportHoursEnd** value.
  """
  supportHoursStartAt: Time
  """
  This field indicates the block of days that the support hours will apply to.
  """
  supportOnDays: SellerSupportListingDaysCode
}

"""
This enumerated type contains the list of shipping cost models that can be used to ship eBay items.
"""
enum ListingShippingCostType {
  """
  This enumeration value indicates that the seller is using the calculated shipping model. With calculated shipping, the  cost of shipping will depend on the weight of the shipping package and the distance between the item location and the buyer's shipping address.
  """
  CALCULATED
  """
  This enumeration value indicates that a flat-rate shipping cost will be used for each domestic or international shipping service option. By using a domestic or international shipping rate table for a listing, the seller can charge different flat rates based on the buyer's location and shipping speed/class. For example, a seller with a warehouse in California could charge a flat rate of $10 to ship an item to Arizona, but a flat rate of $15 to ship an item to Texas.
  """
  FLAT
  """
  This enumeration value indicates that freight shipping will be used to ship the item. US sellers can use eBay freight shipping partner, **FreightQuote.com**, or another freight shipping provider. **FreightQuote.com** can only be used for domestic shipping within the US.
  """
  FREIGHT
  """
  This enumeration value indicates that a shipping cost model was not specified for the listing or is unknown.
  """
  NOT_SPECIFIED
}

"""
This type is used to identify continents, large geographical regions, countries, and special domestic locations where an item can and cannot be shipped to.
"""
input ListingShippingLocationInput {
  """
  This field is used to identify a continent using a predefined set of continent codes. See the [`ContinentCode`] enum type for the full list of supported continent codes.
  """
  continent: ContinentCode
  """
  This field is used to identify a country using the **ISO 3166-1 alpha-2** country code standard. See the [`CountryAlpha2Code`] enum type for the full list of supported country codes.
  """
  country: CountryAlpha2Code
  """
  This field is used to identify a large geographical region that is not country or continent, or to identify a special domestic location within a country (e.g. PO_BOX). See the [`SellerShippingRegionCode`] enum for the full list of supported region codes.
  """
  sellerShippingRegion: SellerShippingRegionCode
}

"""
This type represents the shipping service available for a listing and includes key details such as the service code, display name, estimated delivery time range, and whether the service offers expedited delivery.
**Note:** Delivery estimates are approximate and may vary based on item weight, origin, and destination.
"""
type ListingShippingService {
  """
  The shipping service code available for the listing.
  **Example**: 'USPS_PRIORITY123'.
  """
  shippingServiceCode: String!
  """
  The human-readable display name of this shipping service (e.g. 'USPS Priority Mail').
  **Format**: Alphanumeric string with spaces allowed
  **Maximum length**: 50 characters
  """
  displayName: String
  """
  This boolean indicates if the shipping service is considered an expedited service. An expedited service can deliver the item to a buyer's location within 1-2 business days. If 'true', this shipping service is considered an expedited service. If 'false', the shipping service is not considered an expedited service.
  **Note**: If null, the expedited status is unknown.
  """
  expeditedService: Boolean
  """
  The maximum estimated time in hours for the delivery to be completed for this service.
  **Note**: If null, maximum estimated delivery time is not provided by the carrier for this service.
  """
  maxEstimatedDeliveryTimeHours: Int
  """
  The minimum estimated time in hours for the delivery to be completed for this service.
  **Note**: If null, minimum estimated delivery time is not provided by the carrier for this service.
  """
  minEstimatedDeliveryTimeHours: Int
}

"""
This enumerated type consists of the shipping cost models that can be used to ship items domestically and internationally.
"""
enum ListingShippingType {
  """
  This enumeration value specifies/indicates that total shipping cost for each domestic or international shipping service will be calculated based on the distance between the item location and the buyer's location plus the weight of the shipping package.
  """
  CALCULATED
  """
  This enumeration value specifies/indicates that a flat-rate shipping cost will be used for each domestic or international shipment. However, with the use of a domestic or international shipping rate table that can applied to a listing, the seller can charged different flat rates based on the buyer's location. For example, a seller with a warehouse in California could charge a flat rate of $10 to ship an item to Arizona, but a flat rate of $15 to ship an item to Texas.
  """
  FLAT
  """
  This enumeration value indicates that freight shipping will be used for the item.
  """
  FREIGHT
  """
  This enumeration value specifies/indicates that a shipping cost model was not specified for the listing.
  """
  NOT_SPECIFIED
}

"""
This enumerated type contains the values that indicate the current status of a listing.
"""
enum ListingStatusEnum {
  """This enumeration value indicates that the listing is currently active."""
  ACTIVE
  """This enumeration value indicates that the listing has ended."""
  ENDED
  """
  This enumeration value indicates that the listing is scheduled to become active at a future date.
  """
  SCHEDULED
}

"""This type defines the priceline roll up for listing sub total."""
type ListingSubtotal implements PriceLineRollup {
  """
  The monetary amount of the priceline rollup. This is the monetary value associated with the priceline item group.
  """
  amount: AmountSet!
  """
  The human-readable name of the priceline roll up. 
  **Note**: In this context, the name will always be returned as 'LISTING_SUBTOTAL'.
  """
  name: String!
  """This array returns the pricelines that are part of the rollup."""
  priceLines: [PriceLine!]!
}

"""
This type is used to show the details of an active listing that is retrieved with the **sellerListings** query.
"""
type ListingSuccess {
  """
  Provides listing details. `listing` will be null when the listingId is invalid or
  the listing is not available in the system for a given listingId.
  """
  listing: ListingV2
  """
  Returns the listingId provided in the input which is used for the correlation
  """
  listingId: ID!
}

"""
This type is used to provide listing terms details for the listing, including listing format, listing duration, item location, return policy, fulfillment terms, and more.
"""
type ListingTerms {
  """
  This object is applicable to classified ad listings, and provides contact information for the seller, including days and hours when the seller accepts inquiries from potential buyers.
  """
  adsSellerContact: ListingSellerContact
  """
  This object will indicate if the listing accepts Best Offers from buyers, and will also show the 'auto accept' and/or 'auto decline' price thresholds if the seller has set these thresholds.
  """
  bestOfferTerms: BestOfferTerms
  """
  This object indicates whether or not a seller is blocking/disabling account-level buyer restrictions and/or has set a quantity limit per buyer threshold for a multiple-quantity, fixed price listing.
  """
  buyerRestrictions: BuyerRestrictions
  """
  This object is returned if the seller is donating a set percentage of each sale on the listing to a non-profit organization that is registered to receive donations on eBay's platform. The unique identifier of the charitable organization and the donation percentage is shown in this object. Note that eBay for Charity is only supported on the US, UK, DE, and CA marketplaces.
  """
  charity: Charity
  """
  This object shows any global and/or marketplace-specific product compliance and/or takeback policies applicable for the listing.
  """
  customPolicies: CustomPolicies
  """
  This object provides details on how the item will be delivered to the buyer. The data in this object includes available shipping services, ship-to and excluded shipping locations, shipping costs, package details, and more.
  """
  fulfillmentTerms: FulfillmentTermsPolicy @deprecated(reason: "use listingFulfillmentTerms")
  """
  This boolean field indicates whether or not the listing is private. With private listings, the eBay user and feedback scores for bidders and buyers are obfuscated to everyone except for the seller.
  """
  hideParticipation: Boolean
  """
  This array indicates if the seller is actively listing the item on another eBay marketplace for an additional fee. Currently, this feature can only be used on the US, Canada, UK, and Ireland marketplaces. Sellers listing on the US and Canada marketplaces can choose to also expose a listing on the UK and IE marketplaces and sellers listing on the UK and IE marketplaces can choose to also expose a listing on the US and CA marketplaces. This list will be empty if the seller has not chosen to actively display their listings on other eBay marketplaces.
  """
  internationalSiteVisibility: [CrossBorderTradingRegion!]
  """
  This object indicates where the item is physically located. Item location is mandatory as it allows eBay to calculated estimated shipping costs and also to provide an estimated delivery time window to buyers.
  """
  itemLocation: ItemLocation
  """
  This object shows the duration of the listing, and will also show a timestamp indicating when in the future a scheduled listing will become active.
  """
  lifecycleTerms: ListingLifecycle
  """
  The enumeration value in this mandatory field indicates the format of the listing such as auction or fixed price listing. required field sets the listing format. See [ListingFormatTypeMock] for supported enumeration values.
  """
  listingFormat: ListingFormatType
  """
  This object provides fulfillment terms for a listing, including shipping cost model, available shipping services, shipping costs, handling time, combined shipping rules, and excluded shipping locations.
  """
  listingFulfillmentTerms: FulfillmentTerms
  """
  This object provides payment terms for a listing, including immediate payment requirement, accepted offline payment methods, and motor vehicle deposit details.
  """
  listingPaymentTerms: PaymentTerms
  """
  This object provides return terms for a listing, including return period, refund method, and return shipping cost payer etc.
  """
  listingReturnTerms: ReturnTerms
  """
  This object is applicable if the seller is selling a motor vehicle through a Motors Local Listing. The integer value in this object is the radius of the area in which the vehicle will be available and exposed to interested local buyers. The specified item location will be used as the center point for this radius.
  """
  localListingDistance: ListingDistance
  """
  The integer value in this field indicates how many distinct items are in a lot-based listing. A lot-based listing is a listing with a set of two or more similar/related items that will be sold together as one line item. An example of a lot listing might be a collection of children's clothes.
  """
  lotSize: Int
  """
  This object provides various payment terms and information for the listing, including immediate payment requirement, offline payment methods, and motor vehicle deposit information.
  """
  paymentTerms: PaymentTermsPolicy @deprecated(reason: "use listingPaymentTerms")
  """
  This array is return to indicate any special programs associated with the listing. Currently, the only supported value is `EBAY_PLUS`. eBay Plus is a premium account option for buyers, which provides benefits such as fast and free domestic shipping, and free returns on selected items. eBay will evaluate/determine whether a listing is eligible for eBay Plus.
  """
  programsSupported: [String!]
  """
  This object shows the various types of regulatory information that is applicable to the listing, including energy efficiency labels, hazardous material information, product safety information, and more. Based on the listing category, sellers doing business in an EU country or Northern Ireland may be legally required to provide some of this regulatory information for listings.
  """
  regulatory: RegulatoryInfo
  """
  This object provides a domestic return policy and an international return policy (if the seller ships internationally) that is used for the listing.
  """
  returnTerms: ReturnTermsPolicy @deprecated(reason: "use listingReturnTerms")
  """
  This field is used by the seller to provide custom, application-specific data associated with the listing. The string specified here is stored by eBay with the listing but it is not used by eBay in any way other than that.
  """
  sellerCustomData: String
  """
  This object provides various tax information, including VAT rates, sales tax rates to US territories and Canadian provinces, and special tax category codes.
  """
  taxTerms: TaxInfo
  """
  This integer value shows the total quantity of the item available through the listing.
  """
  totalQuantityAvailable: Int
  """
  This object shows listing upgrades that have been enabled for the listing such as bold titles in search results, Gallery Plus, or an added subtitle.
  """
  visualEnhancements: ListingVisualEnhancements
}

"""
This enumeration type contains the supported handling times for shipping items. The specified handling time in a listing indicates how quickly the seller will physically ship out the item.
"""
enum ListingTimeDuration {
  """
  This enumeration value is used to indicate that the handling time is zero days, which means the seller supports same-day shipping for the item.
  With same-day shipping, the seller commits to shipping out the item on the same business day that the order is placed, as long as the payment clears before the seller's cutoff time for the day.
  """
  DAYS_0
  """
  This enumeration value indicates that the time duration is one day. This value is commonly used for a 1-day handling time.
  """
  DAYS_1
  """
  This enumeration value indicates that the time duration is 10 days. This value can be used for the payment deadline for a motor vehicle balance.
  """
  DAYS_10
  """
  This enumeration value indicates that the time duration is 10 days. This value can be used for the payment deadline for a motor vehicle balance.
  """
  DAYS_14
  """This enumeration value indicates that the time duration is 15 days."""
  DAYS_15
  """
  This enumeration value indicates that the time duration is two days. This value is commonly used for a 2-day handling time.
  """
  DAYS_2
  """This enumeration value indicates that the time duration is 20 days."""
  DAYS_20
  """This enumeration value indicates that the time duration is 25 days."""
  DAYS_25
  """
  This enumeration value indicates that the time duration is three days. This value can be used for a 3-day handling time or for the payment deadline for a motor vehicle balance.
  """
  DAYS_3
  """
  This enumeration value indicates that the time duration is 30 days. This value can be used as a return period.
  """
  DAYS_30
  """This enumeration value indicates that the time duration is four days."""
  DAYS_4
  """This enumeration value indicates that the time duration is 40 days."""
  DAYS_40
  """This enumeration value indicates that the time duration is five days."""
  DAYS_5
  """This enumeration value indicates that the time duration is six days."""
  DAYS_6
  """
  This enumeration value indicates that the time duration is 60 days. This value can be used as a return period.
  """
  DAYS_60
  """
  This enumeration value indicates that the time duration is seven days. This value can be used for the payment deadline for a motor vehicle balance.
  """
  DAYS_7
  """This enumeration value indicates that the time duration is 1 month."""
  MONTHS_1
  """
  This value should not be used as input, but it is possible that it can be returned if the time duration value could not be determined.
  """
  NOT_SPECIFIED
}

"""
Extend ListingV2 to add dealItem boolean field from this application.
@key indicates that ListingV2 can be uniquely identified via listingId
"""
interface ListingV2 {
  """
  An array of one or more purchasable items. A single-variation listing will only have one item object, while a multiple-variation listing will have numerous item objects. Each item object will have price, quantity, and global product identifiers if applicable. Item objects within multiple-variation listings will show unique traits that differentiate them from the rest of the variations within the listing.
  """
  items: [Item!]!
  """listingId is key to ListingV2 and it needs to be included here"""
  listingId: ID!
  """Seller-scoped Unanswered questions count for the listing"""
  unansweredQuestions: UnansweredQuestions
  """
  This container provides key listing term details for the listing, including listing format, listing duration, payment terms, return policy, fulfillment terms, and more.
  """
  listingTerms: ListingTerms
  """The unique identifier of the eBay listing marketplace."""
  marketplace: ListingMarketplace
  """
  This container provides key information about the listing and product, and includes listing title, listing description, listing category, images, aspects, and other information.
  """
  sellerProduct: SellerProduct
}

"""
This interface is used to display information about operation validation errors when these errors are triggered.
"""
interface ListingValidationRuleViolation {
  """
  This array will show a list of one or more key-value pairs providing additional, structured context for the violation. For example, for a maximum length exceeded violation, this might contain {name: "maxLength", value: "80"}. Null values in a name-value pair indicates that no additional information is available on the violation.
  """
  additionalInformation: [NameValuePair!]
  """
  This array will show one or more string values that show the full path(s) to the input field(s) that caused the violation. 
  """
  inputPath: [String!]!
  """
  A unique identifier of the violation. Clients can use this code to implement custom logic. 
  """
  violationCode: String!
  """
  A human-readable description of the violation, intended to be displayed to an end user.
  """
  violationDescription: String!
}

"""
This type is used to display information about operation warnings when these warnings are triggered. With warnings, the operation will be successful or partially successfully, but there are issues that the user should be aware of and may need to address these issues at a later time.
"""
type ListingValidationWarning implements ListingWarning {
  """
  This array will show a list of one or more key-value pairs providing additional, structured context for the warning. Null values in a name-value pair indicates that no additional information is available on the warning.
  """
  additionalInformation: [NameValuePair!]
  """
  This array will show one or more string values that show the full path(s) to the input field(s) that caused the warning. 
  """
  inputPath: [String!]!
  """
  A unique identifier of the warning. Clients can use this code to implement custom logic. 
  """
  warningCode: String!
  """
  A human-readable description of the warning, intended to be displayed to an end user.
  """
  warningMessage: String!
}

"""
This type is used to identify the main trait by which SKUs within a multiple-variation listing differ, and to provide image URLs demonstrating the variations of this trait for each item variation.
"""
type ListingVariationImagesVaryByTrait {
  """
  The trait name by which pictures of the item variations vary. The specified trait will be used to determine which images to display when a buyer selects a variation in the View Item page. For example, if the trait is 'Color', then a corresonding product image in the **traitValueImages** array will be displayed when that color is selected in the View Item page. The trait name specified here must be one of the variation traits specified in the **variationTraits** array.
  """
  traitName: String
  """
  This array contains a list of one or more image URLs for each available value of the trait. So, if the trait is 'Color', each of the available colors would be specified through the **traitValue** field, and then each color would have at least one image URL specified through the **traitImages** array.
  """
  traitValueImages: [ListingVariationTraitImage!]
}

"""
This type is used to express the traits where each SKU within a multiple-variation listing differs, such as 'Color' and 'Size'. Each available color and each available size will be listed through the **variationTraits** array. If the listing featured t-shirts, each variation within that listing would have a unique color and zize combination such as 'Blue, Large'.
"""
type ListingVariations {
  """
  This object identifies the main trait by which variations differ, and provides image URLs demonstrating the variations of this trait for each variation. For example, the varying trait may be 'Color', and image URLs would be provided showcasing the different color of each variation.
  """
  imagesVaryByTrait: ListingVariationImagesVaryByTrait
  """
  This array shows the names of the varying traits and the available values for each of these traits. For example, one trait might be 'Color', and all of the available colors would be specified in the corresponding **values** array. Another trait might be 'Size', and all of the available sizes would be specified in the corresponding **values** array. If the multiple-variation listing has two varying traits such as 'Color' and 'Size', each variation would have a different combination of each of these traits, such as a 'Large, Red' shirt.
  """
  variationTraits: [NameValuesPair!]
}

"""
This type is used to provide an array of one or more image URLs for each available value of the trait. So, if the trait is 'Color', each of the available colors would be specified through the **traitValue** field, and then each color would have at least one image URL specified through the **traitImages** array.
"""
type ListingVariationTraitImage {
  """
  An array of one or more images that demonstrate the corresponding **traitValue**. For example, if the **traitName** is 'Color' and the **traitValue** is 'Red', the image(s) would show a red variation of the product. Depending on the product, one image per variation may be enough, but multiple images may be specified for each **traitValue**. For example, it is possible that a seller would want to show the front and back of each shirt in each color.
  """
  traitImages: [ListingImage!]
  """
  The trait value of the corresponding image(s) in the **traitImages** array. If the **traitName** is 'Color', values in this field may include Red, Blue, Green, etc. At least one of the variations within the multiple-variation listing must have this value.
  """
  traitValue: String
}

"""
This type is used to indicate listing upgrades enabled by the seller such as bold titles in search results, Gallery Plus, or an added subtitle.
"""
type ListingVisualEnhancements {
  """
  This boolean field indicates whether or not the seller is useing boldface type for the listing title. If returned as 'true', the listing title will appear in boldtype in search results for greater visibility. This feature cannot be enabled for a motor vehicle listing.
  **Default**: false
  """
  boldTitle: Boolean
  """
  This boolean field indicates whether or not the seller using the Gallery Plus feature for the listing. With Gallery Plus, a larger gallery image of the item is displayed in search results. This feature cannot be enabled for a motor vehicle listing.
  **Default**: false
  """
  galleryPlus: Boolean
  """
  This field will be returned if the seller has included a customized subtitle for the listing. The text of that subtitle will appear in this field if set. 
  """
  subtitle: String
}

"""
This interface is used to display information about operation warnings when these warnings are triggered. With warnings, the operation will be successful or partially successfully, but there are issues that the user should be aware of and may need to address these issues at a later time.
"""
interface ListingWarning {
  """
  This array will show a list of one or more key-value pairs providing additional, structured context for the warning. Null values in a name-value pair indicates that no additional information is available on the warning.
  """
  additionalInformation: [NameValuePair!]
  """
  A unique identifier of the warning. Clients can use this code to implement custom logic. 
  """
  warningCode: String!
  """
  A human-readable description of the warning, intended to be displayed to an end user.
  """
  warningMessage: String!
}

"""
This type is used to show the estimated fulfillment windows. Estimated delivery times consider the seller's stated handling time plus the expected transit time range of the shipping service.
**Note**: Sellers generally do not ship items until the buyer's payment has cleared, so the estimated fulfillment windows should really only be considered after payment has been made by the buyer.
"""
type LogisticsFulfillmentEstimate {
  """
  This timestamp shows the earliest estimated date and time by which fulfillment is expected to be completed. 
  """
  earliestFulfillmentAt: DateTime
  """
  This timestamp shows the latest estimated date and time by which fulfillment is expected to be completed. 
  """
  latestFulfillmentAt: DateTime
  """
  The integer value in this field indicates the maximum amount of business days after the buyer's payment clears that the buyer can expect to receive the item. 
  """
  maxFulfillmentDays: Int
  """
  The integer value in this field indicates the minimum amount of business days after the buyer's payment clears that the buyer can expect to receive the item. 
  """
  minFulfillmentDays: Int
}

"""
This type provides details on the selected fulfillment plan that is either in progress or completed. It includes the fulfillment type, current state, and the steps involved in fulfilling the delivery of the item.
"""
type LogisticsFulfillmentExecution {
  """
  This container conveys the current state of the fulfillment plan. The details shown here will vary based on the current state.
  """
  fulfillmentState: LogisticsFulfillmentState!
  """
  This array shows the sequence of logistics steps required to complete fulfillment. Some fulfillment plans involve multiple steps, but others involve only one step.
  """
  logisticsExecutionSteps: [LogisticsStep!]
  """
  The identifier displayed here will indicate the type of fufillment plan being used. Below are some possible values that can be returned here:
  - SHIPPING: standard domestic or international shipping.
  - INTERMEDIATED_SHIPPING: shipping that involves multiple shipping legs, with eBay or an eBay partner taking care of at least one of those shipping legs. Examples of this include Global Shipping Program, eBay International Shipping, eBay Vault, and Authenticity Guarantee. 
  - STORE_PICKUP: buyer picks up item at local store for a 'Buy online, pick up in store' (BOPIS) or 'Click and Collect' order.  
  - PICKUP: local pickup.
  - DIGITAL_DELIVERY: digital delivery of an item, such as a gift card.
  """
  planType: ID!
}

"""
This type provides details on an available fulfillment plan or selected fulfillment plan that has yet to be started. It includes the fulfillment type and the steps involved in fulfilling the delivery of the item.
"""
type LogisticsFulfillmentPlan {
  """
  This array shows the sequence of logistics steps required to complete fulfillment. Some fulfillment plans involve multiple steps, but others involve only one step.
  """
  logisticsPlanSteps: [LogisticsStep!]
  """
  The identifier displayed here will indicate the type of fufillment plan available to be used or selected to be used. Below are some possible values that can be returned here:
  - SHIPPING: standard domestic or international shipping.
  - INTERMEDIATED_SHIPPING: shipping that involves multiple shipping legs, with eBay or an eBay partner taking care of at least one of those shipping legs. Examples of this include Global Shipping Program, eBay International Shipping, eBay Vault, and Authenticity Guarantee. 
  - STORE_PICKUP: buyer picks up item at local store for a 'Buy online, pick up in store' (BOPIS) or 'Click and Collect' order.  
  - PICKUP: local pickup.
  - DIGITAL_DELIVERY: digital delivery of an item, such as a gift card.
  """
  planType: ID!
}

"""
This union type represents the current fulfillment status of a logistics operation.
"""
union LogisticsFulfillmentState = FulfillmentCompleted | FulfillmentInProgress | FulfillmentNotStarted | FulfillmentPartiallyStarted

"""
This enumerated type provides different cost or fulfillment calculation methods for a shipping option. 
"""
enum LogisticsOptionType {
  """ Shipping cost is calculated based on item weight, dimensions, and destination. 
  """
  CALCULATED
  """
  Shipping cost is a fixed amount set by the seller and does note vary by weight, dimensions, or destination (within the defined coverage for the option).
  """
  FLAT
  """
  Shipping requires freight services due to item size, weight, or special handling. This typically applies to large or heavy items and may involve carrier scheduling.
  """
  FREIGHT
  """
  Shipping type represents local pickup or an unspecified shipping calculation method, and is retained for backward compatibility with legacy systems that use `NOT_SPECIFIED` to indicate local pickup.
  """
  NOT_SPECIFIED
}

"""
This interface is used by types that convey a logistics point involved in a fulfillment plan. Fulfillment plan types include shipping, local and store pickup, and digital delivery.
"""
interface LogisticsPoint {
  """
  The physical address associated with this logistics point.
  **Note**: This container may not be returned for some logistics points.
  """
  address: PurchaseAddress
  """
  The display name of the point (for example, 'San Jose Warehouse', 'Customer Home')
  """
  name: String!
  """
  The functional role of the point in the logistics flow (for example, 'WAREHOUSE', 'CUSTOMS', 'DESTINATION')
  """
  type: DisplayableId!
}

"""
This interface is used by types that convey logistics steps involved in a fulfillment plan. Fulfillment plan types include shipping, local and store pickup, and digital delivery.
"""
interface LogisticsStep {
  """
  This container shows the user-friendly description and unique identifier of the party responsible for handling this logistics step.
  """
  handler: DisplayableId
  """
  This container shows the user-friendly description and unique identifier of the logistics step, for example, `Standard Shipping`.
  """
  methodName: DisplayableId!
}

"""
The base request type for the **makeOffer** mutation. This type is used to define the input information needed to create a buyer-initiated offer for an item. This includes the item ID of the item the buyer wishes to make an offer for, as well as the price and quantity of the item. An optional message can also be attached to the offer to help explain or justify it.
"""
input MakeOfferInput {
  """
  The unique identifier of the purchasable item in a single-SKU or multiple-SKU listing for which the offer is being made. This item must support offer negotiations and be available for purchase.
  """
  itemId: ID!
  """
  An optional message that can be used to explain or justify the offer. This message will be visible to the seller and can help provide context for the proposed price or terms.
  **Maximum length**: 250 characters
  """
  message: String
  """
  The price being offered for the item. This value must be greater than zero and in the item's listing currency.
  **Note**: If the **quantity** of the item is greater than '1', this value represents the price of one unit, not the entire order.
  """
  proposedPrice: AmountInput!
  """
  The number of items being requested in this offer. This value can not exceed the available quantity of the listing.
  **Default**: 1
  """
  quantity: Int = 1
}

"""
The union type for the **makeOffer** mutation. This type covers two possible scenarios: success or failure. If the **makeOffer** mutation succeeds, the offer will be created and information about the newly-created offer will be returned. If the **makeOffer** mutation fails, an array of blocking errors detailing why the mutation failed will be returned, and the offer will not be created. If a mutation fails, there will always be at least one blocking error.
"""
union MakeOfferOutput = MakeOfferSent | OfferBusinessRulesViolated | ReferenceArgumentsNotFound

"""
This type is used for a successful **makeOffer** mutation. On success, details about the newly created offer are returned, such as the offer ID, status, and expiration date.
"""
type MakeOfferSent {
  """
  This container returns details about the offer created using the **makeOffer** mutation. This information includes the offer ID, status, and expiration date of the newly created offer.
  """
  offer: NegotiationOfferDetails!
}

"""
This type provides the name and contact information for the manufacturer of the item. As a part of General Product Safety Regulation (GPSR) requirements, sellers operating in, or shipping to EU-based countries or Northern Ireland are conditionally required to provide product manufacturer information in their eBay listings.
"""
type Manufacturer {
  """
  The street address for the product manufacturer is provided in this container.
  """
  address: BusinessEntityAddress
  """The name of the company that manufactured the product."""
  companyName: String
  """
  This container is used to provide the phone number, email address, and/or the Contact/Support page URL for the product manufacturer.
  At least one of the three is required if manufacturer information is supplied.
  """
  contact: BusinessEntityContact
}

"""
The values in this enumerated type indicate the listing marketplace associated with the order.
"""
enum Marketplace {
  """This value indicates that the listing marketplace is eBay Austria. """
  EBAY_AT
  """This value indicates that the listing marketplace is eBay Australia. """
  EBAY_AU
  """
  This value indicates that the listing marketplace is the English language version of eBay Canada marketplace. 
  """
  EBAY_CA
  """
  This value indicates that the listing marketplace is eBay Switzerland. 
  """
  EBAY_CH
  """This value indicates that the listing marketplace is eBay Germany. """
  EBAY_DE
  """This value indicates that the listing marketplace is eBay Spain. """
  EBAY_ES
  """This value indicates that the listing marketplace is eBay France. """
  EBAY_FR
  """This value indicates that the listing marketplace is eBay UK. """
  EBAY_GB
  """This value indicates that the listing marketplace is eBay Hong Kong. """
  EBAY_HK
  """This value indicates that the listing marketplace is eBay Ireland. """
  EBAY_IE
  """This value indicates that the listing marketplace is eBay Italy. """
  EBAY_IT
  """This value indicates that the listing marketplace is eBay Malaysia. """
  EBAY_MY
  """
  This value indicates that the listing marketplace is eBay Netherlands. 
  """
  EBAY_NL
  """
  This value indicates that the listing marketplace is eBay Philippines. 
  """
  EBAY_PH
  """This value indicates that the listing marketplace is eBay Poland. """
  EBAY_PL
  """This value indicates that the listing marketplace is eBay Singapore. """
  EBAY_SG
  """This value indicates that the listing marketplace is eBay US. """
  EBAY_US
}

"""
This output type is used when a **markItemCommitmentsPaid** mutation fails completely, and none of the specified item commitments are marked as paid. The **failures** array will show the identifiers of the item commitments that failed to be marked as paid, and the error fields will provide more details on the issue(s) that caused the mutation to fail.
"""
type MarkItemCommitmentsPaidCompleteFailure implements BusinessError {
  """
  The unique identifier of the error. 
  **Note**: Currently this field will always show MARK_ITEM_COMMITMENTS_PAID_COMPLETE_FAILURE.
  """
  errorCode: String!
  """
  The developer-friendly description of the error is shown in this field.
  """
  errorMessage: String!
  """
  This array shows the full list of item commitments that failed to be marked as paid.
  """
  failures: [UpdateItemCommitmentError!]!
}

"""
This is the base input type for the **markItemCommitmentsPaid** mutation. This mutation allows a seller to mark up to 100 item commitments as paid.
"""
input MarkItemCommitmentsPaidInput {
  """
  This array is used to specify up to 100 item commitment IDs to be marked as paid. Each item commitment ID is delimited with a comma.
  **Max items**: 100
  """
  itemCommitmentIds: [ID!]!
}

"""
This union type is used to represent the possible outcomes of the **markItemCommitmentsPaid** mutation.
"""
union MarkItemCommitmentsPaidOutput = MarkItemCommitmentsPaidCompleteFailure | MarkItemCommitmentsPaidPartialFailure | MarkItemCommitmentsPaidSuccess

"""
This output type is used when a **markItemCommitmentsPaid** mutation is partially successful, where one or more specified item commitments were successfully marked as paid, but one or more other item commitments failed to be marked as paid. The **markPaidItemCommitments** array will display all item commitments that were successfully marked as paid, the **failures** array will show the identifiers of the item commitments that failed to be marked as paid, and the error fields will provide more details on the issue(s) that caused the mutation to only be partially successful.
"""
type MarkItemCommitmentsPaidPartialFailure implements BusinessError {
  """
  The unique identifier of the error. 
  **Note**: Currently this field will always show MARK_ITEM_COMMITMENTS_PAID_PARTIAL_FAILURE.
  """
  errorCode: String!
  """
  The developer-friendly description of the error is shown in this field.
  """
  errorMessage: String!
  """
  This array shows the full list of item commitments that failed to be marked as paid.
  """
  failures: [UpdateItemCommitmentError!]!
  """
  This array shows the full list of item commitments that were successfully marked as paid.
  """
  markPaidItemCommitments: [ItemCommitment!]!
}

"""
This output type is used when a **markItemCommitmentsPaid** mutation when all specified item commitments were successfully marked as paid, and displays detailed information on each of the paid item commitments. 
"""
type MarkItemCommitmentsPaidSuccess {
  """
  This array shows the full list of item commitments that were successfully marked as paid.
  """
  markPaidItemCommitments: [ItemCommitment!]!
}

"""
This type represents a complete failure for a **markOrdersPaid** mutation. The response includes the orders that could not be marked as paid as specified in the request.

**Note:** No orders were successfully marked as paid.
"""
type MarkOrdersPaidCompleteFailure implements BusinessError {
  """
  The machine-readable error code for this business error. Value: `MARK_ORDERS_PAID_COMPLETE_FAILURE`.
  """
  errorCode: String!
  """
  A human-readable description of the error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  This array lists one or more orders that could not be updated.
    
  **Note:** This list is never empty.
  """
  failures: [UpdateOrderError!]!
}

"""
This base request type for the **markOrdersPaid** mutation that manually marks that payment has been received for an order by an authorized user.
"""
input MarkOrdersPaidInput {
  """
  Unique ID of the orders which need to be marked as paid.
  Caution: the operation cannot be undone.
  """
  orderIds: [ID!]!
}

"""
This base response union type for the **markOrdersPaid** mutation indicates whether all, some, or none of the submitted orders were marked as paid, and returns order outcome specific order data.
"""
union MarkOrdersPaidOutput = MarkOrdersPaidCompleteFailure | MarkOrdersPaidPartialFailure | MarkOrdersPaidSuccess

"""
This type represents a partial success for a **markOrdersPaid** mutation. The response includes both the orders that were successfully marked as paid and those that failed to update.
"""
type MarkOrdersPaidPartialFailure implements BusinessError {
  """
  The machine-readable error code for this business error. Value: `MARK_ORDERS_PAID_PARTIAL_FAILURE`.
  """
  errorCode: String!
  """
  A human-readable description of the error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """A list of one or more orders that could not be updated."""
  failures: [UpdateOrderError!]!
  """A list of one or more orders successfully marked as paid."""
  markPaidOrders: [Order!]!
}

"""
This type indicates a successful **markOrdersPaid** mutation where all submitted orders were marked as paid and included in the return.
"""
type MarkOrdersPaidSuccess {
  """
  A list of one or more orders marked as paid. The list contains all submitted orders and is never empty.
  """
  markPaidOrders: [Order!]!
}

"""
This type indicates that the maximum number of video IDs allowed in the **videosByIds** query input has been exceeded. 
"""
type MaxVideoIdsAllowedExceeded {
  """
  The maximum number of video IDs allowed for a **videosByIds** query. The maximum number of video IDs currently allowed is 100.
  """
  maxAllowed: Int!
}

"""
This enumeration type lists the measurement system that can be used to measure weight and dimensions. The measurement system selected by the seller should be the measurement system that is used in the country of the marketplace.
"""
enum MeasurementSystem {
  """
  This enumeration value indicates that the English, or Imperial system will be used to measure weight and dimensions. This is typically used in the US, with pounds and ounces used for weight and feet and inches used for dimensions.
  """
  ENGLISH
  """
  This enumeration value indicates that the Metric system will be used to measure weight and dimensions. This is typically everywhere else in the world besides the US, with kilograms and grams used for weight and meters and centimeters used for dimensions.
  """
  METRIC
}

"""
This type indicates the item is returned because one or more parts of the item were missing. Displays as **Missing parts**.
"""
type MissingParts implements ReturnReason {
  """A machine-readable reason code: `MISSING_PARTS`"""
  code: String!
  """
  A human-readable description of the return reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type is used to show detailed information for planned and executed monetary transactions that occur between payer and payee.
"""
type MonetaryDetails {
  """This array shows the list of executed payment actions from the payee. """
  payeeExecution: PayeeMonetaryExecutionUnion!
  """
  This array shows the list of planned payment actions from the payee. These describe how the payee expectss to receive funds.
  """
  payeePlans: [MonetaryPlan!]!
  """This array shows the list of executed payment actions from the payer. """
  payerExecution: PayerMonetaryExecutionUnion!
  """
  This array shows the list of planned payment actions from the payer. These describe how the payer intends to send funds (for example, via card, wallet, or account).
  """
  payerPlans: [MonetaryPlan!]!
}

"""
This type is used to provide details on executed payment plan(s) and the payment(s) involved in those payment plan(s).
"""
type MonetaryExecution {
  """
  This array shows the original monetary plan(s) associated with this payment execution.
  **Note**: Can be null if the payment execution was not derived from a predefined plan.
  """
  executionOfPlans: [MonetaryPlan!]
  """
  This array lists one or more individual payments involved in this payment execution.
  """
  payments: [PaymentExecution!]!
  """
  The current state of the monetary execution, indicating progress or completion state of payments.
  """
  state: PaymentsState!
}

"""This type is used to indicate the paid state of a monetary execution."""
type MonetaryExecutionPaymentState implements Labeled {
  """The unique identifier of the payment state."""
  id: ID!
  """A human-readable label for the payment state."""
  label: String!
}

"""
This type provides details on a monetary payment plan, including scheduled payments and the overall plan state.
"""
type MonetaryPlan {
  """
  This array shows the list of individual payment entries that make up the plan.
  """
  payments: [PaymentPlan!]!
  """
  This container shows the current state of the monetary plan (for example, `ACTIVE` or `CANCELLED`).
  """
  state: MonetaryPlanState!
}

"""
This type is used to show that the monetary plan is active and can be executed or has already been executed.
"""
type MonetaryPlanActive implements Labeled {
  """The human-readable label representing this state."""
  label: String!
}

"""
This type is used to show that the monetary plan has been cancelled and will not be executed.
"""
type MonetaryPlanCancelled implements Labeled {
  """The human-readable label representing this state."""
  label: String!
}

"""This union type is used to show the current state of a monetary plan."""
union MonetaryPlanState = MonetaryPlanActive | MonetaryPlanCancelled

"""
This type provides details when a buyer adds additional services to their motor vehicle purchase, such as financing or insurance. 
"""
type MotorPurchaseAddOnService {
  """
  The identifier returned in this field indicates the latest step completed by the buyer in relationship to the service being provided. In no particular order, possible values include:
  - finance_completed
  - finance_done
  - finance_failed
  - finance_submitted
  - identity_done
  - identity_failed
  - identity_started
  - identity_success
  - identity_updated_address_completed
  - insurance_completed
  - insurance_done
  - payment_done
  - payment_start
  - protection_done
  - signature_done
  - signature_gov_id_failed
  - signature_gov_id_started
  - signature_gov_id_success
  - signature_start
  - signature_started
  - transport_done
  - verification_completed
  - verification_done
  """
  buyerStep: ID
  """
  The unique identifier of the facilitator managing the service, such as 'EBAY'.
  """
  facilitator: ID!
  """The unique identifier of the service, used for cross-system tracking."""
  facilitatorReferenceID: ID!
  """
  The identifier returned in this field indicates the latest step completed by the seller in relationship to the service being provided. In no particular order, possible values include:
  - identity_address_submitted
  - identity_done
  - identity_failed
  - identity_started
  - identity_success
  - payment_done
  - payment_start
  - signature_done
  - signature_start
  - signature_started
  - title_docs_submitted
  - title_done
  - title_lender_lessor_submitted
  """
  sellerStep: ID
  """
  The cost of the additional service. This container is returned if there is a cost associated with service.
  """
  serviceCost: AmountSet
  """The current overall state of the motor purchase additional service."""
  state: MotorPurchaseState!
}

"""
This type provides details on the state of a motor purchase additional service.
"""
type MotorPurchaseState {
  """
  A human-readable string representing the current state of the motor purchase additional service. Examples include `In Progress`, `Purchase Completed`, `Cancelled`.
  """
  displayString: String!
  """
  The unique identifier of the motor purchase additional service. Possible values include `ACTIVE`, `COMPLETED`, `CANCELLED`.
  """
  id: ID!
}

"""
This type is used when the seller requires a deposit to secure the purchase of a motor vehicle. The settings under this container
include the amount of the deposit, when the deposit is due, and when the full payment of the motor vehicle is due.
"""
type MotorVehicleDeposit {
  """
  This field is used to set the due date (in days) for the buyer to pay off the full balance of the motor vehicle. The clock starts on the full payment due date as soon as the buyer commits to buying the vehicle by clicking the 'Buy It Now' button, by winning the auction, or by the seller accepting that buyer's Best Offer/counteroffer. The three supported values here are `DAYS_3` `DAYS_7`, `DAYS_10`, `DAYS_14`.
  **Default**: DAYS_7
  """
  daysToMakeFullPayment: ListingTimeDuration
  """
  This boolean field is included and set to 'true' if the seller requires a deposit to secure the purchase of a motor vehicle.
  **Default**: false
  """
  depositRequired: Boolean
}

"""
This error type indicates that the request contains multiple line items that exceed the maximum allowed limit.
"""
type MultipleLineItemReturnNotSupportedError implements BusinessError {
  """
  A machine-readable error code: `RTRN_MULTIPLE_LINE_ITEM_NOT_SUPPORTED.`
  """
  errorCode: String!
  """
  The maximum number of line items allowed in a single request.
    
  **Note:** Currently, only one line item is allowed per request.
  """
  maxAllowed: Int!
}

"""
This error type indicates that only one refund term is allowed in the request.
"""
type MultipleRefundTermsNotAllowedError implements BusinessError {
  """
  A machine-readable error code: `RTRN_MULTIPLE_REFUND_TERMS_NOT_ALLOWED`
  """
  errorCode: String!
  """
  A human-readable error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """Maximum number of refund terms allowed for the request."""
  maxAllowed: Int!
  """Number of partial refund terms provided in the request."""
  providedCount: Int!
}

"""
This error type indicates that only one line-item refund withholding is allowed per request. A single request cannot include multiple withholdings for the same return line item.
"""
type MultipleRefundWithholdingsNotAllowedError implements BusinessError {
  """
  A machine-readable error code: `RTRN_MULTIPLE_REFUND_WITHHOLD_NOT_ALLOWED`
  """
  errorCode: String!
  """
  A human-readable error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  The maximum number of refund withholdings permitted in a single request.
  """
  maxAllowed: Int!
  """The number of refund withholdings included in the current request."""
  providedCount: Int!
}

"""This error type indicates that only one shipping label is supported."""
type MultipleReturnLabelsNotSupportedError implements BusinessError {
  """
  A machine-readable error code: `RTRN_MULTIPLE_SHIP_LABEL_NOT_SUPPORTED`
  """
  errorCode: String!
  """
  A human-readable error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
}

"""The root mutation type for eBay's GraphQL API."""
type Mutation {
  """
  This mutation is used to create an item commitment on a listing, where a buyer commits to purchase an item and pay for it at a later date. Commitments can only be made for supported items; items that require immediate payment cannot be purchased through this mutation. The item ID value must be specified to identify the listing for which an item commitment is being created. The mutation also requires the price and quantity of the item the buyer wishes to commit to purchase. This mutation is only supported for fixed-priced listings and auction listings with Buy it Now enabled. If the mutation succeeds, a new item commitment with a unique **itemCommitmentId** is created. If the mutation fails, an array of errors indicating why the item commitment could not be created is returned. 
  **SubgraphName**: Commitment
  
  ### HTTP Headers
  - **X-EBAY-C-MARKETPLACE-ID**: Determines the site/marketplace id associated with the purchase. Defaults to EBAY-US.
  
  **PossibleErrors**:
  | Code                                       | Message                                                          |
  |--------------------------------------------|------------------------------------------------------------------|
  | COMMT_BUSINESS_RULES_VIOLATED              | Business rule violations occurred while creating the commitment. |
  | REFERENCE_ARGUMENTS_NOT_FOUND              | The resources referenced by the input arguments were not found.  |
  """
  commitToPurchase(input: CommitToPurchaseInput!): CommitToPurchaseOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.commitment&eBayUser"])
  """
  The **approveContractCancellation** mutation approves a contract cancellation using an existing cancellation entity.
    
  **Note:** A contract entity captures the contract's terms and obligations. Approving a cancellation confirms termination as defined by that entity.
  """
  approveContractCancellation(input: ApproveContractCancellationInput!): ApproveContractCancellationOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.cancellation&eBayUser"])
  """
  The **createItemCommitmentCancellation** mutation creates a cancellation on an item commitment.
    
  **Note:** An item commitment is the agreement to reserve a specific item for a buyer, ensuring its availability for purchase. Cancelling an item commitment releases that reservation. If the seller opts to relist the item by setting **relistItem** to `true`, and the **PostPurchaseListingRelistTask** completes successfully, the item becomes available to other buyers.
  """
  createItemCommitmentCancellation(input: CreateItemCommitmentCancellationInput!): CreateItemCommitmentCancellationOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.cancellation&eBayUser"])
  """
  The **createOrderCancellation** mutation creates a cancellation on an order.
    
  **Note:** An order is a contract between a buyer and a seller, where the buyer agrees to purchase goods or services, and the seller agrees to provide them. The cancellation of an order involves terminating this contract, which may involve reversing any transactions or agreements made during the order process.
  """
  createOrderCancellation(input: CreateOrderCancellationInput!): CreateOrderCancellationOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.cancellation&eBayUser"])
  """
  The **createPurchaseQuoteCancellation** mutation creates a cancellation on a purchase quote for item commitments which are part of a **PurchaseQuote**. Cancelling a **PurchaseQuote** cancels all associated item commitments.
    
  **Note:** A purchase quote is an estimate provided by a seller to a buyer for goods or services, often used to negotiate terms before finalizing a purchase. Cancelling a **PurchaseQuote** withdraws the estimate and ends any negotiations based on its terms.
  """
  createPurchaseQuoteCancellation(input: CreatePurchaseQuoteCancellationInput!): CreatePurchaseQuoteCancellationOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.cancellation&eBayUser"])
  """
  The **declineContractCancellation** mutation declines a contract cancellation using an existing cancellation entity.
    
   **Note:** A contract entity captures the contract's terms and obligations. Declining a cancellation rejects termination as defined by that entity.
  """
  declineContractCancellation(input: DeclineContractCancellationInput!): DeclineContractCancellationOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.cancellation&eBayUser"])
  """
  This mutation allows a seller to add and/or delete up to five custom item commitment tags for up to 100 item commitments per operation.
  **Note**: This operation is not available to buyers.
  
  Execution Errors:
  | Code                  |  Message                                                                     |
  |-----------------------|------------------------------------------------------------------------------|
  | BAD_INPUT_VALUE       |  Input size is 0 or over the limit. Please provide valid input.              |
  | INTERNAL_SERVER_ERROR |  System failure.                                                             |
  """
  bulkUpdateItemCommitmentTags(input: BulkUpdateItemCommitmentTagsInput!): BulkUpdateItemCommitmentTagsOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.commitment"])
  """
  This mutation allows a seller to mark up to 100 item commitments as paid.
  **Note**: This action is irreversible.
  **Note**: This operation is not applicable to buyers.
  
  Execution Errors:
  | Code                  |  Message                                                                     |
  |-----------------------|------------------------------------------------------------------------------|
  | BAD_INPUT_VALUE       |  Input size is 0 or over the limit. Please provide valid input.              |
  | INTERNAL_SERVER_ERROR |  System failure.                                                             |
  """
  markItemCommitmentsPaid(input: MarkItemCommitmentsPaidInput!): MarkItemCommitmentsPaidOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.commitment"])
  """
  The **startListingPreviewsCreation** mutation initiates a process that leverages a seller’s provided external product data (maximum 10 products) and uses this data to create an eBay listing preview for each provided product. This asynchronous process can take some time to complete, which is partially dependent on the number of external products being processed. The **startListingPreviewsCreation** mutation includes details of the external products. The output of the mutation will include the status and ID of the task, and may include errors if there are any issues. Once the listing previews task is complete, the mutation response will also include the results of the listing preview.
  
  The startListingPreviewsCreation mutation initiates a process that creates eBay Listing Previews from a seller's external products. This process is asynchronous and can take some time to complete. The mutation takes an input that includes details of the external products. The output of the mutation includes the details of the listing previews creation task and any errors that occurred during the process. This mutation is useful for sellers who want to convert their external products into eBay Listing Previews. The field will only be null when there is a server error prior to starting the preview creation process.
  
  Possible Errors:
  | Code   | Domain                | Category    | Parameters             | Message                                                                                                   |
  |--------|-----------------------|-------------|------------------------|-----------------------------------------------------------------------------------------------------------|
  | 500000 | API_INVENTORY_MAPPING | REQUEST     |                        | Marketplace not supported. See documentation for supported marketplaces.                                  |
  | 500001 | API_INVENTORY_MAPPING | REQUEST     |                        | Request cannot be empty. Please provide valid input.                                                      |
  | 500002 | API_INVENTORY_MAPPING | APPLICATION |                        | Internal system error. Please try again later.                                                            |
  | 500004 | API_INVENTORY_MAPPING | REQUEST     | images                 | Invalid image URL. The URL must start with "https".                                                       |
  | 500006 | API_INVENTORY_MAPPING | REQUEST     | images                 | The provided URL is invalid or could not be resolved. Please check and provide a valid URL.               |
  | 500007 | API_INVENTORY_MAPPING | REQUEST     | title                  | Title exceeds maximum allowed length: 250.                                                                |
  | 500008 | API_INVENTORY_MAPPING | REQUEST     | productId              | Product ID is missing or has an invalid value. Check value and see documentation as necessary.            |
  | 500009 | API_INVENTORY_MAPPING | REQUEST     | productType            | Product type is missing or has an invalid value. See documentation for the supported GTIN types.          |
  | 500010 | API_INVENTORY_MAPPING | REQUEST     | images                 | Duplicate image URLs were found under the images array. Please remove duplicates.                         |
  | 500011 | API_INVENTORY_MAPPING | REQUEST     |                        | You must provide a title or at least one image URL under the images array.                               |
  | 500014 | API_INVENTORY_MAPPING | REQUEST     |                        | You have exceeded the maximum number of products allowed: 10.                                            |
  | 500015 | API_INVENTORY_MAPPING | REQUEST     |                        | All aspects.name fields must have corresponding values.                                                   |
  | 500016 | API_INVENTORY_MAPPING | REQUEST     |                        | All aspectValues arrays must have one or more corresponding values.                                       |
  | 500017 | API_INVENTORY_MAPPING | REQUEST     | aspects.name           | One or more duplicate aspect names were provided for the product. Please remove duplicates.               |
  | 500018 | API_INVENTORY_MAPPING | REQUEST     | images                 | One or more image URLs exceed the maximum length allowed: 250.                                            |
  | 500019 | API_INVENTORY_MAPPING | REQUEST     | aspects                | You have exceeded the maximum number of aspects allowed: 50.                                              |
  | 500020 | API_INVENTORY_MAPPING | REQUEST     | aspects.name           | One or more image aspect names exceed the maximum length allowed: 100.                                    |
  | 500021 | API_INVENTORY_MAPPING | REQUEST     | aspects.value          | One or more image aspect values exceed the maximum length allowed: 100.                                   |
  | 500022 | API_INVENTORY_MAPPING | REQUEST     | images                 | You have exceeded the maximum number of images allowed: 24.                                               |
  | 500023 | API_INVENTORY_MAPPING | REQUEST     | externalProductDetails | One or more identical products found. Please check and revise or remove duplicates and try again.         |
  """
  startListingPreviewsCreation(input: StartListingPreviewsCreationInput!): StartListingPreviewsCreationOutput @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.inventory.mapping&eBayUser"])
  """
  This mutation can be used to issue a full refund for an inquiry. This mutation is used by the responder (typically the seller or system) to issue a full refund in response to an open inquiry. 
  **Note:** This mutation is applicable to inquiries eligible for refund.
    
  **PossibleErrors**:
  | Code                                       | Message                                                                                            |
  |--------------------------------------------|----------------------------------------------------------------------------------------------------|
  | ORDER_INQUIRY_NOT_FOUND_ERROR              | The specified inquiry ID does not exist.                                                           |
  | ORDER_INQUIRY_ACTION_NOT_PERMITTED_ERROR   | The action is not permitted. This includes inquiry state restrictions and access permission issues.|
  | RFND_AUTHORIZATION_FAILED_ERROR            | Refund authorization failed. Please verify payment method and try again.                           |
  | RFND_BLOCKED_BY_PAYMENT_DISPUTE_ERROR      | Refund blocked due to an active payment dispute on this transaction.                               |
  | RFND_INSTRUMENT_DECLINED_ERROR             | The payment instrument was declined. Please use an alternative payment method.                     |
  | RFND_INSTRUMENT_INSUFFICIENT_FUNDS_ERROR   | Insufficient funds in the payment instrument to complete the refund.                               |
  | RFND_INSTRUMENT_INVALID_ERROR              | The payment instrument is invalid or no longer active.                                             |
  | RFND_PROCESSING_ERROR                      | An error occurred while processing the refund. Please try again later.                             |
  """
  processOrderInquiryRefund(input: ProcessOrderInquiryRefundInput!): ProcessOrderInquiryRefundOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.inquiry&eBayUser"])
  """
  This mutation can be used to provide shipment-related information in response to an Item Not Received inquiry. The information is submitted by the responder (typically the seller) to fulfill an existing information request initiated earlier in the inquiry flow, and will be shared with the initiator (typically the buyer or system) and other inquirers involved in the inquiry.
    
  **PossibleErrors**:
  | Code                                         | Message                                                                                             |
  |----------------------------------------------|-----------------------------------------------------------------------------------------------------|
  | ORDER_INQUIRY_NOT_FOUND_ERROR                | The specified inquiry ID does not exist.                                                            |
  | ORDER_INQUIRY_ACTION_NOT_PERMITTED_ERROR     | The action is not permitted. This includes inquiry state restrictions and access permission issues. |
  | INQRY_PROVIDE_SHIPMENT_INFO_VALIDATION_ERROR | Shipment information validation failed. Check tracking number format, carrier code, or completeness.|
  """
  provideShipmentInfoForItemNotReceivedInquiry(input: ProvideShipmentInfoForItemNotReceivedInquiryInput!): ProvideShipmentInfoForItemNotReceivedInquiryOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.inquiry&eBayUser"])
  """
  This mutation can be used to send a message within the context of a specific order inquiry. This method enables communication between participants (e.g., buyer sending an message to seller) within the structured context of an existing inquiry.
    
  **PossibleErrors**:
  | Code                                       | Message                                                                                             |
  |--------------------------------------------|-----------------------------------------------------------------------------------------------------|
  | ORDER_INQUIRY_NOT_FOUND_ERROR              | The specified inquiry ID does not exist.                                                            |
  | ORDER_INQUIRY_ACTION_NOT_PERMITTED_ERROR   | The action is not permitted. This includes inquiry state restrictions and access permission issues. |
  | INQRY_SEND_MESSAGE_VALIDATION_ERROR        | Message validation failed. Message may be empty, exceed length limit, or contain invalid characters.|
  """
  sendOrderInquiryMessage(input: SendOrderInquiryMessageInput!): SendOrderInquiryMessageOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.inquiry&eBayUser"])
  """
  This mutation can be used to submit an order inquiry to eBay as a referral request. Eligibility is determined by server-side validation of the inquiry’s state, policies, and caller permissions.
    
  **PossibleErrors**:
  | Code                                       | Message                                                                                            |
  |--------------------------------------------|----------------------------------------------------------------------------------------------------|
  | ORDER_INQUIRY_NOT_FOUND_ERROR              | The specified inquiry ID does not exist.                                                           |
  | ORDER_INQUIRY_ACTION_NOT_PERMITTED_ERROR   | The action is not permitted. This includes inquiry state restrictions and access permission issues.|
  | INQRY_SUBMIT_REFERRAL_VALIDATION_ERROR     | Referral validation failed. Referral reason may be missing, invalid, or not applicable.            |
  """
  submitOrderInquiryReferral(input: SubmitOrderInquiryReferralInput!): SubmitOrderInquiryReferralOutput! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.inquiry&eBayUser"])
  """
  This mutation is used to perform a bulk update of price and quantity for multiple fixed price items for a single-SKU or multi-SKU listing. In the output, the operation returns the corresponding item in the successes list for items that were updated and the failure list for items where issues occurred during the update. The operation returns either the updated listing details or error information if the update fails. This field only returns null under exceptional circumstances, such as when an execution error is raised.
  @authorize(scopes:[https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser])
  @sandboxSupported("true")
  """
  bulkUpdateInventory(input: BulkUpdateInventoryInput!): BulkUpdateInventoryOutput @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser"])
  """
  This mutation creates a new eBay listing with the specified product and terms details. The listing becomes visible to buyers once created, unless a future start time is specified. This field only returns null under exceptional circumstances, such as when an execution error is raised.
  @authorize(scopes:[https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser])
  @sandboxSupported("true")
  """
  createListing(input: CreateListingInput!): CreateListingOutput @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser"])
  """
  This mutation is used to create a Second Chance Offer listing based off of a recently ended auction listing. Second Chance Offers can only be made to a competitive bidder who participated in that auction listing. Either the listing ID or the SKU value must be specified to identify the listing for which a Second Chance Offer will be created against. The mutation also requires the user ID of the recipient that will receive the offer, the price of the offer, and the duration of the offer. Note that the offer price must match the user's original high bid and the supported offer duration times are 1, 3, 5, and 7 days. The recipient will receive an email notification with the offer details and will have the specified duration period to accept the offer before it expires. Sellers might want to use Second Chance Offers if the winning bidder never paid for the item, or if they have extra inventory of the item and would prefer to offer it up to a competitive bidder instead of creating another auction to make a sale. Upon successful creation, a new listing with a unique **listingId** is generated. However, this listing will not be exposed/available to anyone other than the recipient of that Second Chance Offer. This field only returns null under exceptional circumstances, such as when an execution error is raised.
  @authorize(scopes:[https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser])
  @sandboxSupported("true")
  """
  createSecondChanceListing(input: CreateSecondChanceListingInput!): CreateSecondChanceListingOutput @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser"])
  """
  This mutation is used to end an existing eBay listing prior to its scheduled end time. Either the listing ID or the SKU value must be specified to identify the listing to be ended. The **endListingReason** must be specified. Select the most appropriate reason from the **EndListingReason** enum list. The operation returns the details of the listing after it has been ended. This field only returns null under exceptional circumstances, such as when an execution error is raised.
  @authorize(scopes:[https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser])
  @sandboxSupported("true")
  """
  endListing(input: EndListingInput!): EndListingOutput @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser"])
  """
  This mutation is used to relist an ended eBay listing. Either the listing ID or the SKU value must be specified to identify the listing to be relisted. It is possible to relist a listing without making any changes to the listing at all, but any updates to the listing are allowed if desired. Regardless of whether changes are made or not, the relisted item will be treated as a new listing and will get a new **listingId** value. The new listing will also be subject to any applicable listing-related fees. The operation returns either the details of the newly created listing or error information if the relisting fails. This field only returns null under exceptional circumstances, such as when an execution error is raised.
  @authorize(scopes:[https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser])
  @sandboxSupported("true")
  """
  relistListing(input: RelistListingInput!): RelistListingOutput @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser"])
  """
     This mutation is used to make one or multiple updates to an active or scheduled eBay listing. Either the listing ID or the SKU value must be specified to identify the listing to be updated. Common changes include changes to price, quantity, listing title, listing description, aspects, and other information. It can be used to update various listing attributes such as price, quantity, title, description, and other relevant information. The operation returns either the updated listing details or error information if the update fails.
     
  Some general notes on update behavior are captured below:
     - With most collection fields (arrays), complete replacement is performed, which means that existing values not included will be removed from the listing. The exceptions to these rules include the **variationDetails**, **items**, and **itemCompatibilities** arrays. More information is provided in the descriptions for those arrays.
     - An individual field should only be provided if the seller wants to modify the setting/value for that field.
     - To remove/disable an optional field/feature, include that field and set it to null or leave empty as appropriate. More information is provided in the descriptions for those optional fields.
     @authorize(scopes:[https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser])
     @sandboxSupported("true")
  """
  updateListing(input: UpdateListingInput!): UpdateListingOutput @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.listing&eBayUser"])
