}

"""
This type is used to provide the complete shipping or tax address of a buyer.
"""
type PurchaseAddress {
  """
  The first line of the street address.
  **Maximum length**: 100 characters
  """
  addressLine1: String
  """
  This optional field is used to provide the second line of the street address if applicable. The second line of the street address is generally used to provide apartment or suite number.
  **Maximum length**: 100 characters
  """
  addressLine2: String
  """
  The city of the street address.
  **Maximum length**: 50 characters
  """
  city: String
  """The two-letter code representing the country of the street address."""
  country: CountryCode
  """The email address associated with the street address (if applicable)."""
  email: String
  """
  The phone number associated with the street address (if applicable).
  **Note**: The value must consist of numeric characters and may include symbols such as +, -, and spaces.
  **Maximum length**: 20 characters
  """
  phone: String
  """The postal code of the street address."""
  postalCode: String
  """
  The state or province of the street address.
  **Maximum length**: 50 characters
  """
  stateOrProvince: String
}

"""
This type is used to indicate that the purchase contract was initiated through an auction listing with a winning bidder.
"""
type PurchaseFlowAuction implements Labeled {
  """
  The human-readable label representing an Auction purchase flow. Value: `Auction`.
  """
  label: String!
}

"""
This type is used to indicate that the purchase contract was initiated through a buyer-initiated offer (Best Offer) that was accepted by the seller.
"""
type PurchaseFlowBestOffer implements Labeled {
  """
  The human-readable label representing a Best Offer purchase flow . Value: `Best Offer`.
  """
  label: String!
}

"""
This type is used to indicate that the purchase contract was initiated through a 'Buy it Now' flow, which can come from a fixed-price listing or from an auction listing with 'Buy it Now' feature enabled.
"""
type PurchaseFlowBuyItNow implements Labeled {
  """
  The human-readable label representing a Buy It Now purchase flow. Value: `Buy It Now`.
  """
  label: String!
}

"""
This type is used to indicate that the purchase contract was initiated through a successful **commitToPurchase** mutation.
"""
type PurchaseFlowCommitToBuy implements Labeled {
  """
  The human-readable label representing a Commit to Buy purchase flow. Value: `Commit to Buy`.
  """
  label: String!
}

"""
This type is used to indicate that the purchase contract was initiated through a Request Total purchase flow. With this flow, the seller does not have immediate payment set for the listing, and the buyer requests total cost before paying.
"""
type PurchaseFlowRequestTotal implements Labeled {
  """
  The human-readable label representing a Request Total purchase flow. Value: `Request Total`.
  """
  label: String!
}

"""
This type is used to indicate that the purchase contract was initiated through a seller-initiated offer that was accepted by the buyer.
"""
type PurchaseFlowSellerInitiatedOffer implements Labeled {
  """
  The human-readable label representing a seller-initiated offer purchase flow. Value: `Seller Initiated Offer`.
  """
  label: String!
}

"""
This union type will provide more information on how a purchase contract was initiated. For example, the buyer won an auction, the buyer and seller came to terms on a Best Offer or seller-initiated offer, or if a **commitToPurchase** mutation was used on behalf of a buyer.
"""
union PurchaseFlowType = PurchaseFlowAuction | PurchaseFlowBestOffer | PurchaseFlowBuyItNow | PurchaseFlowCommitToBuy | PurchaseFlowRequestTotal | PurchaseFlowSellerInitiatedOffer

"""
This type is used to provide full details on the fulfillment plan(s) available to the buyer, and ultimately, the fulfillment plan that is selected by the buyer. If a fulfillment plan has not been selected by the buyer yet, the **fulfillmentPlan** array will show all fulfillment plans available to the buyer. If the buyer has selected a fulfillment plan, but fulfillment has not yet started, the **fulfillmentPlan** array will show the selected the fulfillment plan. If the buyer has selected a fulfillment plan, and fulfillment has started or is completed, the **fulfillmentExecution** array will show the details of the fulfillment plan, including its current state. 
"""
type PurchaseLogistics {
  """
  This array shows the details of the selected fulfillment plan, including its current state. 
  """
  fulfillmentExecution: [LogisticsFulfillmentExecution!]
  """
  This array shows all fulfillment plans available to the buyer, or if a buyer has selected one, the fulfillment plan selected by the buyer, but not yet started. 
  """
  fulfillmentPlan: [LogisticsFulfillmentPlan!]
}

"""
This type is used to provide details for a payment method used in a purchase transaction.
"""
type PurchasePaymentMethod {
  """This container provides more information on the payment method used."""
  paymentType: PaymentMethodType!
}

"""
This type provides all details of a purchase quote. A purchase quote is a collection of two or more item commitments on one invoice that has adjusted price information and available shipping/pickup options.
"""
type PurchaseQuote {
  """The unique identifier of the purchase quote."""
  purchaseQuoteId: ID!
  """The buyer who associated with the purchase quote."""
  buyer: User!
  """
  This container is only returned if the purchase quote has been cancelled, and includes the unique identifier of the cancellation. 
  """
  cancellation: PurchaseQuoteCancellation
  """
  The exact date and time when the purchase quote was initially created in the system. This marks the start of the purchase quote lifecycle.   
  **Note**: Guaranteed to be non-null.
  """
  createdAt: DateTime!
  """
  This array show details on the line items associated with the purchase quote, including the identifier of the item, purchase quantity, how the item was purchased, and SKU value if defined.
  """
  lineItems: [PurchaseQuoteLineItem!]!
  """
  This array shows the set of logistics options available to the buyer for this purchase quote. Each option includes method and cost.
  """
  logisticsOptions: [PurchaseQuoteLogisticsOption!]
  """
  This array will show or more messages left by the buyer or seller for their order partner regarding the purchase quote.
  """
  messages: [PurchaseQuoteMessage!]
  """
  This container shows detailed information on any and all montetary transactions that occurred for the purchase quote between any combination of buyer, seller, and eBay. Each entry represents a distinct payment-related detail within the purchase quote lifecycle.
  """
  monetaryDetails: MonetaryDetails
  """
  This container is returned with a unique identifier of an order if there is an order associated with the purchase quote.
  """
  order: Order
  """Seller associated with the purchase quote."""
  seller: User!
  """The destination address where items will be shipped. """
  shippingAddress: PurchaseAddress!
  """
  This container provides Information on the current state of the purchase quote. The information that one will see here will be dependent on the state of the purchase quote.
  """
  state: PurchaseQuoteState!
  """
  This container shows cost breakdown details for a purchase quote, including total cost, taxes, shipping discounts, and additional charges.
  """
  totals: PurchaseQuoteTotals!
  """
  The exact date and time when the purchase quote was last modified or updated in the system. This timestamp captures any changes made to the purchase quote after initial creation, including change in state.
  **Note**: Guaranteed to be non-null.
  """
  updatedAt: DateTime!
}

"""
This type is used to indicate that a purchase quote is active and is now pending the buyer's action.
"""
type PurchaseQuoteActive implements Labeled {
  """
  The human-readable label representing an active purchase quote.
  **Maximum length**: 100 characters.
  """
  label: String!
}

"""
This type represents the cancellation of a **PurchaseQuote** contract. The original purchase quote is available in the `purchaseQuote` field.
"""
type PurchaseQuoteCancellation implements ContractCancellation {
  """The buyer involved in the cancellation."""
  buyer: User!
  """
  Actions presently available to the buyer for this cancellation request, including the primary action and deadline. This field will not be set unless there is an action available.
  """
  buyerAvailableActions: ContractCancellationActions @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.cancellation.read&eBayUser", "https://api.ebay.com/oauth/api_scope/buy.cancellation&eBayUser"])
  """The unique identifier of this cancellation."""
  cancellationId: ID!
  """
  The timestamp when the purchase quote cancellation was closed. If the status is not closed, this field will not be set.
  """
  closedAt: DateTime
  """
  A list of one or more line-level cancellation entries for this quote cancellation.
  """
  lineItems: [PurchaseQuoteCancellationLineItem!]!
  """The original purchase quote being cancelled."""
  purchaseQuote: PurchaseQuote!
  """The reason for the cancellation, if provided."""
  reason: ContractCancellationReason!
  """
  An array of refunds resulting from this cancellation. Present only if refund processing was initiated; otherwise, null.
  """
  refunds: [Refund!] @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.refund.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.refund.read&eBayUser"])
  """The timestamp when the cancellation was submitted."""
  requestedAt: DateTime!
  """The party that initiated the cancellation. For example, the `BUYER`."""
  requester: PostPurchaseActorRole!
  """
  The note provided with the cancellation request. Available if the requester provided a note; otherwise, null.
  """
  requesterNote: String
  """The seller involved in the cancellation (may have initiated)."""
  seller: User!
  """
  Actions presently available to the seller for this cancellation request, including the primary action and deadline. This field will not be set unless there is an action available.
  """
  sellerAvailableActions: ContractCancellationActions @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.cancellation.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.cancellation&eBayUser"])
  """The present status of this cancellation."""
  status: ContractCancellationStatus!
}

"""
This type represents an ineligibility reason indicating that the cancellation window on the purchase quote has elapsed.
"""
type PurchaseQuoteCancellationConflictWithWindowElapsed implements PurchaseQuoteCancellationIneligibilityReason {
  """
  Machine-readable eligibility failure reason code. For this type, the value is `CNCL_CANCELLATION_WINDOW_ELAPSED`.
  """
  code: String!
  """
  Human-readable message of the eligibility failure reason. For this type, the value is `It's too late to cancel this purchase quote. Please contact the buyer to see if you can work something out.`. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  The ID of the purchase quote whose cancellation was blocked by purchase quote level eligibility rules.
  """
  purchaseQuoteId: ID!
}

"""
This error type describes reasons that an eligibility failure prevented the cancellation of a purchase quote. The `ineligibilityReasons` field contains the specific quote-level failure reasons, explaining why the cancellation cannot be performed at this time.
"""
type PurchaseQuoteCancellationEligibilityError implements BusinessError {
  """
  The globally unique error code for this business error. For this type, the value is `CNCL_PURCHASE_QUOTE_ELIGIBILITY_ERROR`.
  """
  errorCode: String!
  """
  A human-readable description of the error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  A list of one or more purchase-quote level contract cancellation ineligibility reasons that prevent creation of a cancellation. For example, `CancellationExistsConflict` applies when the entire purchase quote is already cancelled or a cancellation is in progress. This field is required and contains at least one reason when this error is returned.
  """
  ineligibilityReasons: [PurchaseQuoteCancellationIneligibilityReason!]!
}

"""
This type represents an ineligibility reason indicating that the requested purchase quote already has a cancellation on file.
"""
type PurchaseQuoteCancellationExistsConflict implements PurchaseQuoteCancellationIneligibilityReason {
  """
  Machine-readable eligibility failure reason code. For this type, the value is `CNCL_CANCELLATION_EXISTS_CONFLICT`.
  """
  code: String!
  """
  Human-readable message of the eligibility failure reason. For this type, the value is `You cannot cancel this purchase quote because a cancellation exists on this contract.`. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """The ID of the purchase quote for which cancellation is ineligible."""
  purchaseQuoteId: ID!
}

"""
This interface provides the purchase-quote-level cancellation eligibility reasons that block creation of a cancellation.

**Note:** Additional reasons may be added in the future; clients should handle unrecognized types gracefully.
"""
interface PurchaseQuoteCancellationIneligibilityReason {
  """The unique machine-readable contract cancellation reason code."""
  code: String!
  """
  A human-readable description of the error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  The purchase quote ID that is not eligible for cancellation due to a quote-level an eligibility rule.
  """
  purchaseQuoteId: ID!
}

"""
This type represents a line item in a **PurchaseQuote** cancellation. It references the original purchase quote line item through `purchaseQuoteLineItem`.
"""
type PurchaseQuoteCancellationLineItem implements ContractCancellationLineItem {
  """The unique identifier of this cancellation line item."""
  cancellationLineItemId: ID!
  """
  The quantity that was cancelled from the original purchase quote line item. Present only when the purchase quote cancellation is completed.
  """
  cancelledQuantity: Int
  """
  A reference to the cancelled item. This optional field is present only when the cancellation has the reference item.
  """
  item: ContractCancellationItemReference
  """
  A list of one or more restock tasks for the cancelled listing. Present only when listing restock is requested through a cancellation mutation.
  """
  listingRestockTasks: [PostPurchaseListingRestockTask!] @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.cancellation.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.cancellation&eBayUser"])
  """A reference to the original purchase quote line item."""
  purchaseQuoteLineItem: PurchaseQuoteLineItem!
  """
  The quantity requested to be cancelled from the original purchase quote line item.
  """
  requestedQuantity: Int!
}

"""
This type represents an ineligibility reason indicating the input purchase quote cancellation reason is not allowed by policy.
"""
type PurchaseQuoteCancellationReasonNotAllowed implements PurchaseQuoteCancellationIneligibilityReason {
  """Applicable cancellation reasons for current actor (user)."""
  availableReasons: [ContractCancellationReason]!
  """
  The unique machine-readable contract cancellation reason code for this use case. For this type, the value is `CNCL_REASON_NOT_ALLOWED`.
  """
  code: String!
  """
  A human-readable description of the eligibility failure reason: `The cancellation reason you selected is not allowed by policy. Please choose a different reason and try again.`. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
  """
  The ID of the purchase quote whose cancellation was blocked by purchase quote level eligibility rules.
  """
  purchaseQuoteId: ID!
}

"""
This type is used to indicate that a purchase quote has been cancelled.
"""
type PurchaseQuoteCancelled implements Labeled {
  """This time stamp indicates when the cancellation occurred."""
  cancelledAt: DateTime!
  """
  The human-readable label representing a cancelled purchase quote.
  **Maximum length**: 100 characters.
  """
  label: String!
  """This field indicates the reason why the cancellation occurred."""
  reason: DisplayableId
}

"""
This type is used to indicate that a purchase quote has been completed. Once a purchase quote is completed, it cannot transition to a different state.
"""
type PurchaseQuoteCompleted implements Labeled {
  """
  The human-readable label representing a completed purchase quote.
  **Maximum length**: 100 characters.
  """
  label: String!
}

"""
This type is used when the **dateRange** filter is used in a **purchaseQuotes** query. A starting and ending time sets the date range, and all purchase quotes either created or updated within this time range are retrieved.
"""
input PurchaseQuoteDateRangeInput {
  """
  This container is used to set the time range. All purchase quotes either created or updated within this time range are retrieved.
  """
  dateTimeRange: DateTimeRangeInput
  """
  The enumeration value here controls whether retrieved purchase quotes are purchase quotes that were created within this date range or updated within this date range. The supported values are:
  - CREATED
  - UPDATED
  """
  dateType: PurchaseQuoteDateType!
}

"""
This enumeration type list the values that can be used in the **dateType** field if the user uses a date range filter in a **sellerPurchaseQuotes** or **buyerPurchaseQuotes** query. 
"""
enum PurchaseQuoteDateType {
  """
  If this value is used in the **dateType** field of a query, only purchase quotes created within the specified date range are returned. 
  """
  CREATED
  """
  If this value is used in the **dateType** field of a query, only purchase quotes updated within the specified date range are returned. 
  """
  UPDATED
}

"""
This input type includes the filters that can be used for a **purchaseQuotes** query. The **listingId** field can be used to retrieve purchase quote(s) for a specific listing, or one or more of the boolean fields can be used to retrieve purchase quotes in certain states.
**Note**: The default value for the **includeActive** boolean field is 'true', but the default value for all other boolean fields is 'false'.
"""
input PurchaseQuoteFilterInput {
  """
  Include this field and set to 'true' (or omit field) to include active purchase quotes in the output, or set to 'false' to exclude active purchase quotes. 
  **Default**: true
  """
  includeActive: Boolean! = true
  """
  Include this field and set to 'true' to include cancelled purchase quotes in the output, or set to 'false' (or omit field) to exclude cancelled purchase quotes. 
  **Default**: false
  """
  includeCancelled: Boolean! = false
  """
  Include this field and set to 'true' to include completed purchase quotes in the output, or set to 'false' (or omit field) to exclude completed purchase quotes. 
  **Default**: false
  """
  includeCompleted: Boolean! = false
  """
  Include this field and set to 'true' to include invalid purchase quotes in the output, or set to 'false' (or omit field) to exclude invalid purchase quotes. 
  **Default**: false
  """
  includeInvalid: Boolean! = false
  """
  Include this field and set to 'true' to include locked purchase quotes in the output, or set to 'false' (or omit field) to exclude locked purchase quotes. 
  **Default**: false
  """
  includeLocked: Boolean! = false
  """
  Include this field and set to 'true' to include purchase quotes that have been requested by the buyer in the output, or set to 'false' (or omit field) to exclude purchase quotes that have been requested by the buyer. 
  **Default**: false
  """
  includeRequested: Boolean! = false
  """
  Use this field to restrict results to purchase quotes that are associated with a specific eBay listing.
  """
  listingId: ID
}

"""
This type is used to provide one or more filters for the query, including a **listingId** filter, a date range filter, and filters based on states. Sort parameters are also available. 
"""
input PurchaseQuoteFirstFilterInput {
  """
  This container is used to set a date range filter. Only purchase quotes created or updated within this date range are returned.   
  """
  dateRange: PurchaseQuoteDateRangeInput!
  """
  This container includes the filters that can be used for a **purchaseQuotes** query. The **listingId** field can be used to retrieve purchase quote(s) involving a specific listing, or one or more of the boolean fields can be used to retrieve purchase quotes in certain states.
  **Note**: The default value for the **includeActive** boolean field is 'true', but the default value for all other boolean fields is 'false'.
  """
  filter: PurchaseQuoteFilterInput! = {includeActive: true, includeCancelled: false, includeCompleted: false, includeInvalid: false, includeLocked: false, includeRequested: false}
  """
  This container is used to control how purchase quotes are sorted in the query response. 
  """
  sort: PurchaseQuoteSortInput!
}

"""
This type is used to indicate that a purchase quote is invalid. A purchase quote can be irreversibly marked as invalid due to a system error or a business rule violation. Once marked as invalid, a purchase quote cannot be recovered or used.
"""
type PurchaseQuoteInvalid implements Labeled {
  """
  The human-readable label representing an invalid purchase quote.
  **Maximum length**: 100 characters.
  """
  label: String!
  """This field indicates the reason why the purchase quote is invalid."""
  reason: DisplayableId
}

"""
This input type is used to represent a single item commitment in a purchase quote.
"""
input PurchaseQuoteItemInput {
  """
  The unique identifier of an item commitment. Each purchase quote must contain two or more item commitments that share the same buyer and seller.
  """
  itemCommitmentId: ID!
}

"""
This type show details on the line items associated with the purchase quote, including the identifier of the line item, purchase quantity, how the item was purchased, and SKU value if defined.
"""
type PurchaseQuoteLineItem {
  """The unique identifier of the line item within the purchase quote."""
  purchaseQuoteLineItemId: ID!
  """
  This container is only returned if the purchase quote line item has been cancelled, and includes the unique identifier of the cancellation. 
  """
  cancellation: PurchaseQuoteCancellation
  """
  This container shows details on the line item, including the identifier of the item, purchase quantity, how the item was purchased, and SKU value if defined.
  """
  lineItem: ContractListingItem!
  """This container shows the source of the purchase quote line item."""
  lineItemSource: PurchaseQuoteLineItemSource!
  """
  This container is only returned if there is a return request associated with the purchase quote line item, and includes the unique identifier of the return request. 
  """
  return: PurchaseQuoteReturn
  """
  This container shows cost breakdown details for a purchase quote line item, including total cost, taxes, shipping discounts, and additional charges.
  """
  totals: PurchaseQuoteTotals!
}

"""
This output type is used when a **purchaseQuoteLineItemsByIds** query fails completely, and none of the specified purchase quote line items were successfully retrieved. The **failures** array will show the identifiers of the purchase quote line items that were not successfully retrieved, and the error fields will provide more details on the issue(s) that caused the query to fail.
"""
type PurchaseQuoteLineItemsByIdsCompleteFailure implements BusinessError {
  """
  The unique identifier of the error. 
  **Note**: Currently this field will always show PURCHASE_QUOTE_LINE_ITEMS_BY_IDS_COMPLETE_FAILURE.
  """
  errorCode: String!
  """
  The developer-friendly description of the error is shown in this field.
  """
  errorMessage: String!
  """
  This array shows the full list of purchase quote line items that could not be retrieved and the error(s) that led to the failure.
  """
  failures: [PurchaseQuoteLineItemsByIdsError!]!
}

"""
This type displays the unique identifiers of all purchase quote line items that were not successully retrieved, and the error(s) that caused them not to be retrieved.
"""
type PurchaseQuoteLineItemsByIdsError {
  """A user-friendly, non-localized message describing the error."""
  displayMessage: String!
  """
  The unique identifier of the error. Below are the three errors that may occur:
  - INVALID_INPUT: This error indicates that the purchase quote line item ID is not recognized or it doesn't belong to the authenticated eBay user.  
  - TEMPORARILY_NOT_AVAILABLE: This error indicates that a system error occurred. This error may occur with a complete failure, and the user can try again after a short period of time. 
  """
  errorCode: String!
  """
  The unique identifier of the purchase quote line item that failed to be retrieved.
  """
  inputPurchaseQuoteLineItemId: ID!
  """
  This boolean indicates whether or not the user should try to retrieve the corresponding purchase quote line item again. If this field is returned as 'true', the user can make another attempt to retrieve the purchase quote line item.
  """
  retryable: Boolean!
}

"""
This input type is used to identify one or more purchase quote line items to retrieve in a **purchaseQuoteLineItemsByIds** query.
"""
input PurchaseQuoteLineItemsByIdsInput {
  """
  This array is used to provide from 1 up to 100 purchase quote line item identifiers when using a *purchaseQuoteLineItemsByIds** query. A comma is used as a delimiter for each purchase quote line item identifier.
  """
  purchaseQuoteLineItemId: [ID!]!
}

"""
This union type is used to represent the possible outcomes of the **purchaseQuoteLineItemsByIds** query.
"""
union PurchaseQuoteLineItemsByIdsOutput = PurchaseQuoteLineItemsByIdsCompleteFailure | PurchaseQuoteLineItemsByIdsPartialFailure | PurchaseQuoteLineItemsByIdsSuccess

"""
This output type is used when a **purchaseQuoteLineItemsByIds** query is partially successful, where one or more specified purchase quote line items were successfully retrieved, but one or more other specified purchase quote line items failed to be retrieved. The **purchaseQuoteLineItems** array will display all purchase quote line items that were successfully retrieved, the **failures** array will show the identifiers of the purchase quote line items that were not successfully retrieved, and the error fields will provide more details on the issue(s) that caused the query to only be partially successful.
"""
type PurchaseQuoteLineItemsByIdsPartialFailure implements BusinessError {
  """
  The unique identifier of the error. 
  **Note**: Currently this field will always show PURCHASE_QUOTE_LINE_ITEMS_BY_IDS_PARTIAL_FAILURE.
  """
  errorCode: String!
  """
  The developer-friendly description of the error is shown in this field.
  """
  errorMessage: String!
  """
  This array shows the full list of purchase quote line items that could not be retrieved and the error(s) that led to the failure.
  """
  failures: [PurchaseQuoteLineItemsByIdsError!]!
  """
  This array shows the full list of successfully retrieved purchase quote line items.
  """
  purchaseQuoteLineItems: [PurchaseQuoteLineItem!]!
}

"""
This output type is used when a **purchaseQuoteLineItemsByIds** query is fully successful and all purchase quote line items were successfully retrieved. 
"""
type PurchaseQuoteLineItemsByIdsSuccess {
  """
  This array shows the full list of purchase quote line items matching the provided identifiers.
  """
  purchaseQuoteLineItems: [PurchaseQuoteLineItem!]!
}

"""This union type shows the origin of a line item in the purchase quote."""
union PurchaseQuoteLineItemSource = ItemCommitment

"""
This type is used to indicate that a purchase quote is temporarily locked due to an in-progress operation. Updates to the purchase quote are disabled until the operation completes.
"""
type PurchaseQuoteLocked implements Labeled {
  """
  The human-readable label representing a locked purchase quote.
  **Maximum length**: 100 characters.
  """
  label: String!
}

"""
This interface is used to show logistics options and costs available for a purchase quote.
"""
interface PurchaseQuoteLogisticsOption {
  """
  This container shows the cost of the logistics option specified in the corresponding **displayName** field. If the logistics option is free to the buyer, this container will show a value of '0.0'.  
  **Note**: If the authenticated user uses a different currency than the default currency used by the eBay marketplace, this amount will also be shown in that user's currency.
  """
  cost: AmountSet!
  """
  The display name of the logistics option.
  **Format**: Alphanumeric characters and may include spaces.
  **Minimum length**: 1 character
  **Maximum length**: 100 characters
  """
  displayName: String!
}

"""
This type is used to add or modify available shipping or pickup logistics options provided by the seller.
**Note**: Only one of the containers in this type can be used per request. If they are both used, an error will occur.
"""
input PurchaseQuoteLogisticsOptionInput {
  """
  This array is used to update the pickup options and costs that are available to the buyer for order pickup. All available pickup options and costs must be supplied in this array and not just new pickup options or existing pickup options where the cost is being modified.
  **Note**: If this array is being used, the **shipping** array cannot be used or an error will occur.
  """
  pickup: [PickupLogisticsOptionInput!]
  """
  This array is used to update the shipping service options and costs that are available to the buyer for order shipment. All available shipping service options and costs must be supplied in this array and not just new shipping service options or existing shipping service options where the cost is being modified.
  **Note**: If this array is being used, the **pickup** array cannot be used or an error will occur.
  """
  shipping: [ShippingLogisticsOptionInput!]
}

"""
This type show details of a message left by the buyer or seller for their order partner regarding the purchase quote.
"""
type PurchaseQuoteMessage {
  """
  The full message left by the buyer or seller involved in the purchase quote.
  """
  message: String!
  """
  This timestamp indicates exactly when the message was left by the buyer or seller.
  """
  sentAt: DateTime
  """
  This boolean field indicates whether the message was sent by the buyer.
  """
  sentByBuyer: Boolean!
  """
  This boolean field indicates whether the message was sent by the seller.
  """
  sentBySeller: Boolean!
