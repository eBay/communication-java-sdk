union ContractCancellationItemReference = Item

"""
This type contains the line item level information of a contract cancellation. This cancel line item has a 1 to 1 mapping relationship with the external **contractLineItem** + item level reference.

**Note:** Additional interface types may be added in the future; clients should handle unrecognized types gracefully.
"""
interface ContractCancellationLineItem {
  """ The unique ID of the contract cancellation line item """
  cancellationLineItemId: ID!
  """
  The Quantity cancelled for the original contract line item. Present only when the contract cancellation status is complete.
  """
  cancelledQuantity: Int
  """
  The reference to the cancelled item reference. Optional present if in the cancellation.
  """
  item: ContractCancellationItemReference
  """
  The restock detail for the cancelled listing. Present only when listing restock is requested through a cancellation mutation.
  """
  listingRestockTasks: [PostPurchaseListingRestockTask!]
  """
  The quantity requested for cancellation on the original contract line item.
  """
  requestedQuantity: Int!
}

"""This error type indicates the specified cancellation cannot be found."""
type ContractCancellationNotFoundError implements BusinessError {
  """
  The machine-readable error code for this business error. For this type, the value is `CNCL_NOT_FOUND_ERROR`.
  """
  errorCode: String!
  """
  A human-readable description of the error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """The requested contract cancellation Id that was not found."""
  requestedContractCancellationId: ID!
}

"""
This union type defines the response payload for the **contractCancellation** query. On success, the response includes a **ContractCancellationSuccess** type object; on failure it returns an error indicating the reason that the cancellation failed.

**Note:** Additional types may be added to this union in the future; clients should handle unrecognized types gracefully.
"""
union ContractCancellationOutput = ContractCancellationNotFoundError | ContractCancellationSuccess

"""
This type indicates that the cancellation is approved, and awaiting processing or a refund is in progress.
"""
type ContractCancellationPending implements ContractCancellationStatus {
  """
  The machine-readable cancellation status code. For this type, the value is `PENDING`.
  """
  code: String!
  """
  A human-readable description of the cancellation status. This alphanumeric string is not localized and may change without notice.
    
  Maximum length: 100 characters
  """
  displayText: String!
}

"""
This interface provides the cancellation reason during contract cancellation creation.

**Note:** Additional reasons may be added in the future; clients should handle unrecognized types gracefully.
"""
interface ContractCancellationReason {
  """The machine-readable cancellation code for this business use case."""
  code: String!
  """
  A human-readable description of the cancellation reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This enumerated type provides reasons for seller cancellation of an order.

**Note:** Additional values may be added to this enumerated type in the future; clients should handle unrecognized values gracefully.

Client implementation guidelines:
- Include a default or fallback case when switching on these values
- Do not assume this list is exhaustive
- New values may be added without a major version change
- Persist the raw string value to preserve unknown future values

Example:
```typescript
switch (reason) {
case 'BUYER_REQUESTED':
// handle...
case 'OUT_OF_STOCK':
// handle...
default:
// handle unknown future values gracefully
}
```
"""
enum ContractCancellationSellerReasonInput {
  """ The buyer requested the order cancellation."""
  BUYER_REQUESTED
  """ The item is out of stock."""
  OUT_OF_STOCK
  """ There are issues with the buyer's shipping address."""
  SHIPPING_ADDRESS_ISSUES
  """ The contract is unpaid."""
  UNPAID_CONTRACT
}

"""
This enumerated type provides values for contract cancellations sorting criteria. 

**Note:** Additional sort fields may be added in the future; clients should handle unrecognized values gracefully.
"""
enum ContractCancellationSortField {
  """The request date timestamp of the contract cancellation."""
  REQUESTED_AT
}

"""
This input type is used to define the filter and sort direction for contract cancellations.
"""
input ContractCancellationSortInput {
  """
  Specifies the field by which the contract cancellations are sorted.
    
  **Default:** Sorts by the requested date
  """
  sortField: ContractCancellationSortField = REQUESTED_AT
  """
  Specifies the sort direction of the contract cancellations returned in the result.
    
  **Default:** `ASC`
  """
  sortOrder: SortOrder = ASC
}

"""
This interface provide the status for the contract cancellation on the contract. 

**Note:** Additional interface types may be added in the future; clients should handle unrecognized types gracefully.
"""
interface ContractCancellationStatus {
  """
  Implementations should provide a single stable code that will never change. Clients can use code or __typename interchangeably, but __typename is preferred.
  """
  code: String!
  """
  A human-readable description of the cancellation status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This enumerated type provides values for filtering contract cancellations by status. 

**Note:** Additional values may be added in the future; clients should handle unrecognized values gracefully.
"""
enum ContractCancellationStatusFilterPreset {
  """An open cancellation that is awaiting an action from the seller."""
  AWAITING_ACTION_FROM_SELLER
  """The cancellation has completed (end state)."""
  COMPLETED
  """The cancellation is declined (end state)."""
  DECLINED
  """
  An approved cancellation that is awaiting processing or a refund is in progress.
  """
  PENDING
}

"""This type indicates a successful retrieval of a contract cancellation."""
type ContractCancellationSuccess {
  """The contract cancellation retrieved."""
  contractCancellation: ContractCancellation!
}

"""
This interface represents a contract cancellation warning.

**Note:** Additional interface types may be added in the future; clients should handle unrecognized types gracefully.
"""
interface ContractCancellationWarning {
  """A machine-readable warning code."""
  warningCode: String!
  """
  A human-readable description message for each contract cancellation warning. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:**  512 characters.
  """
  warningMessage: String!
}

"""
This type indicates that the cancellation is currently being processed by the system.
"""
type ContractCancelPending implements Labeled {
  """
  The human-readable label representing this state (e.g. 'System Processing').
  **Maximum length**: 100 characters.
  """
  label: String!
  """
  This timestamp indicates when the purchase contract cancellation started being processed.
  """
  startedAt: DateTime!
}

"""
This type indicates that the cancellation request has been rejected by the seller.
"""
type ContractCancelRejected implements Labeled {
  """
  The human-readable label representing this state (e.g. 'Seller Rejected').
  **Maximum length**: 100 characters.
  """
  label: String!
  """
  This field shows the reason why the cancellation was rejected. 
  **Note**: This field is returned if a reason was given.
  """
  reason: String
  """
  The timestamp when the cancellation was rejected, which could be null if the data is not available.
  """
  rejectedAt: DateTime
}

"""This type indicates that the buyer has requested a cancellation."""
type ContractCancelRequested implements Labeled {
  """
  The human-readable label representing this state (e.g. 'Buyer Requested').
  **Maximum length**: 100 characters.
  """
  label: String!
  """
  This timestamp indicates when the purchase contract cancellation was requested.
  """
  requestedAt: DateTime
}

"""
This union type is used to indicate the state of a cancelled purchase contract.
"""
union ContractCancelState = ContractCancelCompleted | ContractCancelPending | ContractCancelRejected | ContractCancelRequested

"""This type details a refund that covers the entire purchase entity."""
type ContractFullyRefunded implements Labeled {
  """
  The human-readable label representing this fully-refunded state.
  **Maximum length**: 100 characters.
  """
  label: String!
  """The timestamp when the refund was processed."""
  refundedAt: DateTime!
}

"""
This type is used to show details on the line item associated with a purchase contract, including the identifier of the item, purchase quantity, how the item was purchased, and SKU value if defined.
"""
type ContractListingItem {
  """
  The unique identifier of the purchasable item associated with this purchase contract.
  """
  item: Item!
  """
  The seller-provided SKU (Stock-Keeping Unit) value of a purchasable item. This field is returned if defined in a listing.
  """
  itemSku: ItemSku
  """
  This container will provide more information on how the item commitment was initiated. For example, the buyer won an auction, the buyer and seller came to terms on a Best Offer or seller-initiated offer, or if a **commitToPurchase** mutation was used on behalf of a buyer.
  """
  purchaseFlow: PurchaseFlowType
  """
  The purchase quantity of the line item associated with this purchase contract.
  **Note**: This value will always be '1' for an auction listing, but can be more for a fixed-price item with multiple quantity available.
  """
  quantity: Int!
}

"""
This type is used to provide details about a partial refund issued for a purchase contract.
"""
type ContractPartiallyRefunded implements Labeled {
  """
  The human-readable label representing this partially-refunded state.
  **Maximum length**: 100 characters.
  """
  label: String!
  """This array lists specific line items involved in the refund."""
  lineItemReferences: [LineItemReference!]
}

"""
This type indicates that the contract was placed by mistake. For example, user accidentally clicked a button and placed the contract.
"""
type ContractPlacedByMistakeCancellation implements ContractCancellationReason {
  """
  The unique machine-readable contract cancellation reason code for this use case. For this type, the value is `CONTRACT_PLACED_BY_MISTAKE`.
  """
  code: String!
  """
  A human-readable description of the cancellation reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This union type is used to provide details about a full or partial refund issued for a purchase contract.
"""
union ContractRefundState = ContractFullyRefunded | ContractPartiallyRefunded

"""This type indicates that the return request has been approved."""
type ContractReturnApproved implements Labeled {
  """The timestamp when the return was approved."""
  approvedAt: DateTime!
  """A human-readable label for the state."""
  label: String!
}

"""
Thie type indicates that the return process has been completed and closed, including the final outcomes such as whether a refund was issued, the item was returned, and if the return was accepted.
"""
type ContractReturnClosed implements Labeled {
  """The timestamp when the return was officially closed."""
  closedAt: DateTime!
  """
  When `true`, the returned item was accepted (optional if unknown or not applicable).
  """
  itemAccepted: Boolean
  """When `true`, the item was physically returned."""
  itemReturned: Boolean!
  """A human-readable label for the state."""
  label: String!
  """When `true`, this indicates a refund was issued to the buyer."""
  refundIssued: Boolean!
}

"""
This type indicates that the return process has been escalated for further review or action and includes the responsible or pending party (for example, buyer, seller, customer service).
"""
type ContractReturnEscalated implements Labeled {
  """The timestamp when the return was escalated."""
  escalatedAt: DateTime!
  """A human-readable label for the state."""
  label: String!
  """
  The party currently responsible for resolving the escalation (for example, buyer, seller, or customer service).
  """
  pendingParty: EscalationPendingParty!
}

"""
This type indicates that the item is in transit from the buyer to the seller or warehouse and includes the dates for shipment, and optionally the delivery and inspection result.
"""
type ContractReturnInTransit implements Labeled {
  """
  The timestamp when the item was delivered to the return location (optional).
  """
  deliveredAt: DateTime
  """
  When `true`, the item has been inspected upon arrival. This field may be null if not yet delivered.
  """
  inspected: Boolean
  """A human-readable label for the state."""
  label: String!
  """The timestamp when the item was shipped by the buyer."""
  shippedAt: DateTime!
}

"""
This type indicates that the return was rejected, including the reason for rejection.
"""
type ContractReturnRejected implements Labeled {
  """A human-readable label for the state."""
  label: String!
  """An optional reason provided for why the return was rejected."""
  reason: String
  """The timestamp when the return was rejected."""
  rejectedAt: DateTime!
}

"""This type indicates that the return was requested by the buyer."""
type ContractReturnRequested implements Labeled {
  """A human-readable label for the state."""
  label: String!
  """The timestamp when the return was initially requested."""
  requestedAt: DateTime!
}

"""This union type defines the lifecycle states of a return request."""
union ContractReturnState = ContractReturnApproved | ContractReturnClosed | ContractReturnEscalated | ContractReturnInTransit | ContractReturnRejected | ContractReturnRequested

"""
This type represents the monetary amount shown in both the listing currency and the viewer’s currency.
"""
type ConvertedAmount {
  """
  The monetary amount of the listing converted to the viewer’s currency.
  **Note:** This field may be null if conversion is unavailable.
  """
  converted: Amount
  """
  The monetary amount in the listing’s original currency. This value represents the monetary amount of the listing before any conversion is performed.
  """
  original: Amount
}

"""
This type indicates the item is returned because it is counterfeit. Displays as **Counterfeit**.
"""
type Counterfeit implements ReturnReason {
  """A machine-readable reason code: `COUNTERFEIT`"""
  code: String!
  """
  A human-readable description of the return reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
The base request type for the **counterOffer** mutation. This type defines the input information needed to respond to an active offer with different terms. This includes the item ID and offer ID associated with the offer the buyer wishes to counter, as well as the price and quantity of the counteroffer. An optional message can also be attached to the counteroffer to help explain or justify it.
"""
input CounterOfferInput {
  """
  The unique identifier of the purchasable item for which the counteroffer is being made.
  """
  itemId: ID!
  """
  An optional message that can be used to explain or justify the counteroffer. This message will be visible to the seller and can help provide context for the proposed price or terms.
  **Maximum length**: 250 characters
  """
  message: String
  """
  The unique identifier of the existing offer being countered. The offer must have the 'PENDING' status and the user must be authorized to counter it.
  """
  offerId: ID!
  """
  The price of the counteroffer for the item. This value must be greater than zero and in the item's listing currency.
  **Note**: If the **quantity** of the item is greater than '1', this value represents the price of one unit, not the entire order.
  """
  proposedPrice: AmountInput!
  """
  The number of items being requested in the counteroffer. This value can not exceed the available quantity of the listing.
  """
  quantity: Int = 1
}

"""
This type defines the business rule error that occurs when a counter offer amount is less than auto decline threshold.
"""
type CounterOfferLessThanAutoDeclinePrice implements OfferBusinessRuleViolation {
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

"""
This type defines the business rule error that occurs when counter offers are not enabled for this offer/item.
"""
type CounterOfferNotEnabled implements OfferBusinessRuleViolation {
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

"""
The union type for the **counterOffer** mutation. This type covers two possible scenarios: success or failure. If the **counterOffer** mutation succeeds, the counteroffer will be created information about the newly-created counteroffer will be returned. If the **counterOffer** mutation fails, an array of blocking errors detailing why the mutation failed will be returned, and the counteroffer will not be created. If a mutation fails, there will always be at least one blocking error.
"""
union CounterOfferOutput = CounterOfferSent | OfferBusinessRulesViolated | ReferenceArgumentsNotFound

"""
This type is used for a successful **counterOffer** mutation. On success, details about the newly created counteroffer are returned, such as the counteroffer ID, status, and expiration date.
"""
type CounterOfferSent {
  """
  This container returns details about the counteroffer created using the **counterOffer** mutation. This information includes the offer ID, status, and expiration date of the newly created counteroffer.
  """
  offer: NegotiationOfferDetails!
}

