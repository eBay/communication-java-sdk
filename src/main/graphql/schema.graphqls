  """
  ruleDescription: String!
}

"""
This type defines the business rule error that occurs when the offer quantity is not available.
"""
type OfferQuantityNotAvailable implements OfferBusinessRuleViolation {
  """
  The quantity of the item already purchased by this buyer for this listing.
  **Unit**: items (whole count)
  **Range**: non-negative integer (0+)
  """
  alreadyBoughtQuantity: Int
  """
  The quantity of the item currently available for purchase.
  **Unit**: items (whole count)
  **Range**: non-negative integer (0+)
  """
  availableQuantity: Int
  """
  The quantity of the item requested in the offer.
  **Unit**: items (whole count)
  **Range**: positive integer (1+)
  """
  offerQuantity: Int
  """
  The maximum quantity of the item allowed per buyer for this listing.
  **Unit**: items (whole count)
  **Range**: positive integer (1+) when enforced; null if no per-buyer cap
  """
  perBuyerMaximumAllowedQuantity: Int
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

"""
This type defines the business rule error that occurs when the item does not ship to the buyer's location.
"""
type OfferShipToLocationExclusion implements OfferBusinessRuleViolation {
  """
  The two-letter country code of the country where the buyer wants the item shipped.
  """
  buyerShipToCountry: CountryAlpha2Code
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

"""
This enumerated value specifies the possible statuses that an offer can have.
"""
enum OfferStatus {
  """
  This enum value indicates that the offer has been manually accepted by the recipient.
  """
  ACCEPTED
  """
  This enum value indicates that the offer was forcibly ended through administrative intervention.
  """
  ADMIN_ENDED
  """
  This enum value indicates that the offer met predefined conditions and was accepted automatically.
  """
  AUTO_ACCEPTED
  """
  This enum value indicates that the offer was declined automatically due to business rules or constraints.
  """
  AUTO_DECLINED
  """
  This enum value indicates that the offer was canceled. This may occur when a subsequent offer supersedes the current one.
  """
  CANCELED
  """
  This enum value indicates that the recipient has responded with a counteroffer.
  """
  COUNTERED
  """
  This enum value indicates that the offer has been manually declined by the recipient.
  """
  DECLINED
  """
  This enum value indicates that the offer expired without receiving a response within the allowed time frame.
  """
  EXPIRED
  """Seller accepted the buyer's offer. Buyer must complete payment now."""
  PAYMENT_PENDING
  """
  This enum value indicates that the offer is awaiting a response from the recipient.
  """
  PENDING
  """
  This enum value indicates that the offer was withdrawn by its creator before a response was received.
  """
  RETRACTED
  """
  This enum value indicates that the seller accepted the offer and is awaiting buyer payment to finalize the purchase.
  """
  SELLER_ACCEPTED
}

"""
This union type represents the polymorphic target of a negotiation and defines the type of object being negotiated (e.g., an individual item or a bundle of items). Currently, the only supported target type is `Item`, but more target types may be added in the future.
"""
union OfferTarget = Item

