  """
  ruleDescription: String!
}

"""
This type defines the business rule error that occurs when the attempted offer action is not done by the buyer or seller.
"""
type OfferUserNotValid implements OfferBusinessRuleViolation {
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

"""
This type defines the business rule error that occurs when the user's account is suspended.
"""
type OfferUserSuspended implements OfferBusinessRuleViolation {
  """
  The description of the business rule failure.
