}

"""This type is used to identify KlarnaInvoice as the payment method."""
type KlarnaInvoice implements PaymentMethodType {
  """The unique identifier of the KlarnaInvoice payment method."""
  code: ID!
  """The descriptive name of the KlarnaInvoice payment method."""
  descriptiveName: String!
  """The display name of the KlarnaInvoice payment method."""
  displayName: String!
}

"""
This interface is used to provide a human-readable identifier for the state of an entity.
"""
interface Labeled {
  """
  The human-readable label representing the state of an entity.
  **Maximum length**: 100 characters.
  """
  label: String!
}

"""
This type represents an amount being withheld from the refund due to the cost of a shipping label.
"""
type LabelPurchaseWithholding implements RefundWithholding {
  """The monetary amount being withheld from the refund."""
  amount: AmountSet!
  """
  The name of the withholding.
