type OrderReturn {
  """The unique identifier of a return request."""
  returnId: ID!
  """
  This object represents actions available for the buyer on this return based on the return state and role. This field is nullable. It may be null for any of the following reasons:
  - the buyer is not a participant
  - no actions are currently available based on the return state and role
  - the return is in a terminal state (for example, `CLOSED`)
  """
  buyerAvailableActions: AvailableReturnActions @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.return.read&eBayUser", "https://api.ebay.com/oauth/api_scope/buy.return&eBayUser"])
  """
