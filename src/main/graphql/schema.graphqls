schema {
  query: Query
  mutation: Mutation
}

directive @authorize(scopes: [String!]!) on OBJECT | FIELD_DEFINITION

"""
This union type represents different purchase entities that can be created from an accepted offer. Currently, only ItemCommitment purchases are supported.
"""
union AcceptedOfferPurchaseReference = ItemCommitment

"""
The base request type for the **acceptOffer** method. This type defines the input information needed for accepting an active offer. This includes the item ID and offer ID associated with the offer being accepted, as well as an optional message accompanying the acceptance that can be used to express appreciation for the buyer or provide additional context.
"""
input AcceptOfferInput {
  """
  The unique identifier of the purchasable item for which the offer is being accepted.
  """
  itemId: ID!
  """
  An optional message to accompany the acceptance of the offer. This message will be visible to the seller and can be used to express appreciation for the buyer or provide additional context.
  **Maximum length**: 250 characters
  """
  message: String
  """
  The unique identifier of the offer being accepted. The offer must have 'PENDING' status and the user must be authorized to accept it.
  """
  offerId: ID!
}

"""
The union type for the **acceptOffer** mutation. This type covers two possible scenarios: success or failure. If the **acceptOffer** mutation succeeds,the offer is accepted and information about the accepted offer will be returned. If the **acceptOffer** mutation fails, an array of blocking errors detailing why the mutation failed will be returned, and the offer will not be accepted. If a mutation fails, there will always be at least one blocking error.
"""
union AcceptOfferOutput = AcceptOfferSent | OfferBusinessRulesViolated | ReferenceArgumentsNotFound

"""
This type is used for a successful **acceptOffer** mutation. On success, details about the accepted offer are returned, such as the offer ID, updated status, and transaction ID.
"""
type AcceptOfferSent {
  """
  This container returns details about the offer that was accepted using the **acceptOffer** mutation. This information includes the offer ID, status ('ACCEPTED'), and transaction ID associated with the accepted offer.
  """
  offer: NegotiationOfferDetails!
  """
  This field returns the reference to the purchase entity created when the offer was accepted. This provides access to the purchase details, pricing, and order information associated with the accepted offer.
  **Note**: Currently, only ItemCommitment purchases are supported.
  """
  purchaseReference: AcceptedOfferPurchaseReference
}

"""
This container includes information about active bid records (i.e., bids that have not been cancelled or retracted).
"""
type ActiveBidMetadata implements BidMetadata {
  """
  Indicates if the record belongs to an automatic bid:
  - true: The corresponding bid is an automatic bid.
  - false: The corresponding bid is not an automatic bid.
  """
  isAutomaticBid: Boolean!
  """
  Indicates if the corresponding bid is the highest bid for the item:
  - true: The corresponding bid is the highest bid for the item.
  - false: The corresponding bid is not the highest bid for the item.
  """
  isHighestBid: Boolean!
  """
  The date and time, expressed in UTC, when the corresponding bid was placed.
  
  **Format:** YYYY-MM-DDTHH:MM:SS.SSSZ
  """
  placedAt: DateTime!
}

"""
This input type defines the payload for the **addListingsToReturnRuleListingGroup** mutation, used for adding more items to an existing listing group which a seller creates for return automation rules. Each list can contain up to 5000 listings, with up to 500 listings added to a list in a single call.
"""
input AddListingsToReturnRuleListingGroupInput {
  """
  A list of listing IDs to be added to the group. Up to a maximum of 5000 listing can be added to a group, with up to 500 listings added to a group in a single call. When this field is used, keep the following in mind: 
  - each listing can be part of multiple groups
  - listing IDs must be unique within the group
  - a maximum of 500 listings can be added to a group in a single processing
  - a minimum of 1 listing must be provided to create a group
    
  **Minimum:** 1 listing
  **Maximum:** 500 listings
  """
  listingIds: [ID!]!
  """
  The unique identifier for the listing group, generated by the system when the group was created.
  """
  returnRuleListingGroupId: ID!
}

"""
This base response union type for the **addListingsToReturnRuleListingGroup** mutation adds items to a custom item list group created by the seller for return automation rules.
It indicates whether the list was successfully created/updated or if an error occurred that prevented its creation/update. It returns an error if:
- a list with the supplied name already exists for this seller
- the input request contains duplicate item IDs
- one or more provided item IDs either do not exist or are not owned by the seller
- the request attempts to add more items than the allowed per-request limit (schema: 500)
- creating or expanding the list would exceed the list's total item capacity (schema: 5000)
- the provided name violates validation rules (length, allowed characters, reserved words)
- the seller has reached the maximum number of list allowed for their account
- the return rules feature is not enabled for the seller
"""
union AddListingsToReturnRuleListingGroupOutput = ReturnRuleFeatureNotEnabledError | ReturnRuleListingGroup | ReturnRuleListingGroupDuplicateListingError | ReturnRuleListingGroupMaxSizeExceededError | ReturnRuleListingGroupNotFoundError | ReturnRuleListingIdsPerRequestLimitExceededError

"""This type defines the address fields for a user or entity."""
type Address implements ReturnAddress & ProfileAddress & ShippingZone {
  """
  The contact details associated with the address. Contact information is only returned in the following scenarios: 
  - A buyer may receive the seller’s contact information for a return address to generate a return label.
  - A seller may receive the buyer’s contact information for a shipping address to create a forward shipping label.
  """
  addressContact: AddressContact
  """
  The unique public identifier of the address. This field is used primarily for Return Address records and for sharing a reference that is stable across requests.
  **Example:** 'RA-9c4b2f58-1f4e-4e72-9a4c-702d5e2b74e1'
  """
  addressId: ID
  """The first line of the street address."""
  addressLine1: String
  """
  The second line of the street address. This field can be used for additional address information, such as a suite or apartment number. This field will only be returned if defined for the shipping address.
  """
  addressLine2: String
  """The city of the address."""
  city: String
  """
  The two-letter [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) country code for the country of the address.
  """
  countryCode: CountryAlpha2Code
  """The county of the address."""
  county: String
  """The postal code of the address."""
  postalCode: String
  """The state or province of the address."""
  stateOrProvince: String
}

"""
This type defines the contact information for a user or business associated with a given address.
"""
type AddressContact {
  """
  The name of the person or business at this address.
      
  **Example:** 'Jane Doe' or 'Acme Corporation'.
  """
  name: String!
  """
  The phone contact information associated with this address. If returned `null`, no phone number has been provided by the user or business.
  """
  phone: Phone
}

"""
This type is used to provide the alternative shipping address for a buyer when using the **requestPurchaseQuote** mutation.
"""
input AddressInput {
  """
  The first line of the street address.
  **Maximum length**: 100 characters
  """
  addressLine1: String
  """
  This optional field is used to provide the second line of the street address if applicable. The second line of the street address is generally used to provide apartment or suite number.
  **Maximum length**: 100 characters
  """
  addressLine2: String
  """
  The city of the street address.
  **Maximum length**: 50 characters
  """
  city: String
  """The two-letter code representing the country of the street address."""
  country: CountryCode
  """
  The email address associated with the buyer (if applicable). A valid email format must be used.
  **Maximum length**: 254 characters
  """
  email: String
  """
  The phone number associated with the street address (if applicable).
  **Note**: The value must consist of numeric characters and may include symbols such as +, -, and spaces.
  **Maximum length**: 20 characters
  """
  phone: String
  """
  The postal code of the street address.
  **Maximum length**: 20 characters
  """
  postalCode: String
  """
  The state or province of the street address.
  **Maximum length**: 50 characters
  """
  stateOrProvince: String
}

"""
This type indicates that the **addToWatchList** mutation failed. All requested items failed to be added to the user's Watchlist. The unique identifier of each item that failed to be added to the Watchlist is returned, alongside the reason each failed. This type also returns the total number of items being watched by the user after the failed mutation and the maximum number of items they can add to their Watchlist.
"""
type AddToWatchListFailure implements BusinessError {
  """
  A unique identifier for this specific business error type. This code can be used by clients to programmatically identify and handle different types of errors without relying on error messages, which may change over time. Each error type will always return the same **errorCode** value.
  **Note**: This field will always return 'WTCHL_ALL_FAILURE' in this context.
     **Maximum length**: 40 characters
     **Format**: Alphanumeric characters and underscores, in UPPER_CASE format
  """
  errorCode: String!
  """
  A human-readable message describing the error. This message is intended for developers and should not be displayed directly to end users. It provides additional context about what went wrong and may include suggestions for how to resolve the issue.
     **Maximum length**: 500 characters
     **Format**: Alphanumeric characters, spaces, and common punctuation
  """
  errorMessage: String!
  """
  This array returns the unique identifier(s) of the item(s) that failed to be added to the user's Watchlist, along with the reason each failed.
  """
  failedItems: [WatchListAddFailure!]!
  """The current total number of items in the user's Watchlist."""
  watchListCount: Int!
  """The maximum number of items allowed in the user's Watchlist."""
  watchListMaximum: Int!
}

"""
The base request type for the **addToWatchList** mutation. This container specifies the items to be added to a user's Watchlist.
"""
input AddToWatchListInput {
  """
  An array of items to be added to the user's Watchlist.
  **Note:** This array must contain at least one item.
  """
  itemsToAdd: [WatchListEntryToAdd!]!
}

"""
The union type for the **addToWatchList** mutation. This type covers three possible scenarios: success, partial failure, or failure. If the **addToWatchList** mutation succeeds, the specified items will be successfully added to the user's Watchlist. If the **addToWatchList** mutation fails or partially fails, an array of blocking errors detailing why each item failed will be returned, and the item(s) will not be added to the user's Watchlist. If a mutation fails, there will always be at least one blocking error.
"""
union AddToWatchListOutput = AddToWatchListFailure | AddToWatchListPartialFailure | AddToWatchListSuccess

"""
This type indicates that the **addToWatchList** mutation partially failed. Some of the specified items were successfully added to the user's Watchlist, but one or more failed to be added. The unique identifier of each item that was successfully added to the Watchlist is returned. In addition, the unique identifier of each item that failed to be added to the Watchlist is returned, alongside the reason each failed. This type also returns the total number of items being watched by the user after the partially failed mutation and the maximum number of items they can add to their Watchlist.
"""
type AddToWatchListPartialFailure implements BusinessError {
  """
  This array returns the unique identifier(s) of the item(s) that were successfully added to the user's Watchlist.
  """
  addedItems: [Item!]!
  """
  A unique identifier for this specific business error type. This code can be used by clients to programmatically identify and handle different types of errors without relying on error messages, which may change over time. Each error type will always return the same **errorCode** value.
  **Note**: This field will always return 'WTCHL_PARTIAL_FAILURE' in this context.
     **Maximum length**: 40 characters
     **Format**: Alphanumeric characters and underscores, in UPPER_CASE format
  """
  errorCode: String!
  """
  A human-readable message describing the error. This message is intended for developers and should not be displayed directly to end users. It provides additional context about what went wrong and may include suggestions for how to resolve the issue.
     **Maximum length**: 500 characters
     **Format**: Alphanumeric characters, spaces, and common punctuation
  """
  errorMessage: String!
  """
  This array returns the unique identifier(s) of the item(s) that failed to be added to the user's Watchlist, along with the reason each failed.
  """
  failedItems: [WatchListAddFailure!]!
  """The current total number of items in the user's Watchlist."""
  watchListCount: Int!
  """The maximum number of items allowed in the user's Watchlist."""
  watchListMaximum: Int!
}

"""
This type indicates that the **addToWatchList** mutation succeeded, and all requested items were successfully added to a user's Watchlist. The unique identifier of each item that was successfully added to the Watchlist is returned. This type also returns the total number of items being watched by the user after the successful mutation and the maximum number of items they can add to their Watchlist.
"""
type AddToWatchListSuccess {
  """
  This array returns the unique identifier(s) of the item(s) successfully added to the user's Watchlist.
  """
  addedItems: [Item!]!
  """The current total number of items in the user's Watchlist."""
  watchListCount: Int!
  """The maximum number of items allowed in the user's Watchlist"""
  watchListMaximum: Int!
}

"""
This type represents the monetary amount of an item, listing, offer, etc.
"""
type Amount {
  """
  A three-letter ISO 4217 code that indicates the currency of the amount in the **value** field.
  """
  currency: CurrencyAlpha3Code
  """
  The monetary amount, in the currency specified by the **currency** field.
  """
  value: Decimal!
}

"""
This input type is used to represent the monetary price of an item, listing, offer, etc.
"""
input AmountInput {
  """
  A three-letter ISO 4217 code that indicates the currency of the amount in the **value** field.
  """
  currency: CurrencyAlpha3Code!
  """
  The monetary amount, in the currency specified by the **currency** field.
  """
  value: Decimal!
}

"""
This type is used to provide a monetary amount in two different currencies. This might be needed if the buyer's and/or seller's currency is different than the currency used on the listing marketplace. 
"""
type AmountSet {
  """
  This enumeration value indicates that the monetary amount shown in the **exchangeScenarioByName** container is in the buyer's or seller's currency.
  """
  exchangeScenario(scenario: ExchangeAmountScenario!): ExchangeScenarioResult
  """
  The monetary amount converted to a different currency, such as the buyer's or seller's currency.
  """
  exchangeScenarioByName(scenario: String!): ExchangeScenarioResult
  """The monetary amount in its original currency."""
  original: Amount!
}

"""
This input type defines the payload for the **appendSellerReturnResponseRule** mutation which is used to create a single return-to-address rule. The status of new rule will be `ENABLED` by default.
"""
input AppendSellerReturnResponseRuleInput {
  """This object provides business conditions that trigger the rule."""
  conditionSet: ReturnRuleConditionSetInput!
  """
  This enumerated value is the marketplace where the item is **listed/published** (for example, EBAY_US, EBAY_DE, EBAY_UK). All listings published on this marketplace inherit these preferences.
  """
  listingMarketplace: ListingMarketplace!
  """
  The unique name of the rule.
    
  **Requirements:**
  - the name must be unique. No two rules can have the same name.
  - the name must use characters fromteh following set: [A-Z, a-z, 0-9, hyphen(-), underscore(_), period(.), colon(:), comma(,), apostrophe(')]
    
  **Format:** Alphanumeric
  **Maximum length:** 100 characters
  """
  name: String!
  """
  This enumerated values indicates the type of the automation return rule response strategy.
  """
  responseStrategy: ReturnResponseStrategyInput!
}

"""
This base response union type for the **appendSellerReturnResponseRule** mutation indicates whether the seller's return-respond rule was successfully created, or if an error occurred that prevented its creation. The new rule is assigned a priority value one higher than the current highest numbered priority rule (this is assigned the lowest priority). It returns an error if:
- the rule name already exists for this seller/listing marketplace combination
- the maximum rule limit exceeded for this seller
- invalid condition data provided (categories are not leaf IDs, invalid country codes, or an invalid **refundRange** where the minimum is less than maximum)
- the rule name violates constraints (for example, exceeds maximum length or contains disallowed characters)
- the return rules feature is not enabled for the seller
"""
union AppendSellerReturnResponseRuleOutput = ReturnResponseRule | ReturnRuleFeatureNotEnabledError | ReturnRuleInvalidConditionsError | ReturnRuleLimitExceededError | ReturnRuleMissingConditionError | ReturnRuleNameError

"""
This input type defines the payload for the **appendSellerReturnToAddressRule** mutation and is used to create a single return location rule. The status of new rule will be `ENABLED` by default.

**Note:** Any *ReturnToAddress* rules must include **returnAddressRoute**.
"""
input AppendSellerReturnToAddressRuleInput {
  """The address routing strategy for returns."""
  addressRoute: ReturnToAddressRouteInput!
  """This object provides business conditions that trigger the rule."""
  conditionSet: ReturnRuleConditionSetInput!
  """
  This enumerated value is the marketplace where the item is listed or published (for example, EBAY_US, EBAY_DE, EBAY_UK). All listings published on this marketplace inherit these preferences.
  """
  listingMarketplace: ListingMarketplace!
  """
  The unique name of the rule.
    
  **Requirements:**
  - the name must be unique. No two rules can have the same name.
  - the name must use characters fromteh following set: [A-Z, a-z, 0-9, hyphen(-), underscore(_), period(.), colon(:), comma(,), apostrophe(')]
    
  **Format:** Alphanumeric
  **Maximum length:** 100 characters
  """
  name: String!
}

"""
This base response union type for the **appendSellerReturnToAddressRule** mutation indicates whether the return-respond automation rule was successfully created or if an error occurred that prevented its creation. If other return-respond rules already exist, the new rule is appended to the end of the list with the lowest priority (is evaluated after all existing enabled rules). It returns an error if:
- the provided `rule name` is already used by another rule on the same marketplace
- adding this rule would exceed the configured maximum number of allowed rules
- the provided `returnRuleConditionSet` contains invalid condition data (for example, categories not leaf IDs, invalid country code,  or an invalid **refundRange** where the minimum is less than maximum)
- the `name` violates allowed format, length, or character constraints (exceeds 100 characters or includes disallowed characters)
- the provided `ruleResponseStrategy` is invalid
- the return rules feature is not enabled for the seller
"""
union AppendSellerReturnToAddressRuleOutput = ReturnRuleFeatureNotEnabledError | ReturnRuleInvalidConditionsError | ReturnRuleLimitExceededError | ReturnRuleMissingConditionError | ReturnRuleNameError | ReturnToAddressRequiredError | ReturnToAddressRule | ReturnToAddressValidationError

"""This type is used to identify Apple Pay as the payment method."""
type ApplePay implements PaymentMethodType {
  """The unique identifier of Apple Pay."""
  code: ID!
  """The descriptive name of the Apple Pay payment method."""
  descriptiveName: String!
  """The display name of the Apple Pay payment method."""
  displayName: String!
}

"""
This type, available for the seller, is used to approve cancellation action on the contract.
"""
type ApproveContractCancellationAction implements ContractCancellationAction {
  """
  The machine-readable cancellation action code for this use case. For this type, the value is `APPROVE`.
  """
  code: String!
  """
  A human-readable message explaining the cancellation action code. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This input type defines the payload for the **approveContractCancellation** mutation. It specifies the contract cancellation to approve and optionally relists all items.
"""
input ApproveContractCancellationInput {
  """ The ID of the contract cancellation to approve."""
  cancellationId: ID!
  """
  Whether to relist all items from the canceled purchase quote.
    
  **Note:** Must be `false` if the **contractCancellationReason** from the create mutation used (for example,  **CreateOrderCancellationInput**) was set to `OUT_OF_STOCK`.
    
  **Default:** `false`
  """
  relistAllItems: Boolean! = false
}

"""
This union type defines the response payload for the **approveContractCancellation** mutation. On success, the response includes a **ApproveContractCancellationSuccess** type object; on failure it returns an error indicating the reason that the cancellation failed.

**Note:** Additional types may be added to this union in the future; clients should handle unrecognized types gracefully.
"""
union ApproveContractCancellationOutput = ApproveContractCancellationSuccess | ContractCancellationActionNotPermittedError | ContractCancellationNotFoundError | RefundAuthorizationFailedError | RefundBlockedByPaymentDisputeError | RefundInstrumentDeclinedError | RefundInstrumentInsufficientFundsError | RefundInstrumentInvalidError | RefundProcessingError

"""
This type is returned when a contract cancellation has been successfully approved. It includes the cancellation ID and other cancellation details. 
"""
type ApproveContractCancellationSuccess {
  """The successfully approved contract cancellation."""
  contractCancellation: ContractCancellation!
}

"""This action type is used by a seller approving a return request."""
type ApproveReturnAction implements ReturnAction {
  """A machine-readable return action code: `APPROVE_RETURN`"""
  code: String!
  """
  Human-readable text for approval of the return. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This input type defines the payload for the **approveReturn** mutation, which allows the seller to approve a return. In order to use this mutation, the user must have permission to access and approve the specified return.
"""
input ApproveReturnInput {
  """
  An optional message from the seller to the buyer regarding the overall approval. The message is stored as provided and not localized.
    
  **Minimum length:** 1 character
  **Maximum length:** 500 characters
  """
  approvalNote: String
  """
  The unique identifier of the Return to approve. This must be a valid return request that the user has permission to access and approve.
  """
  returnId: ID!
}

"""
This error type indicates that one or more validation errors occurred while approving the return request.
"""
type ApproveReturnInputValidationError implements BusinessError {
  """A machine-readable error code: `RTRN_APPROVE_VALIDATION_ERROR.`"""
  errorCode: String!
  """
  A human-readable error message describing the issue. 
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  This array contains details about one or more specific request violations.
  """
  violations: [ApproveReturnInputViolation!]!
}

"""
This interface describes validation errors encountered during approve-return evaluation. Each violation indicates that an input value failed to meet business rules or constraints for approving a return (for example, exceeding the maximum allowed characters for an approval note). Constraints are defined by eBay return policies and may vary by context, marketplace, or configuration.
"""
interface ApproveReturnInputViolation {
  """
  A machine-readable code that identifies the specific approve-return input violation.
  """
  code: String!
  """
  A human-readable message describing the approve return input violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
}

"""
This base response union type for the **approveReturn** mutation includes the result of the mutation and any errors encountered.
"""
union ApproveReturnOutput = ApproveReturnInputValidationError | OrderReturn | ReturnActionNotPermittedError | ReturnNotFoundError

"""
This input type defines the payload for the **attachReturnShipmentLabel** mutation is used to attach label for the return shipment.
"""
input AttachReturnShipmentLabelInput {
  """
  The unique identifier of the Return for which the shipping label information is being provided. This must be a valid return ID that the user has permission to access.
  """
  returnId: ID!
  """
  This field is used to provide a return shipment label for the return shipment.
  """
  returnShipmentLabels: [ReturnShipmentLabelInput!]!
}

"""
This error type indicates that one or more validation errors occurred while attaching the return shipment label.
"""
type AttachReturnShipmentLabelInputValidationError implements BusinessError {
  """A machine-readable error code: `RTRN_ATTACH_LABEL_VALIDATION_ERROR`"""
  errorCode: String!
  """
  A human-readable error message describing the issue.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  This array contains details about one or more specific request violations.
  """
  violations: [AttachReturnShipmentLabelInputViolation!]!
}

"""
This interface represents input violations detected during attach return shipment label request evaluation. Each violation indicates that the provided input value did not comply with the business rules or constraints defined for attaching return shipment label. These rules may include:
- maximum allowed characters for tracking number and carrier name
- accepted values or codes for tracking number
- duplicate tracking number is not allowed
Such constraints are governed by eBay's return policies, and may vary based on context, marketplace, or configuration.
"""
interface AttachReturnShipmentLabelInputViolation {
  """
  A machine-readable code identifying the specific attach return shipment label input violation.
  """
  code: String!
  """
  A human-readable message describing the attach return shipment label input violation. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  displayMessage: String!
}

"""
This base response union type for the **attachReturnShipmentLabel** mutation attaches an uploaded label to the return.
"""
union AttachReturnShipmentLabelOutput = AttachReturnShipmentLabelInputValidationError | MultipleReturnLabelsNotSupportedError | OrderReturn | ReturnActionNotPermittedError | ReturnNotFoundError | ReturnShipmentLabelNotFoundError | ReturnShippingLabelRequiredError

"""Auction information for an item."""
type AuctionData {
  """
  Displays a list of active bids for an auction.
  paginationInput: Pagination input
  """
  activeBidHistoryRecords(paginationInput: PageInfoInput): BidHistoryRecordsPaginated! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.auction.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.auction.read&eBayUser"])
  """
  Provides statistical data related to user-submitted bids for an auction.
  
  **Note:**: This field excludes data related to automatic, system-generated bids.
  """
  bidStatistics: BidStatistics
  """
  Bid and bidder information when bids exist for an auction.
  If no bids have been placed, this will provide the necessary details for submitting the next bid.
  """
  bidderAuctionDetails: BidderAuctionDetails!
  """
  Displays a list of cancelled bids for an auction.
  paginationInput: Pagination input
  """
  cancelledBidHistoryRecords(paginationInput: PageInfoInput): BidHistoryRecordsPaginated! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.auction.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.auction.read&eBayUser"])
  """
  Item reference for the requested auction item. The reference can be null for invalid items.
  """
  item: Item
  """
  The current highest bid in the active or recently-completed auction listing. The leading bid may or may not belong to the user who has issued this query. The user who is issuing this call can review what their maximum bid amount is by looking at the value stored in **bidderAuctionDetails**.
  """
  leadingBid: BidRecord
  """
  Bid and bidder information when bids exist for an auction.
  If no bids have been placed, this will provide the necessary details for submitting the next bid.
  true - seller set reserve price for the auction has been met.
  false - seller set reserve price for the auction has not been met.
  null - auction has no reserve price.
  """
  reservePriceMet: Boolean
  """
  Displays a list of retracted bids for an auction.
  paginationInput: Pagination input
  """
  retractedBidHistoryRecords(paginationInput: PageInfoInput): BidHistoryRecordsPaginated! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.auction.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.auction.read&eBayUser"])
}

"""Auction information for an item."""
type AuctionDataSummary {
  """
  Provides statistical data related to user-submitted bids for an auction.
  
  **Note:**: This field excludes data related to automatic, system-generated bids.
  """
  bidStatistics: BidStatistics!
  """
  This container returns information about the user's bidding activity on the corresponding item.
  
  **Note:** If no bids have been placed yet for the auction, the qualifying bid amount that must be met or exceeded by the user to place the initial bid will be returned.
  """
  bidderAuctionDetails: BidderAuctionDetails!
  """
  This is the unique identifier of the auction listing for which bidding activity information is being retrieved. This auction listing can be active or recently ended.
  """
  itemId: ID!
  """
  The current highest bid in the active or recently-completed auction listing. The leading bid may or may not belong to the user who has issued this query. The user who is issuing this call can review what their maximum bid amount is by looking at the value stored in **bidderAuctionDetails**.
  """
  leadingBid: BidRecord
  """
  This field indicates if the seller-specified Reserve Price for the auction has been met. If the seller's Reserve Price has not been met by the time the auction ends, there will be no winning bidder.
  
  Possible return values and what they indicate are listed below:
  - true: Reserve Price for the item has been met.
  - false: Reserve Price for the item has not been met.
  - null: A Reserve Price for the item has not been set.
  """
  reservePriceMet: Boolean
}

"""
This type contains details about the authentication verification inspection addon service associated with an order line item.
"""
type AuthenticityVerificationAddOnService {
  """
  The cost of the authenticity verification service. This field may be null if it is not available.
  """
  serviceCost: AmountSet
  """
  The current state of authenticity verification. This field may be null if not started.
  """
  verificationState: AuthenticityVerificationState
}

"""This type indicates that the authenticity verification has failed."""
type AuthenticityVerificationFailed implements Labeled {
  """A human-readable label representing this state. Value: `Failed`."""
  label: String!
}

"""
This type indicates that the authenticity verification has passed successfully.
"""
type AuthenticityVerificationPassed implements Labeled {
  """
  There may be legal or policy constraints that prevent the item from being labeled as fully authentic (for example, regulatory restrictions, brand rights, or compliance requirements). When `true`, the item has been verified as authentic but cannot be publicly marked or displayed as such.
  """
  hasException: Boolean!
  """
  When `true`, this field indicates that the verification passed overall, but one or more checks had non-critical issues or incomplete validations (for example, a missing accessory, minor deviation from factory standards, or unverifiable subcomponent). The item is still considered authentic, and the verification report documents these partial failure details for transparency.
  """
  hasPartialFailure: Boolean!
  """A human-readable label representing this state. Value: `Passed`."""
  label: String!
}

"""
This union type represents the current authenticity verification state of an order line item.
"""
union AuthenticityVerificationState = AuthenticityVerificationFailed | AuthenticityVerificationPassed

"""
This type is used to indicate that an auto payment has been successfully completed.
"""
type AutoPaymentCompleted implements Labeled {
  """
  The human-readable label representing this state.
  **Maximum length**: 100 characters.
  """
  label: String!
}

"""
This type is used to indicate that an auto payment has failed to process.
"""
type AutoPaymentFailed implements Labeled {
  """
  The human-readable label representing this state.
  **Maximum length**: 100 characters.
  """
  label: String!
}

"""This type is used to indicate that an auto payment is scheduled."""
type AutoPaymentScheduled implements Labeled {
  """
  The human-readable label representing this state.
  **Maximum length**: 100 characters.
  """
  label: String!
}

"""
This type shows detailed information related to automated payment scheduling for an item commitment, including whether it's required, delayed, and when it's scheduled.
"""
type AutoPaymentScheduleDetails {
  """
  This boolean field indicates whether this item commitment must be processed using auto payment. If 'true', the item commitment is required to be processed automatically. If 'false', the item commitment can be handled through other payment methods and is not mandated for auto payment.
  """
  autoPaymentRequired: Boolean!
  """
  The current state of the auto payment process for this item commitment.
  """
  autoPaymentState: AutoPaymentState!
  """
  If applicable, this field provides the reason why the auto payment for this item commitment is delayed.
  """
  delayReason: ID
  """
  This timestamp indicates the date and time when auto payment for this item commitment is scheduled to be processed automatically.
  """
  processingScheduledAt: DateTime!
}

"""This union type is used to indicate the state of an auto payment."""
union AutoPaymentState = AutoPaymentCompleted | AutoPaymentFailed | AutoPaymentScheduled

"""
This type represents actions the user can take for a specific return. The actions include the primary response action (such as approve or provide label), and any additional context-dependent actions (such as message seller or update address). Actions available depend on the current state of the return and the user's role.
"""
type AvailableReturnActions {
  """
  The primary action that the user is expected to take, including the due date for completing the action. This field is present if an action is required from the user.
  """
  respondByAction: ReturnRespondByAction
  """
  A list of one or more optional or supplementary actions the user can take in addition to the primary response.
  """
  secondaryActions: [ReturnAction!]
}

"""
This type indicates that the return shipment cannot begin because its missing required fulfillment details (for example, return label, RMA number, or seller-provided instructions). The responsible actor, usually the seller or platform, must provide these details before the shipment can proceed.
"""
type AwaitingReturnFulfillmentDetails implements ReturnFulfillmentStatus {
  """
  This field contains an enumerated value that indicates the actor responsible for providing the missing fulfillment details. Typical values: 'SELLER', 'EBAY', 'BUYER'.
  """
  actionDueFrom: PostPurchaseActorRole!
  """
  A machine-readable code identifying the return fulfillment status.
    
  **Format:** Alphanumeric with underscores
  **Maximum length:** 512 characters
  """
  code: String!
  """
  A human-readable label identifying the return fulfillment status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type indicates that all required shipment details are available and the return is ready to be initiated. The sender (usually the buyer) must now take action to start the shipment, such as printing the label or scheduling a pickup.
"""
type AwaitingReturnFulfillmentInitiation implements ReturnFulfillmentStatus {
  """
  This field contains an enumerated value that indicates the actor responsible for providing the missing fulfillment details. Typical values: 'EBAY', 'BUYER'.
  """
  actionDueFrom: PostPurchaseActorRole!
  """
  A machine-readable code identifying the return fulfillment status.
    
  **Format:** Alphanumeric with underscores
  **Maximum length:** 512 characters
  """
  code: String!
  """
  A human-readable label identifying the return fulfillment status. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type is used to show if the seller has enabled the Best Offer feature for the listing, and if Best Offer is enabled, the auto-accept and auto-decline Best Offer price thresholds if the seller has set either of these thresholds.
"""
type BestOfferTerms {
  """
  This boolean field indicates whether or not the Best Offer feature is enabled for the listing. For auction listings, note that the Buy it Now feature is disabled as soon as an auction listing gets a qualifying bid, and all pending Best Offers or counteroffers become invalid.
  """
  acceptBestOffer: Boolean
  """
  The price at which Best Offers will be automatically accepted by the seller if they meet or exceed the price. Auto-accept is an optional feature for the seller.
  **Note**: This container is only accessible to the seller of this listing
  """
  autoAcceptThresholdAmount: ConvertedAmount
  """
  The price at which Best Offers will be automatically declined by the seller if they are equal to or below the price. Auto-decline is an optional feature for the seller.
  **Note**: This container is only accessible to the seller of this listing
  """
  autoDeclineThresholdAmount: ConvertedAmount
}

"""
Type used to aggregate data related to a bidder's involvement in an auction item. This type is emitted for any logged in user viewing an auction item, regardless of whether they have participated in it or not. Some fields may be null if the user has not placed a bid on the auction item.
"""
type BidderAuctionDetails {
  """
  The current user's maximum bid price on this auction.
  
  A `null` value for this field indicates that the current user has not yet placed a bid on this auction.
  """
  maxBid: ConvertedAmount
  """
  The minimum amount the `bidder` needs to place to have a valid bid on this auction item.
  
  **Note:** This minimum-to-bid calculation considers only confirmed bids on the auction.
  """
  minimumQualifyingBidForMaxBid: ConvertedAmount!
  """
  Status of the user's recent bid on this auction. This will be `null` if the user has not placed a bid on this auction.
  """
  userBiddingStatus: BidStatus
  """
  List of suggested bids to display to the `bidder` based on the current auction price.
  """
  userPowerBids: [ConvertedAmount!]!
}

"""Filters to refine and display a user's bidding activity history."""
input BiddingActivityFilter {
  """
  When used in conjunction with `activeBefore`, the **userBiddingActivity** query returns a list of items for which the user has placed bid that have end dates **on or after** this timestamp.
  
  **Note:** If `activeAfter` is not defined, it defaults to the 90 days before the current date.
  
  If both `activeAfter` and `activeBefore` are omitted, by default the query will return a list of items for which the user has placed a bid within the prior 90-day period that ends when the query is issued.
  
  This window can be adjusted to last 10 days to fetch items ending within the next 10 days. This will include all active items with some completed items.
  """
  activeAfter: DateTime
  """
  When used in conjunction with `activeAfter`, the **userBiddingActivity** query returns a list of items for which the user has placed bid that have end dates **on or before** this timestamp.
  
  **Note:** If `activeBefore` is not defined, it defaults to the current date.
  
  If both `activeAfter` and `activeBefore` are omitted, by default the query will return a list of items for which the user has placed a bid within the prior 90-day period that ends when the query is issued.
  
  This window can be adjusted to last 10 days to fetch items ending within the next 10 days. This will include all active items with some completed items.
  """
  activeBefore: DateTime
  """
  Specifies the maximum number of items displayed on a page when retrieving bidding activity history.
  - Maximum page size: 20 items per request
  - Minimum page size: 1 item per request
  
  By default, when this parameter is omitted, the `userBiddingActivity` query returns the first 20 results.
  """
  paginationInput: PageInfoInput = {maxPageSize: 20}
}

"""
Represents a list of bid history records (active, cancelled, or retracted,) along with pagination.
"""
type BidHistoryRecordsPaginated {
  """List of bid history records (active, cancelled or retracted)"""
  bidHistoryRecords: [BidRecord!]!
  """PaginationOutput Null represents no pages available."""
  paginationOutput: Pagination
}

"""An interface representing data about a bid."""
interface BidMetadata {
  """
  The date and time, expressed in UTC, when the bid was placed.
  
  **Format:** YYYY-MM-DDTHH:MM:SS.SSSZ
  """
  placedAt: DateTime!
}

"""
Each `BidRecord` stores information about one bid on an item. Stored information includes bid amount, the user id of the bidder associated with the bid, and the time the bid was placed.
"""
type BidRecord {
  """
  Indicates the calculated bid value. This is derived from the original bid amount and adjusted according to the auction style or other business logic. This only contains the base amount for the bid without any user context.
  """
  bidAmount: ConvertedAmount!
  """
  Represents metadata for the BidRecord, encapsulating things such as the date the bid was placed.
  """
  bidMetadata: BidMetadata!
  """The user who has placed the bid."""
  bidder: User!
  """Provides bidding details of the bidder over a period of 30 days."""
  buyerBiddingSummary: BuyerBiddingSummary!
}

"""
The BidStatistics type offers insights into the bidding activity associated with an auction item.
"""
type BidStatistics {
  """
  The total number of bids submitted for the auction item. This value includes all bids placed by users, but excludes bids automatically generated by the system.
  
  **Default Value:** 0
  """
  userSubmittedBidCount: Int!
}

"""
Status representing the buyer's bidding status for the given auction listing.
"""
enum BidStatus {
  """The buyer has been outbid by another bid in this auction listing."""
  OUTBID
  """The buyer has the winning bid in this auction listing."""
  WINNING
}

"""
This output type is used when a **bulkUpdateInventory** mutation fails, and includes the identifiers of the items that failed to be updated and the error associated with the failure.
"""
type BulkUpdateInventoryFailure implements BusinessError {
  """
  This field shows the unique identifier of the error that was triggered, and the value should always be `LSTNG_BULK_UPDATE_INVENTORY_FAILURE_ERROR`.
  """
  errorCode: String!
  """
  An error message providing the reason for the failure. This text will be in English, regardless of the listing marketplace. 
  """
  errorMessage: String!
  """
  This array will include the identifiers of the items that failed to be updated, and will also include the error(s) and any non-blocking warnings that were triggered for any of those items being updated.
  """
  failures: [UpdateInventoryFailure!]!
}

"""
This type is used to update the price and/or quantity of items in fixed price listings. Up to four items can be updated in a single **bulkUpdateInventory** mutation.
"""
input BulkUpdateInventoryInput {
  """
  This array is used to update the price and/or quantity for one to four items in fixed price listings. For each item identified in the array, either the price, the quantity, or both fields must be included. These items can all be separate SKUs in the same multiple-SKU listing, items in four different listings, or a combination of the two. 
  """
  inventory: [UpdateInventoryInput!]!
}

"""
This union type is used to represent the possible outcomes of the **bulkUpdateInventory** mutation.
"""
union BulkUpdateInventoryOutput = BulkUpdateInventoryFailure | BulkUpdateInventoryPartialFailure | BulkUpdateInventorySuccess

"""
This output type is used when a **bulkUpdateInventory** mutation is partially successful, where one or more items were successfully updated, but one or more other items failed to be updated. The **successes** array will show the identifiers of the items that were successfully updated, the **failures** array will show the identifiers of the items that failed to be updated, and the error fields will provide more details on the issue(s) that caused the mutation to only be partially successful. 
"""
type BulkUpdateInventoryPartialFailure implements BusinessError {
  """
  This field shows the unique identifier of the error that was triggered, and the value should always be `LSTNG_BULK_UPDATE_INVENTORY_PARTIAL_FAILURE_ERROR`.
  """
  errorCode: String!
  """
  An error message providing the reason for the partial failure. This text will be in English, regardless of the listing marketplace. 
  """
  errorMessage: String!
  """
  This array will include the identifiers of the items that failed to be updated, and will also include the error(s) and any non-blocking warnings that were triggered for any of those items that failed to be updated.
  """
  failures: [UpdateInventoryFailure!]!
  """
  This array will include the identifiers of the items that were successfully updated, and will also include any non-blocking warnings that were triggered for any of those items that were updated.
  """
  successes: [UpdateInventorySuccess!]!
}

"""
This output type is used when a **bulkUpdateInventory** mutation is successful, and includes the identifiers of the items that were successfully updated. It will also include any non-blocking warnings that were triggered for any of those items, if any.
"""
type BulkUpdateInventorySuccess {
  """
  This array will include the identifiers of the items that were successfully updated, and will also include any non-blocking warnings that were triggered for any of those items being updated.
  """
  successes: [UpdateInventorySuccess!]!
}

"""
This output type is used when a **bulkUpdateItemCommitmentTags** mutation fails completely, and none of the specified item commitments are updated with new custom tags or deleted custom tags. The **failures** array will show the identifiers of the item commitments whose custom tags failed to be updated, and the error fields will provide more details on the issue(s) that caused the mutation to fail.
"""
type BulkUpdateItemCommitmentTagsCompleteFailure implements BusinessError {
  """
  The unique identifier of the error. 
  **Note**: Currently this field will always show UPDATE_ITEM_COMMITMENT_TAGS_COMPLETE_FAILURE.
  """
  errorCode: String!
  """
  The developer-friendly description of the error is shown in this field.
  """
  errorMessage: String!
  """
  This array shows the full list of item commitments that failed to be updated with new custom tags or deleted custom tags.
  """
  failures: [UpdateItemCommitmentError!]!
}

"""
This type is used to add or delete one or more custom tags for up to 100 item commitments.
"""
input BulkUpdateItemCommitmentTagsInput {
  """
  This array is used to add or delete one or more custom tags for up to 100 item commitments.
  **Max items**: 100
  """
  itemCommitmentTagUpdates: [UpdateItemCommitmentTagInput!]!
}

"""
This union type is used to represent the possible outcomes of the **bulkUpdateItemCommitmentTags** mutation. 
"""
union BulkUpdateItemCommitmentTagsOutput = BulkUpdateItemCommitmentTagsCompleteFailure | BulkUpdateItemCommitmentTagsPartialFailure | BulkUpdateItemCommitmentTagsSuccess

"""
This output type is used when a **bulkUpdateItemCommitmentTags** mutation is partially successful, where one or more specified custom tags operations in one or more item commitments were successfully performed, but one or more other specified custom tags operations in one or more item commitments failed. The **updatedItemCommitments** array will display all item commitments whose custom tags were updated, the **failures** array will show the identifiers of the item commitments whose custom tags failed to be updated, and the error fields will provide more details on the issue(s) that caused the mutation to only be partially successful.
"""
type BulkUpdateItemCommitmentTagsPartialFailure implements BusinessError {
  """
  The unique identifier of the error. 
  **Note**: Currently this field will always show UPDATE_ITEM_COMMITMENT_TAGS_PARTIAL_FAILURE.
  """
  errorCode: String!
  """
  The developer-friendly description of the error is shown in this field.
  """
  errorMessage: String!
  """
  This array shows the full list of item commitments that failed to be updated with new custom tags or deleted custom tags.
  """
  failures: [UpdateItemCommitmentError!]!
  """
  This array shows the full list of item commitments that were successfully updated with new custom tags or deleted custom tags.
  """
  updatedItemCommitments: [ItemCommitment!]!
}

"""
This output type is used when a **bulkUpdateItemCommitmentTags** mutation when all specified custom tags operations in all item commitments were successfully performed, and displays detailed information on each of the updated item commitments. 
"""
type BulkUpdateItemCommitmentTagsSuccess {
  """
  This array shows the full list of item commitments that were successfully updated with new custom tags or deleted custom tags.
  """
  updatedItemCommitments: [ItemCommitment!]!
}

"""
This type represents a complete failure for a **bulkUpdateOrderTags** mutation. The return includes the orders that could not be updated with the tags specified in the request.

**Note:** No order's tag was successfully updated.
"""
type BulkUpdateOrderTagsCompleteFailure implements BusinessError {
  """
  The machine-readable error code for this business error. Value: `UPDATE_ORDER_TAGS_COMPLETE_FAILURE`.
  """
  errorCode: String!
  """
  A human-readable description of the error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  This array lists one or more orders that could not be updated.
    
  **Note:** This list is never empty.
  """
  failures: [UpdateOrderError!]!
}

"""
The base request type for the **bulkUpdateOrderTags** mutation is used to update order tags.
"""
input BulkUpdateOrderTagsInput {
  """The list of individual input."""
  updates: [UpdateOrderTagInput!]!
}

"""
This base response union type for the **bulkUpdateOrderTags** mutation returns those orders successfully updated and those that failed.
"""
union BulkUpdateOrderTagsOutput = BulkUpdateOrderTagsCompleteFailure | BulkUpdateOrderTagsPartialFailure | BulkUpdateOrderTagsSuccess

"""
This type represents a partial success and partial failure for a **bulkUpdateOrderTags** mutation. The return includes both the orders that that tags were successfully updated and those that could not be updated with the tags specified in the request.
"""
type BulkUpdateOrderTagsPartialFailure implements BusinessError {
  """
  The machine-readable error code for this business error. Value: `UPDATE_ORDER_TAGS_PARTIAL_FAILURE`.
  """
  errorCode: String!
  """
  A human-readable description of the error message. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 512 characters
  """
  errorMessage: String!
  """
  This array lists one or more orders that could not be updated.
    
  **Note:** This list is never empty.
  """
  failures: [UpdateOrderError!]!
  """List of orders successfully updated (may be empty)."""
  updatedOrders: [Order!]!
}

"""
This type indicates a successful **bulkUpdateOrderTags** mutation with all orders submitted successfully updated with the tags specified in the request.
"""
type BulkUpdateOrderTagsSuccess {
  """
  A list of one or more orders successfully updated with the specified tags.
  """
  updatedOrders: [Order!]!
}

"""
This output type is used when a **bulkUpdatePurchaseQuotes** mutation fails, and none of the purchase quotes were successfully updated. The **failures** array will show the identifiers of the purchase quotes that failed to be updated, and the error fields will provide more details on the issue(s) that caused the mutation to fail.
"""
type BulkUpdatePurchaseQuotesCompleteFailure implements BusinessError {
  """
  The unique identifier of the error. 
  **Note**: Currently this field will always show UPDATE_QUOTES_COMPLETE_FAILURE.
  """
  errorCode: String!
  """
  The developer-friendly description of the error is shown in this field.
  """
  errorMessage: String!
  """
  This array contains the unique identifiers of all purchase quotes that were not successully updated, and the error(s) that caused them not to be updated.
  """
  failures: [UpdatePurchaseQuoteError!]!
}

"""
The base input type used for the **bulkUpdatePurchaseQuotes** mutation.
"""
input BulkUpdatePurchaseQuotesInput {
  """
  This array is used to provide updates on up to 100 purchase quotes.   
  **Note**: A separate node is required for each purchase quote being updated.
  """
  updates: [UpdatePurchaseQuoteInput!]!
}

"""
This union type is used to represent the possible outcomes of the **bulkUpdatePurchaseQuotes** mutation.
"""
union BulkUpdatePurchaseQuotesOutput = BulkUpdatePurchaseQuotesCompleteFailure | BulkUpdatePurchaseQuotesPartialFailure | BulkUpdatePurchaseQuotesSuccess

"""
This output type is used when a **bulkUpdatePurchaseQuotes** mutation is partially successful, where one or more purchase quotes are successfully updated, but one or more other purchase quotes failed to be updated. The **updatedPurchaseQuotes** array will display all purchase quotes that were successfully updated, the **failures** array will show the identifiers of the purchase quotes that failed to be updated (and the error(s) that led to failure), and the error fields will provide more details on the issue(s) that caused the mutation to only be partially successful.
"""
type BulkUpdatePurchaseQuotesPartialFailure implements BusinessError {
  """
  The unique identifier of the error. 
  **Note**: Currently this field will always show UPDATE_QUOTES_PARTIAL_FAILURE.
  """
  errorCode: String!
  """
  The developer-friendly description of the error is shown in this field.
  """
  errorMessage: String!
  """
  This array contains the unique identifiers of all purchase quotes that were not updated successfully, and the error(s) that caused them not to be updated.
  **Note**: There will always be at one object in this array.
  """
  failures: [UpdatePurchaseQuoteError!]!
  """
  This array contains all of the successfully updated purchase quotes.
  **Note**: There will always be at one object in this array.
  """
  updatedPurchaseQuotes: [PurchaseQuote!]!
}

"""
This output type is used when a **bulkUpdatePurchaseQuotes** mutation is successful and all purchase quotes are successfully updated. 
"""
type BulkUpdatePurchaseQuotesSuccess {
  """This array contains all of the successfully updated purchase quotes."""
  updatedPurchaseQuotes: [PurchaseQuote!]!
}

"""
This type shows the street address for a business entity such as the product manufacturer or responsible person.
"""
type BusinessEntityAddress {
  """The first line of the entity's street address."""
  addressLine1: String
  """
  The second line of the entity's street address. This field is not always used, but can be used for secondary address information such as 'Suite Number' or 'Apt Number'.
  """
  addressLine2: String
  """The city of the entity's street address."""
  city: String
  """
  The two-letter ISO 3166-1 standard abbreviation of the country of the entity's address.
  """
  country: CountryAlpha2Code
  """The postal code of the entity's street address."""
  postalCode: String
  """The state or province of the entity's street address."""
  stateOrProvince: String
}

"""
This type shows the contact information of a product manufacturer or an EU Responsible Person, and this information includes an email address, a phone number, and/or a contact URL. At least one of the three forms of contact for a product manufacturer or an EU Responsible Person must be provided.
"""
type BusinessEntityContact {
  """This field shows the entity's contact/support URL."""
  contactUrl: HttpOrHttpsUrl
  """This field shows the entity's email address."""
  email: String
  """This field shows the entity's phone number."""
  phone: String
}

"""
The base interface used for all business errors. Business errors are errors that may occur during normal API operations due to business logic errors such as validation failures or resource not found scenarios. All business error types implement this interface to provide consistent error handling across the API.
"""
interface BusinessError {
  """
  The unique identifier of the specific error. This code can be used by clients to programmatically identify and handle different types of errors without relying on error messages, which may change over time. 
  **Maximum length**: 40 characters
  **Format**: Alphanumeric characters and underscores, in UPPER_CASE format
  """
  errorCode: String!
}

"""Business related information of a seller."""
type BusinessIdentityProfile {
  """
  The email address of the business.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  businessEmail: String
  """
  The name of the business.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  businessName: String
  """
  The primary telephone number of the business.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  businessPrimaryPhone: Phone
  """
  The physical address of the business.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  businessProfileAddress: ProfileAddress
}

"""
This type represents a seller-defined business policy (payment, shipping, or return). A business policy contains information on one policy, with the specific policy information contained in **policyDetails**.
"""
type BusinessPolicy {
  """The unique ID of the business policy."""
  businessPolicyId: ID!
  """
  A seller-defined description of the return business policy. This description is only for the seller's use, and is not exposed on any eBay pages. This can be null when no description was provided during policy creation. 
  
  **Maximum length:** 250 characters
  **Occurrence:** Conditional 
  """
  description: String
  """
  This enumerated value indicates the marketplace where this business policy applies. This field returns null when marketplace information is not available.
  """
  marketplace: BusinessPolicyMarketplace
  """
  A seller-defined name for this return business policy. Names must be unique per site and per type. 
  
  **Maximum length:** 64 characters
  **Occurrence:** Always
  """
  name: String
  """
  Detailed information specific to the kind of business policy (return, shipping, or payment). This field returns null when policy details are not available or cannot be retrieved.
  """
  policyDetails: PolicyDetails
}

"""
This enumerated type contains the values that indicate the different eBay marketplaces.
"""
enum BusinessPolicyMarketplace {
  """This value indicates the applicable marketplace is eBay Austria."""
  EBAY_AT
  """This value indicates the applicable marketplace is eBay Australia."""
  EBAY_AU
  """
  This value indicates the applicable marketplace is Dutch language version of eBay Belgium.
  """
  EBAY_BE
  """
  This value indicates the applicable marketplace is English language version of eBay Canada.
  """
  EBAY_CA
  """This value indicates the applicable marketplace is eBay Switzerland."""
  EBAY_CH
  """This value indicates the applicable marketplace is eBay Germany."""
  EBAY_DE
  """This value indicates the applicable marketplace is eBay Spain."""
  EBAY_ES
  """This value indicates the applicable marketplace is eBay France."""
  EBAY_FR
  """This value indicates the applicable marketplace is eBay UK."""
  EBAY_GB
  """This value indicates the applicable marketplace is eBay Hong Kong."""
  EBAY_HK
  """This value indicates the applicable marketplace is eBay Ireland."""
  EBAY_IE
  """This value indicates the applicable marketplace is eBay Italy."""
  EBAY_IT
  """This value indicates the applicable marketplace is eBay Malaysia."""
  EBAY_MY
  """This value indicates the applicable marketplace is eBay Netherlands."""
  EBAY_NL
  """This value indicates the applicable marketplace is eBay Philippines."""
  EBAY_PH
  """This value indicates the applicable marketplace is eBay Poland."""
  EBAY_PL
  """This value indicates the applicable marketplace is eBay Singapore."""
  EBAY_SG
  """This value indicates the applicable marketplace is eBay US."""
  EBAY_US
}

"""
This type defines deposit requirements for motor vehicle purchases including the deposit amount, when the deposit is due, and the deadline for full payment.
"""
type BusinessPolicyMotorVehicleDepositDetails {
  """
  This container applies to motor vehicles listings only and indicates when the final payment for the vehicle is due. This value indicates the number of days that a buyer has to make their full payment to the seller and close the remaining balance on a motor vehicle transaction. The period starts when the buyer commits to buy. May be null when not applicable or not specified.
  
  The valid values in days: `3` , `7` (default), `10`, `14`
  
  **Default:** `7` days
  **Occurrence:** Conditional
  """
  daysToMakeFullPayment: Int
  """
  This value indicates the initial deposit amount required from the buyer in order to purchase a motor vehicle. This value can be as high as $2,000.00 if immediate payment is not required, and up to $500.00 if immediate payment is required. May be null when no deposit amount is required.
  
  **Maximum:** 2000.00 
  **Occurrence:** Conditional
  """
  depositAmount: ConvertedAmount
  """
  This value indicates the number of hours that the buyer has (after they commit to buy) to pay the initial deposit on a motor vehicle. Valid times are 24, 48, and 72 hours. HOUR is set as the unit value, and 24, 48 or 72 are set in the value field.
  
  If the motor vehicle listing requires immediate payment, this value is overridden and the deposit is due immediately. May be null when immediate payment is required. 
  The valid values in hours: `24` hours, `48` hours (default), `72` hours 
  
  **Default:** 48 hours
  **Occurrence:** Conditional
  """
  hoursToDeposit: Int
}

"""
This type represents a single shipping service option within a seller's shipping policy, including base and additional unit costs, covered ship-to locations, optional packaging and handling fees, offered by the seller to ship an item to a buyer.
"""
type BusinessPolicyShippingServiceDetails {
  """
  The incremental shipping cost per additional unit of the same line item purchased by the same buyer. May be null when not applicable (for example, single-quantity listings or when the service does not charge per-unit increments).
  """
  additionalUnitShippingCost: ConvertedAmount
  """
  The set of ship-to locations supported by this shipping service option. Locations may be countries, regions, states/provinces, or marketplace-defined areas. Supported codes are marketplace-specific and are not localized. If no locations are configured for this service, the list will be empty.
  
  **Note:** The field is typically present, but its list may be empty. This field should not be null unless an error has occurred. See the error section of the response for more details.
  """
  includedShipToLocations: [ShippingLocation!]
  """
  The seller's packaging/handling fee for this shipping service, in addition to carrier charges. May be null  if no handling fee is configured. 
  """
  packageHandlingCost: ConvertedAmount
  """
  The display order ranking for shipping services relative to the other services (lower values appear first) in which the ShippingService appears on the View Item and Checkout page. May be null if no value is set.
  """
  rank: Int
  """
  The base cost of shipping one unit using the shipping service specified in the corresponding Shipping
  Service field.
  """
  shippingCost: ConvertedAmount
  """
  The unique identifier of a shipping service option being offered by the seller to ship an item to a buyer. This is not localized and may not be directly displayed to an end user. This should not be null unless an error has occurred. See the error section of the response for more details.
  """
  shippingServiceOptionCode: ID
}

