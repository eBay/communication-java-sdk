  """
  Human readable text for decline return action. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This input type defines the payload for the **declineReturn** mutation which is used by the sender to decline a return with comments.
"""
input DeclineReturnInput {
