  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

"""
This type defines the business rule error that occurs when an offer is made for a multi SKU item.
"""
type OfferMultiSKUNotAllowed implements OfferBusinessRuleViolation {
  """
  The description of the business rule failure.
