"""
This type defines the details of a specific catalog product such as its title, identifier, product aspects, recommended category, and links to images of the product.
"""
type Product {
  """
  The unique identifier of an eBay catalog product. An ePID value can be used in eBay listing APIs to prefill a listing with product title, product description, product aspects, stock photo(s), and eBay category.
  """
  epid: Epid @deprecated(reason: "This field is deprecated and has been superseded by the **id** field.")
  """
  The unique identifier of an eBay catalog product. An ePID value can be used in eBay listing APIs to prefill a listing with product title, product description, product aspects, stock photo(s), and eBay category.
  """
  id: ID! @deprecated(reason: "Use 'productId' field instead")
  """
  This array returns a list of product aspects and values associated with this catalog product. 
  """
  aspects: [ProductAspect!]!
  """
  This container returns information about the leaf category for which eBay recommends to list this product, based on previous listings of similar products. 
  """
  category: Category!
  """
  This array returns a list of one or more image URLs associated with this catalog product. 
  """
  imageUrls: [String!]
  """The eBay product identifier (ePID) of the product."""
  productId: ID!
  """The title of the catalog product. """
  title: String!
}

"""
This type defines the the product aspect name/value pair(s) associated with a product.
"""
type ProductAspect {
  """
  A list of valid values associated with the product aspect (for example: 'Red', 'Green', and 'Blue').
  """
