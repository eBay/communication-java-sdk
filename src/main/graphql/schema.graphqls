This type is used by multiple types that require a unique identifier and a human-readable name.
"""
type DisplayableId {
  """
  A human-readable name or description.
  **Maximum length**: 100 characters
  """
  displayName: String!
  """A unique identifier."""
  id: ID!
}

"""
This enumeration type defines the supported units for measurement of distance .
"""
enum DistanceUnit {
