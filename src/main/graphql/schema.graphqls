  """
  ruleDescription: String!
}

"""
This type defines the business rule error that occurs when an offer is blocked by a policy violation check.
"""
type OfferPolicyViolationError implements OfferBusinessRuleViolation {
  """
  The unique identifier of the correlation used for tracking the policy violation check failure.
  **Maximum length**: 40 characters
  **Format**: Alphanumeric characters and underscores
  """
  correlationId: String
  """
  An explanatory message of the specific policy violation check blocker.
  **Maximum length**: 100 characters
  """
  policyViolationMessage: String
  """
  If the blocker can be remediated, this field will return a URL that redirects the user to a page explaining how to take remediating action.
  **Format**: URL
  **Maximum length**: 2048 characters
  """
  redirectionUrl: String
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

"""
This type defines the business rule error that occurs when the offer price was greater than the BIN (Buy it now) price.
"""
type OfferPriceGreaterThanBinPrice implements OfferBusinessRuleViolation {
