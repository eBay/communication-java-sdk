- the return rules feature is not enabled for the seller
"""
union UpdateSellerReturnToAddressRulesPrioritiesOutput = ReturnRuleDuplicateRuleIdsError | ReturnRuleFeatureNotEnabledError | ReturnRuleInvalidRuleIdsError | ReturnRuleMissingRuleIdsError | UpdateSellerReturnToAddressRulesPrioritiesSuccess

"""
This type defines the new priority order for the seller's return-to-address automation rules.
"""
type UpdateSellerReturnToAddressRulesPrioritiesSuccess {
