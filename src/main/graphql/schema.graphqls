  listingVariations: ListingVariations
  """
  This field indicates the eBay marketplace where the listing is published and displayed to buyers. Through active and passive international site visibility, it is possible that a listing can be on multiple eBay marketplaces, but the ID in this field indicates the original listing marketplace.
  """
  marketplace: ListingMarketplace
  """
  This container provides product details for the listing, including listing category, product aspects, title, description, item condition, images, and more.
  """
  sellerProduct: SellerProduct
  """
  This field is the seller-defined listing-level Stock Keeping Unit (SKU) value. A listing-level **sku** value is specified by the seller if the seller wishes to identify the listing by SKU value as opposed to **listingId**.
  """
  sku: String
}

