  """
     This array returns a list of the user's saved sellers. Saved sellers are ordered according to the specified sort parameter. If no sort parameters are specified, saved sellers are sorted by the date they were saved with the most recent first.
  **Note**: This array may be empty if the user has no saved sellers.
  """
  savedSellers: [UserSavedSeller!]!
}

"""
This enumerated type defines all available sort options for retrieving a user's saved sellers.
"""
enum UserSavedSellersSort {
  """
  This enum value is used to sort saved sellers in the response according to when the sellers were saved by the user, with the most recently saved appearing first. This is the default sort value used if the sort field is not used.
  """
  DATE_ADDED_DESC
  """
  This enum value is used to sort saved sellers in the response alphabetically according to their eBay username.
  """
  SELLER_NAME_ASC
}

"""This interface represents the status of a user's account."""
interface UserStatus {
  """
  The human-readable label for the user's account status.
     Every account status implementation has a display name under normal circumstances.
     A null response indicates an exceptional circumstance.
     **Note**: This value is for display purposes only.
  """
  displayName: String
}

"""
This type represents an account with the 'AccountOnHold' status. This indicates that the user's account has been put on hold by eBay.
"""
type UserStatusAccountOnHold implements UserStatus {
  """
  The human-readable label for the user's account status. In this case, this field will return 'Account on hold'.
  **Note**: This value is for display purposes only.	
  """
  displayName: String
}

"""
This type represents an account with the 'Confirmed' status. This indicates that the user's account has been verified by eBay.
"""
type UserStatusConfirmed implements UserStatus {
  """
  The human-readable label for the user's account status. In this case, this field will return 'Confirmed'.
  **Note**: This value is for display purposes only.	
  """
  displayName: String
}

"""
This type represents an account with the 'Suspended' status. This indicates that the user's account has been suspended by eBay.
"""
type UserStatusSuspended implements UserStatus {
  """
  The human-readable label for the user's account status. In this case, this field will return 'Suspended'.
  **Note**: This value is for display purposes only.	
  """
  displayName: String
}

"""
This type represents an account with the 'Unconfirmed' status. This indicates that the user's account has not been verified by eBay.
"""
type UserStatusUnconfirmed implements UserStatus {
  """
  The human-readable label for the user's account status. In this case, this field will return 'Unconfirmed'.
  **Note**: This value is for display purposes only.	
  """
  displayName: String
}

"""
This type represents an account status that cannot be determined. This status is returned when the account does not fall into any other known status category. 
"""
type UserStatusUndetermined implements UserStatus {
  """
  The human-readable label for the user account status. In this case, this field will return 'Undetermined'.
  **Note**: This value is for display purposes only.	
  """
  displayName: String
}

"""
The base request type for the **userWatchList** query. This container is used to specify pagination parameters for retrieving a user's default Watchlist. 
**Note**: All parameters are optional. If not provided, default values will be used.
"""
input UserWatchListInput {
