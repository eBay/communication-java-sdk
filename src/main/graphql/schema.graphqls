"""This type restricts conditions to a specific category list."""
type ReturnItemCategoryCondition {
  """
  A list of one or more categories referenced by this condition.
    
  **Note:** These needs to be eBay leaf category IDs.
  """
  categories: [Category!]!
}

"""
This input type defines the leaf categories applicable to an automation return rule template.
- specify categories by their ID
- duplicate category IDs are not allowed
"""
input ReturnItemCategoryConditionInput {
  """
  A list of leaf category IDs to which the rule applies. Contraints:
  - they must be eBay leaf category IDs
  - a maximum of 20 category IDs can be specified
  - IDs must be unique
  """
  categoryIds: [ID!]!
}

"""
This type restricts conditions to the item's location country. The list of countries can be provided.
"""
type ReturnItemLocationCountryCondition {
  """Location to where the seller ships the item to the buyer."""
  itemLocationCountries: [CountryAlpha2Code!]!
}

"""
This input type defines the item location countries applicable for an automation return rule template:
- specify countries using their codes.
- duplicate country codes are not allowed.
"""
input ReturnItemLocationCountryConditionInput {
  """Country code in ISO format. Example `US` for United States."""
  itemLocationCountries: [CountryAlpha2Code!]!
}

"""This type provides details about the return shipment's return label."""
type ReturnLabel {
  """
  This field contains the return label document ID. This is the unique identifier for the return shipment label document.
    
  **Note:** Use the **Media API** <a href="https://developer.ebay.com/api-docs/commerce/media/resources/post_order/methods/downloadPostOrderDocument"  target="_blank">downloadPostOrderDocument</a> method to download the label.
    
  This optional field is not available during the following scenarios.
  - seller provides only tracking and shipping carrier code for offline methods
  - return label is from by the buyer
  """
  labelDocument: OrderReturnDocument
  """The shipping carrier used for the return shipment."""
  shippingCarrier: ShippingCarrier!
  """
  Total Label Cost for this return label. This optionally present field is only available when the platform label is provided.
  """
  totalLabelCost: AmountSet
  """
  The carrier tracking number used to track the return fulfillment status for the return. This optional field will not be present if the tracking number is not provided for the return shipment.
  **
    
  **Note:** Some carriers do not have trackable labels.
  """
  trackingNumber: String
}

"""
This enumerated type is used to provide the return label options for the return shipment label.
"""
enum ReturnLabelProvisionOption {
  """
  The seller attaches the return label to the return.
    
  **Note:** Use the **Media API** <a href="https://developer.ebay.com/api-docs/commerce/media/resources/post_order/methods/downloadPostOrderDocument"  target="_blank">downloadPostOrderDocument</a> method to download the label.
  """
  ATTACH_LABEL_TO_RETURN
  """The seller has sent the return label to the buyer offline."""
  RECORD_LABEL_SENT_OFFLINE
  """The platform provides the return shipping label."""
  USE_PLATFORM_LABEL
}

"""
This type is used to provide the carrier and tracking information for the return shipment label that has been sent.
"""
input ReturnLabelTrackingInput {
  """
  The date when the return shipment label was sent to the buyer. If this optional field is not provided, the current date will be used as the label sent date.
  """
  labelSentAt: DateTime
  """
  The standardized carrier details (for example, UPS, USPS, FEDEX) for the return shipment. It is not nullable, but the entire object may be omitted if tracking info is unavailable.
  """
  shippingCarrier: ReturnShippingCarrierInput!
  """The tracking number for the return shipment."""
  trackingNumber: String!
}

"""
This type contains information on the order line item attached to the return.
"""
type ReturnLineItem {
  """
  The restock details for the returned listing. Present only when listing restock is requested through returns mutations. This can be a list in case we will support restock for individual listing inside one item bundle.
  """
  listingRestockTasks: [PostPurchaseListingRestockTask!] @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.return.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.return&eBayUser"])
  """The OrderLineItem purchased."""
  orderLineItem: OrderLineItem!
  """
  The number of units in the request to return. This field is optional and applies only to multi-quantity line items.
  """
  requestedQuantity: Int
  """
  This list contains one or more documents uploaded when the return was created. Optionally present only if the requester has provided any documents during return creation.
  """
  returnCreationDocuments: [OrderReturnDocument!]
  """ The unique identifier of the return line item """
  returnLineItemId: ID!
  """
  Notes that were provided during the creation of the return. Optionally present only if the requester has provided a note.
  """
  returnNote: String
  """
  The return reason, which could change based on the return request and category of items. As new return reasons can be added in future, code so clients can handle this field gracefully. In countries where the return reason is not mandatory to provide, it will be returned as UNDISCLOSED.
  """
  returnReason: ReturnReason!
}

"""
This error type indicates that the specified return line item in the request does not exist.
"""
type ReturnLineItemNotFoundError implements BusinessError {
  """A machine-readable error code: `RTRN_LINE_ITEM_NOT_FOUND`"""
  errorCode: String!
  """
  A human-readable error message. 
    
  **Maximum length:** 512 characters
  **Format:** Alphanumeric
  """
  errorMessage: String!
  """ The requested line item was not found. """
  requestedLineItemIds: [ID!]!
}

"""
This input type specifies the line-item level refund withholds for the return.
"""
input ReturnLineItemRefundWithholdInput {
  """
  The identifier of the return line item for which the refund withholds are being applied.
  """
  returnLineItemId: ID!
  """
  The percentage (1–99) to withhold from the refundable item price. The maximum allowed percentage is determined by the applicable return refund policy.
  """
  withholdPercentageOnItemPrice: Int! = 0
  """
  The reason withholding was applied to the refund amount for the return line item. This is to provide context on why the refund amount is being withheld.
  """
  withholdReturnRefundReason: [WithholdReturnRefundReasonInput!]!
  """
  If `true`, the shipping cost is withheld from the refund for this line item. Withholding of shipping cost is subject to the return refund policy and may not be permitted if the policy requires shipping costs to be refunded.
  """
  withholdShippingCostFromRefund: Boolean! = false
}

"""
This type restricts conditions to specify to a specific listing group. Every group can have a specified number of listings.
"""
type ReturnListingGroupCondition {
  """
     A listing group ID referenced by this condition:
  - a group can have a specified number of listings
     - only one group can be defined per condition
  """
  returnRuleListingGroupId: ID!
}

"""
This input type defines a group containing multiple listings to which the return automation rule applies.
"""
input ReturnListingGroupConditionInput {
  """
  Specifies the ID of the listing group used by this condition in an automation return rule template.
    
  **Note:** Only one listing group can be specified per condition.
  """
  returnRuleListingGroupId: ID!
}

"""
This interface represents actions completed and their timing during return logistic fulfillment, for actions such as carrier pickup, in transit, delivered actions, and facility actions.
"""
interface ReturnLogisticEvent {
  """The date and time when the tracking event occurred."""
  occurredAt: DateTime!
  """
  The return line items that were affected by this event.
    
  **Note:** For multi-quantity orders, line items may have the same type of event affect them multiple times.
  """
  returnLineItems: [ReturnLineItem!]!
}

"""
This type represents a complete negotiation conversation on return. Current policy supports one offer per negotiation.
"""
type ReturnNegotiation {
  """The latest return offer made in the negotiation."""
  latestReturnOffer: ReturnOffer!
}

"""
This type represents the validation constraints defined for the return note.
"""
type ReturnNoteConstraint {
  """The minimum and maximum number of characters allowed."""
  characterLimit: InputTextLengthRange!
}

"""This type represents the return note input violations."""
type ReturnNoteViolation implements ApproveReturnInputViolation & CreateInStoreReturnInputViolation & DeclineReturnInputViolation & SendMessageInputViolation {
  """
  A machine-readable code identifying the specific rule that was violated (for example, `RETURN_NOTE_VIOLATION`).
  """
  code: String!
