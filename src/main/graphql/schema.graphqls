  This array returns a list of watched items. Items are ordered by the date they were added to the Watchlist, with the most recent first.
  *Note*: This field may be empty if the user has no watched items.
  """
  items: [WatchedItem!]!
  """
  This container returns pagination information for navigating through multiple pages of results.
  """
  pagination: Pagination
  """
  The current number of items in the user's default Watchlist. This count represents all items across all pages, not just the current page.
  """
  watchListCount: Int!
  """The maximum number of items allowed in the user's default Watchlist."""
  watchListMaximum: Int!
}

"""
This type is used for an **purchaseQuotes** query when a **listingId** field is used as a filter.
"""
type VariationListing implements ListingV2 {
  """
  This array provides detailed information about one or more purchasable items within an eBay listing. Each item object will have price, quantity, and global product identifiers if applicable. Item objects within multiple-variation listings will show unique traits that differentiate them from the rest of the variations within the listing.
  """
  items: [Item!]!
  """
  The unique identifier of a multiple-SKU listing. All purchase quotes that involve this listing, and meeting other search criteria, will be returned.
  """
  listingId: ID!
  """
  This query will return all item commitments spawned from the corresponding listing, and meeting other search criteria.
  **Note**: The authenticated user (seller or buyer) must have a relationship to item commitments for them to be returned.
  **Note**: Other filters in addition to **listingId** may be used.
  """
  itemCommitments: ItemCommitments! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.commitment.read", "https://api.ebay.com/oauth/api_scope/buy.commitment", "https://api.ebay.com/oauth/api_scope/sell.commitment.read", "https://api.ebay.com/oauth/api_scope/sell.commitment"])
  """Seller-scoped Unanswered questions count for the listing"""
  unansweredQuestions: UnansweredQuestions @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/sell.listing.read"])
  """
  Entry point for the authenticated viewer’s order data **in the context of this listing**.
    
  Semantics:
  • Results are implicitly filtered to `listingId == this.listingId`.
  • For sellers: surfaces orders where the viewer is the seller of this listing.
  • For buyers: surfaces orders where the viewer purchased this listing.
    
  Behavior:
  • Clients may add filters/sort; the implicit `listingId` filter is always applied and
  should not be overridable.
  • Requires authentication; if the viewer has no related orders, the lists are empty.
  """
  orders: Orders! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.order.read&eBayUser", "https://api.ebay.com/oauth/api_scope/buy.order&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.order.read&eBayUser", "https://api.ebay.com/oauth/api_scope/sell.order&eBayUser"])
  """
  This query will return all purchase quotes that involve this listing, and meeting other search criteria.
  **Note**: The authenticated user (seller or buyer) must have a relationship to purchase quote(s) for them to be returned.
  **Note**: Other filters in addition to **listingId** may be used.
  """
  purchaseQuotes: PurchaseQuotes! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/buy.purchase.quote.read", "https://api.ebay.com/oauth/api_scope/sell.purchase.quote.read", "https://api.ebay.com/oauth/api_scope/buy.purchase.quote", "https://api.ebay.com/oauth/api_scope/sell.purchase.quote"])
  """
  This container is used to provide listing terms details for the listing, including listing format, listing duration, item location, return policy, fulfillment terms, and more.
  """
  listingTerms: ListingTerms
  """
  This container is used to express the traits where each SKU within a multiple-variation listing differs, such as 'Color' and 'Size'. Each available color and each available size will be listed through the **variationTraits** array. If the listing featured t-shirts, each variation within that listing would have a unique color and zize combination such as 'Blue, Large'.
  """
  listingVariations: ListingVariations
  """
  The marketplace identifier of the listing. See [`Marketplace`] enum for supported values.
  This field specifies the eBay marketplace where the listing was listed.
  It determines the regional settings, currency, and other marketplace-specific configurations.
  """
  marketplace: ListingMarketplace
  """
  This container is used to provide common product details for the listing, including product aspects, title, description, condition, images, and more.
  """
  sellerProduct: SellerProduct
  """
  This field is used to provide a seller-defined Stock Keeping Unit (SKU) value for a multiple variation (multi-sku) listing.
  If the seller wants to fetch a listing by its SKU, this field must be provided.
    
  This is an optional field. If provided, the value represents the listing's SKU. The SKU for each individual variation
  is provided in the Item for that variation.
  """
  sku: String
}

"""
This type is used to provide more information when the 'Vault to Buyer' fulfillment type is used to deliver the item to the buyer. With 'Vault to Buyer' fulfillment, the item goes from the seller's PSA Vault location to the buyer's shipping address.
"""
type VaultToBuyer implements Labeled {
  """A human-readable label for the entity."""
  label: String!
}

"""
This type is used to provide more information when the 'Vault to Vault' fulfillment type is used to deliver the item to the buyer. With 'Vault to Vault' fulfillment, the item goes from the seller's PSA Vault location to the buyer's PSA Vault location. 
"""
type VaultToVault implements Labeled {
  """A human-readable label for the entity."""
  label: String!
}

"""This type is used to identify Venmo as the payment method."""
type Venmo implements PaymentMethodType {
  """The unique identifier of Venmo."""
  code: ID!
  """The descriptive name of the Venmo payment method."""
  descriptiveName: String!
  """The display name of the Venmo payment method."""
  displayName: String!
}

"""Container for videos and its associated metadata"""
type Video {
  """The unique identifier of the video."""
  videoId: ID!
  """
  The description of the video. 
  **Maximum length**: 4096 characters
  **Note:** This field returns 'null' if the video was uploaded without a description.
  """
  description: String
  """
  The date and time when an unused video will expire, in ISO-8601 format (for example, '2026-01-01T12:00:00Z'). As long as a video is being used in an active listing, that video will remain on the server and be accessible. If a video is not being used on an active listing, its expiration date is automatically set to 30 days after the video's initial upload.
  """
  expiresAt: DateTime!
  """
  The height of the video in pixels.
     **Note:** This field returns '0' if video status is 'PROCESSING_FAILED'.
  """
  height: Int
  """
  If applicable, this object returns the reason why the video is blocked by moderators.
  **Note**: This object returns 'null' if the video is not blocked by eBay moderation policies.
  """
  moderation: VideoModeration
  """
  This array returns the playlist created for the uploaded video, which provides the streaming video URLs to play the video. 
  **Note:** This array is only returned when the video status is 'LIVE'.
  """
  playlists: [VideoPlaylist!]
  """
  This object returns error details if video processing has failed. 
  **Note:** This object is only returned when the video status is 'PROCESSING_FAILED'.
  """
  processingFailure: VideoProcessingFailureReason
  """The size of the video file in bytes."""
  size: Int!
  """The current status of the video processing."""
  status: VideoStatusEnum!
  """
  The URL of the thumbnail image of the video.
  **Note:** This object returns 'null' if no thumbnail was provided during video upload, and video status is not 'LIVE'.
  """
  thumbnail: VideoThumbnail
  """
  The title of the video.
     **Maximum length**: 1024 characters
  **Note:** This field returns 'null' if the video was uploaded without a title.
  """
  title: String
  """
  The duration of the video in ISO-8601 format (for example, 'PT15S' for 15 seconds). 
  **Note:** This object returns 'null' if the status of the video is not 'LIVE'.
  """
  videoDuration: Duration
  """
  The width of the video in pixels. 
  **Note:** This field returns '0' if video status is 'PROCESSING_FAILED'.
  """
  width: Int
}

"""
This type is used for a successful **videosByIds** query. On success, metadata details for the videos matching the specified identifiers are returned.
"""
type VideoByIdSuccess {
  """
  This object returns metadata details (such as  title, size, description, ID, playlist, status, expiration date, and thumbnail image) for the videos matching the specified video identifiers.
  """
  video: Video!
}

"""
This type indicates that processing failed because the video file is corrupted or unreadable.
"""
type VideoCorruptedError implements VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""This type indicates that a generic internal error occurred."""
type VideoInternalProcessingError implements VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""
This type indicates that processing failed due to invalid input data provided during upload.
"""
type VideoInvalidInputValidationError implements VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""
This type indicates that processing failed due to an invalid video or audio codec/stream.
"""
type VideoInvalidMediaStreamError implements VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""
This type represents the list of videos (and their metadata) and/or errors returned by the **videosByIds** query.
"""
type VideoList {
  """
  This array returns a list of videos, specified by their unique identifiers. If one or more specified videos cannot be retrieved, an error will be returned for each video detailing the reason why.
  """
  videoList: [VideoResult]!
}

"""
This type defines the reason(s) why the specified video was blocked by moderators.
"""
type VideoModeration {
  """
  This array returns a list of one or more reasons why the video failed moderation and was blocked from being published.
  """
  rejectReasons: [VideoRejectReasonEnum!]!
}

"""
This type indicates that processing failed due to a system error during moderation.
"""
type VideoModerationFailedError implements VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""
This type represents a streaming endpoint for a video, providing the URL to access the content.
**Note:** This type is only available when a video has been successfully processed and has a status of 'LIVE'.
"""
type VideoPlaylist {
  """
  The playable URL for this video.
  **Maximum length**: 120 characters
  """
  playUrl: HttpOrHttpsUrl!
  """
  The streaming protocol for the video playlist. Supported protocols include 'DASH' and 'HLS'. 
  """
  protocol: VideoPlaylistProtocolEnum!
}

"""
This type indicates that the video was processed, but the final playlist (HLS/DASH) could not be generated.
"""
type VideoPlaylistGenerationError implements VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""
This enumerated type indicates the protocol for the video playlist. Supported protocols are 'DASH' (Dynamic Adaptive Streaming over HTTP) and 'HLS' (HTTP Live Streaming).
"""
enum VideoPlaylistProtocolEnum {
  """
  This enum value indicates the protocol for the video playlist is 'DASH' (Dynamic Adaptive Streaming over HTTP).
  """
  DASH
  """
  This enum value indicates the protocol for the video playlist is 'HLS' (HTTP Live Streaming).
  """
  HLS
}

"""
The common interface for all video processing failures. New implementing types may be introduced over time. 
"""
interface VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""
This enumerated type represents the categories of video processing failures.
"""
enum VideoProcessingFailureCategoryEnum {
  """
  This enum value indicates that video processing failed due to a server or system error during processing of the video.
  """
  INTERNAL
  """
  This enum value indicates that video processing failed due to invalid request parameters or data during video upload.
  """
  REQUEST
}

"""
This union represents the specific reasons why video processing failed. Additional types may be added to this union in the future. 
"""
union VideoProcessingFailureReason = VideoCorruptedError | VideoInternalProcessingError | VideoInvalidInputValidationError | VideoInvalidMediaStreamError | VideoModerationFailedError | VideoPlaylistGenerationError | VideoProcessingTimeoutError | VideoSystemResourceError | VideoThumbnailGenerationError

"""
This type indicates that processing took too long and was aborted by the system.
"""
type VideoProcessingTimeoutError implements VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""This enumerated type indicates the reason for moderation failure. """
enum VideoRejectReasonEnum {
  """
  This enum value indicates that the video is blocked because some parts are blurry and cannot be seen clearly.
  """
  BLURRED
  """
  This enum value indicates that the video is blocked because it leads buyers away from the eBay site. Refer to eBay's [Offering to buy or sell outside of eBay policy](https://www.ebay.com/help/policies/payment-policies/offering-buy-sell-outside-ebay-policy?id=4272) for details.
  """
  DIRECTS_OFF_EBAY
  """
  This enum value indicates that the video is blocked because the audio playback is distorted.
  """
  DISTORTED_AUDIO
  """
  This enum value indicates that the video is blocked because some parts appear frozen and do not play correctly.
  """
  FREEZES
  """
  This enum value indicates that the video is blocked due to an inappropriate depiction of minors. Refer to eBay's [Protecting minors policy](https://www.ebay.com/help/policies/prohibited-restricted-items/protecting-minors-policy?id=5057) for details.
  """
  INAPPROPRIATE_DEPICTION
  """
  This enum value indicates that the video is blocked because the max length has been exceeded.
  """
  MAX_LENGTH_EXCEEDED
  """
  This enum value indicates that the video is blocked because it contains nudity. Refer to eBay's [Adult items policy](https://www.ebay.com/help/policies/prohibited-restricted-items/adult-items-policy?id=4278) for details.
  """
  NUDITY
  """
  This enum value indicates that the video is blocked because it contains offensive content. Refer to eBay's [Offensive materials policy](https://www.ebay.com/help/policies/prohibited-restricted-items/offensive-materials-policy?id=4324) for details.
  """
  OFFENSIVE_CONTENT
  """
  This enum value indicates that the video is blocked due to some other specific or atypical policy violation.
  """
  OTHER_POLICY_VIOLATION
  """
  This enum value indicates that the video is blocked because some parts are pixelated and cannot be seen clearly.
  """
  PIXELATED
}

"""
This union type specifies the result of a successful or partially successful **videosByIds** query. For each successfully retrieved video, metadata and details for the video will be returned. If a video could not be successfully retrieved, an error will be returned for each video detailing the reason why. Additional types may be added to this union in the future. 
"""
union VideoResult = ReferenceArgumentsNotFound | VideoByIdSuccess

"""This input defines the input parameters for the **videoByIds** query."""
input VideosByIdsInput {
  """
  This array specifies the unique identifiers of the video(s) for which to retrieve video metadata.
  """
  videoIds: [ID!]!
}

"""
The union type for the **videosByIds** query. This type covers three possible scenarios: success, partial success, and failure. If the **videosByIds** query succeeds, the list of videos (specified by their **videoId** value) and their metadata will be returned. If the **videosByIds** query only partially succeeds, an error for each video that was not found using the provided identifiers will be returned. If the **videosByIds** query fails, an error will be returned explaining that the maximum amount of video IDs allowed in the input has been exceeded.
"""
union VideosByIdsResult = MaxVideoIdsAllowedExceeded | VideoList

"""
This enumerated type indicates the video's status. Typically a video will progress through the following states: 'PENDING_UPLOAD' -> 'PROCESSING' -> 'LIVE'. A video may also enter terminal states such as 'PROCESSING_FAILED' or 'BLOCKED' depending on various conditions, instead of reaching 'LIVE'. New Video status may be added in the future; clients should handle unknown values gracefully.
"""
enum VideoStatusEnum {
  """
  This enum value indicates that the video is blocked. A video might be 'BLOCKED' if it contains malware, or if it is blocked by the video moderation feature.
  """
  BLOCKED
  """
  This enum value indicates that the video is live. When the status of the video is 'LIVE', this indicates the file has been processed and uploaded successfully. The playlist providing URLs for the video streaming protocols is generated when processing completes successfully.
  """
  LIVE
  """
  This enum value indicates that the video is pending upload. The video is being associated with a video ID and has not been uploaded yet.
  """
  PENDING_UPLOAD
  """
  This enum value indicates that the video upload is processing. After a video upload is successfully completed, the status will show as 'PROCESSING' until the video reaches one of the terminal states of 'LIVE', 'BLOCKED', or 'PROCESSING_FAILED'.
  """
  PROCESSING
  """
  This enum value indicates that the video failed to process. Videos can fail to process for a number of reasons such as the file being corrupted, the file being too large, or the file's size doesn't match what was provided in the metadata. Refer to the error messages to determine the cause of the video's failure to upload.
  """
  PROCESSING_FAILED
}

"""
This type indicates that processing failed due to insufficient system resources (e.g., out of memory).
"""
type VideoSystemResourceError implements VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""This type represents a video thumbnail image."""
type VideoThumbnail {
  """
  The URL of the thumbnail image of the video. The URL must match the pattern '(?i)http(s)?://i.ebayimg.com/.*' and be a valid eBay Picture URL.
  """
  imageUrl: HttpOrHttpsUrl!
}

"""
This type indicates that processing failed during the thumbnail generation step.
"""
type VideoThumbnailGenerationError implements VideoProcessingError {
  """The high-level error category indicating the type of failure."""
  category: VideoProcessingFailureCategoryEnum!
  """
  A non-localized error message describing the processing failure. 
  **Maximum length**: 150 characters
  """
  message: String!
}

"""
This type represents an individual item in the user's default Watchlist. 
"""
type WatchedItem {
  """The unique identifier of the item being watched."""
  item: Item!
  """
  The date and time when this item was added to the user's Watchlist.
  **Format**: ISO 8601 date-time string (YYYY-MM-DDTHH:mm:ss.sssZ)
  **Timezone**: UTC
  """
  startedWatchingAt: DateTime!
  """The item's price at the time the user started watching it."""
  startedWatchingPrice: ConvertedAmount!
}

"""
This type defines the details of why a specific item failed to be added to a user's Watchlist.
"""
type WatchListAddFailure {
  """
  The unique identifier of the item that failed to be added to the user's Watchlist.
  """
  item: Item!
  """The reason the item failed to be added to the user's Watchlist. """
  reason: WatchListAddFailureReason!
}

"""
This enumerated type contains the reason an item failed to be added to a user's Watchlist.
"""
enum WatchListAddFailureReason {
  """The item is already in the user's Watchlist."""
  ITEM_ALREADY_WATCHED
  """
  The listing is not part of an active listing and cannot be added to a Watchlist.
  """
  ITEM_NOT_ACTIVE
  """The specified item ID cannot be found."""
  ITEM_NOT_FOUND
  """
  The user's Watchlist is full and no further items can be added at this time.
  """
  WATCHLIST_FULL
}

"""
This type is used to specify an item to be added to a user's Watchlist.
"""
input WatchListEntryToAdd {
  """The unique identifier of the item being added to a user's Watchlist."""
  itemId: ID!
}

"""
This type is used to specify an item to be removed from a user's Watchlist.
"""
input WatchListEntryToRemove {
  """
  The unique identifier of an item being removed from a user's Watchlist.
  """
  itemId: ID!
}

"""
This type defines the details of why a specific item failed to be removed from a user's Watchlist.
"""
type WatchListRemoveFailure {
  """
  The unique identifier of the item that failed to be removed from the user's Watchlist.
  """
  item: Item!
  """The reason the item failed to be removed from the user's Watchlist. """
  reason: WatchListRemoveFailureReason!
}

"""
This enumerated type contains the reason an item failed to be removed from a user's Watchlist.
"""
enum WatchListRemoveFailureReason {
  """The item is not currently in the user's Watchlist."""
  ITEM_NOT_WATCHED
}

"""
This enumerated type consists of the units of measurement that are used to specify shipping package weight.
"""
enum WeightUnitType {
  """
  This enumeration value indicates that the shipping package weight is measured in grams.
  """
  GRAM
  """
  This enumeration value indicates that the shipping package weight is measured in kilograms.
  """
  KILOGRAM
  """
  This enumeration value indicates that the shipping package weight is measured in ounces.
  """
  OUNCE
  """
  This enumeration value indicates that the shipping package weight is measured in pounds.
  """
  POUND
}

"""This type is used to identify wire transfer as the payment method."""
type WireTransfer implements PaymentMethodType {
  """The unique identifier of wire transfer."""
  code: ID!
  """The descriptive name of the wire transfer payment method."""
  descriptiveName: String!
  """The display name of the wire transfer payment method."""
  displayName: String!
}

"""
This enumerated type provides context for the refund adjustment or deduction applied in accordance with the applicable return policy.
"""
enum WithholdReturnRefundReasonInput {
  """
  The item was returned in a damaged condition, which has resulted in a loss of value.
  """
  RETURNED_IN_DAMAGED_CONDITION
  """
  The item was returned in a used condition, which has resulted in a loss of value.
  """
  RETURNED_IN_USED_CONDITION
  """
  The item was returned with missing parts, which has resulted in a loss of value.
  """
  RETURNED_WITH_MISSING_PARTS
}

"""
This type indicates the item is returned because the buyer received an item that does not match the item ordered. Displays as **Wrong item received**.
"""
type WrongItemReceived implements ReturnReason {
  """A machine-readable reason code: `WRONG_ITEM_RECEIVED`"""
  code: String!
  """
  A human-readable description of the return reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""This type is used to identify ZIPPay as the payment method."""
type ZIP implements PaymentMethodType {
  """The unique identifier of the ZIPPay payment method."""
  code: ID!
  """The descriptive name of the ZIPPay payment method."""
  descriptiveName: String!
  """The display name of the ZIPPay payment method."""
  displayName: String!
}