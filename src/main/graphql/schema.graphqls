  The unique identifier of the party that will handle the return if a return happens. As of now, the only valid value is 'EBAY'.
  """
  returnManagedBy: ID!
  """The location where the service is to be provided or performed."""
  serviceLocation: ID
}

"""
This type is used to indicate an eco-participation fee for item(s) in a listing. An eco-participation fee is a mandatory charge designed to fund the recycling and proper disposal of certain products at the end of their lifecycle. Eco-participation fees are one part of the Extended Producer Responsibility regulation enforced in EU countries.
"""
type ExtendedProducerResponsibility {
  """
  This is the fee paid for new items to the eco-organization (for example, eco-organisme in France). It is a contribution to the financing of the disposal of the item responsibly.
  """
  listingEcoParticipationFee: ConvertedAmount
}

"""
This type represents the specifics of a single external product. These details are used to create eBay Listing Previews.
"""
type ExternalProductDetails {
  """An array of product aspect name-value pairs for an external product."""
  aspects: [ExternalProductDetailsAspect!]
  """
  The full path to the listing category of the external product, such as `/Electronics/Cell Phones & Accessories/Smart Watches` This field will be returned as null if not provided for an external product.   
  """
  category: String
  """
  This container shows the Global Trade Identifier Number (GTIN) for an external product. This container will be returned as null if not provided for an external product.
  """
  externalProductIdentifier: ExternalProductIdentifier
  """An array of URLs pointing to images of the product."""
  images: [HttpOrHttpsUrl!]
  """
  Represents the seller-defined Stock Keeping Unit (SKU) of the external product. If the SKU was not provided for an external product, this field returns null.
  """
  sku: String
  """
  The title of the external product. This field will be returned as null if not provided for an external product.
  """
  title: String
}

"""
This type is used to represent a specific feature or aspect of an external product. Each aspect is defined by a name and a list of one or more values.
"""
type ExternalProductDetailsAspect {
  """The name of the aspect for the external product. """
  name: String!
  """A list of one or more corresponding values for the aspect. """
  values: [String!]!
}

"""
This type is used to specify product aspect name-value pairs of an external product. Each aspect is defined by a name and a list of one or more values. The maximum number of aspects allowed is 50.
"""
input ExternalProductDetailsAspectInput {
  """
   The name of the aspect for the external product.
  
  **Max length**: 100 characters
  """
  name: String!
  """
  An array of one or more corresponding values for the aspect.
  
  **Max length**: 100 characters
  """
  values: [String!]!
}

"""
This type is used to provide details of external products. Product details include title, images, product identifiers, product aspects, category name, and SKU value.

If product aspects are provided, a category name must also be provided or a listing preview cannot be generated for that external product. A SKU is optional, but it is highly recommended as it acts as a key to track/identify different external products. Include as many fields as possible to increase chances of creating higher-quality eBay listing previews.
"""
input ExternalProductDetailsInput {
  """
  An array of product aspect name-value pairs for the external product. If the array is included, it is required that it contain no null entries. Some aspects will only have one value and other aspects will have multiple values. **Example** `[{"name":"Color","values":["Black","Red"]},{"name":"Storage Capacity","values":["64GB"]}]`
  """
  aspects: [ExternalProductDetailsAspectInput!]
  """
  The listing category of the external product. A simple category name can be supplied here such as "Smart Watches", or you can provide the path to the category, such as /Electronics/Cell Phones & Accessories/Smart Watches.` 
  """
  categoryName: String
  """
  This container is used to provide a Global Trade Identifier Number (GTIN) for an external product. If a GTIN value is provided for an external product, no other data under **externalProductDetails** shall be provided.
  """
  externalProductIdentifierInput: ExternalProductIdentifierInput
  """
  An array of image URLs provided for the external product. Each provided image must be a valid URL that uses 'https'.  If the array is included, it is required that it contain no null entries.
  **Max images**: 24
  """
  images: [HttpOrHttpsUrl!]
  """
  The SKU (Stock Keeping Unit) of the external product. This value is a seller-defined identifier for the product. This is an optional field, but it is highly recommended as it acts as a key to track/identify different external products.
  """
  sku: String
  """
  The title of the external product. The title field should not contain HTML or JavaScript code. Any HTML characters will be treated as plain text. The title should be a string of characters, with support for all characters in the Unicode character set. An example of a title is **`Apple iPhone 11 Pro Max`**. 
  **Max length:** 250 characters  
  """
  title: String
}

"""
This type is used to show the Global Trade Identifier Number (GTIN) for an external product. 
"""
type ExternalProductIdentifier {
  """
  The GTIN value of the external product, corresponding to the GTIN type specified in the **productType** field. This field will be returned as null if a GTIN was not provided for the external product.
  """
  productId: String!
  """ The GTIN type of the external product. `UPC`, `ISBN`, and `EAN` are the supported values. This field will be returned as null if a GTIN was not provided for the external product.
  """
  productType: ExternalProductIdentifierEnum!
}

""" An enumerated type defining values for different external product types. 
"""
enum ExternalProductIdentifierEnum {
  """
  A European Article Number (EAN) is a unique 8 or 13-digit identifier code that identifies products worldwide.
  The EAN values are typically used across Europe.
  """
  EAN
  """
  An International Standard Book Number (ISBN) is a unique numeric commercial book identifier.
  Both 10 and 13-character ISBNs are supported.
  """
  ISBN
  """
  Manufacturer Part Number (MPN) values are currently not supported, so please don't specify this value in the **productType** field.
  """
  MPN
  """
  A Universal Product Code (UPC) is a unique numerical identifier for commercial products.
  UPC values are typically used in the US and Canada.
  """
  UPC
}

""" This type is used to provide a Global Trade Identifier Number (GTIN) for an external product. 
"""
input ExternalProductIdentifierInput {
  """
  The GTIN value of the external product, corresponding to the GTIN type specified in the **productType** field. The pattern of characters in this field should match the **productId** type.
  """
  productId: String!
  """
  The GTIN type of the external product. `UPC`, `ISBN`, and `EAN` are the supported values and one of these should be specified in this field. 
  """
  productType: ExternalProductIdentifierEnum!
}

"""
This enumerated types defines the the supported document file extensions for uploads related to the inquiry process. Examples include evidence documents or shipping proofs. Only the listed formats are supported.
"""
enum FilenameExtension {
  """
  This enum value indicates that the Microsoft Word document (.doc) format is supported.
  """
  DOC
  """
  This enum value indicates that the Microsoft Word document (.docx) format is supported.
  """
  DOCX
  """This enum value indicates that theGIF image format is supported."""
  GIF
  """This enum value indicates that theJPEG image format is supported."""
  JPG
  """This enum value indicates that the PDF document format is supported."""
  PDF
}

"""
This type indicates that the Parts & Accessory item is being returned as the item does not fit the buyer's vehicle and displays as **Fit compatibility issue**.
"""
type FitCompatibilityIssue implements ReturnReason {
  """A machine-readable reason code: `FIT_COMPATIBILITY_ISSUE`"""
  code: String!
  """
  A human-readable description of the return reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type indicates the item is returned because the buyer found a better price. Displays as **Found better price**.
"""
type FoundBetterPrice implements ReturnReason {
  """A machine-readable reason code: `FOUND_BETTER_PRICE`"""
  code: String!
  """
  A human-readable return reason that is intended for display only. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type indicates the cancellation reason was that a cheaper price from a different seller was found.
"""
type FoundCheaperPriceCancellation implements ContractCancellationReason {
  """
  The unique machine-readable contract cancellation reason code for this use case. For this type, the value is `FOUND_CHEAPER_PRICE`.
  """
  code: String!
  """
  A human-readable description of the cancellation reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type contains detailed information on the fulfillment addon service associated with an order line item.
"""
type FulfillmentAddOnService {
  """
  This field indicates the party that is handling fulfillment of the order line item.
  """
  fulfilledBy: ID!
}

"""This type is used to indicate that fulfillment is completed."""
type FulfillmentCompleted implements Labeled {
  """This timestamp indicates the date and time when fulfillment completed."""
  completedAt: DateTime
  """
  The human-readable label representing a fulfillment that has completed (e.g. "Completed").
  **Maximum length**: 100 characters.
  """
  label: String!
}

"""This type indicates that fulfillment is currently in progress."""
type FulfillmentInProgress implements Labeled {
  """
  The human-readable label representing a fulfillment that is in progress (e.g. "In Progress").
  **Maximum length**: 100 characters.
  """
  label: String!
  """This timestamp indicates the date and time when fulfillment began."""
  startedAt: DateTime!
}

"""This type indicates that fulfillment has not started."""
type FulfillmentNotStarted implements Labeled {
  """
  The human-readable label representing a fulfillment that has not started (e.g. "Not Started").
  **Maximum length**: 100 characters.
  """
  label: String!
}

"""
This type is used to indicate that fulfillment has partially started, meaning that the fulfillment of some line items has started, while the fulfillment process on other line items has not started.
"""
type FulfillmentPartiallyStarted implements Labeled {
  """
  The human-readable label representing a fulfillment that has partially started (e.g. "Partially Started").
  **Maximum length**: 100 characters.
  """
  label: String!
  """
  This array shows the list of line items for which fulfillment has not yet started.
  """
  lineItemsNotStarted: [LineItemReference!]!
  """
  This array shows the list of line items for which fulfillment has started.
  """
  lineItemsStarted: [LineItemReference!]!
}

"""
This type is used to provide details on how the item will be delivered to the buyer.
The data in this type includes available shipping services, ship-to and excluded shipping locations,
shipping costs, package details, and more.
"""
type FulfillmentTerms {
  """
  This field should be included and set to true if the item is a digital item that can be downloaded via a link or delivered to the buyer via email.
  The  [getListingTypePolicies](https://developer.ebay.com/api-docs/sell/metadata/resources/marketplace/methods/getListingTypePolicies)
  method can be used to see if a leaf category supports digital delivery.
  """
  digitalDeliverySupported: Boolean
  """
  Specifies that the seller wants to offer free shipping.
    
  To see if a specific shipping service is free, look at ShippingServiceDetails.shippingCost.
  If it is set to zero, the shipping is free for that service.
  """
  freeShippingAvailable: Boolean
  """
  This field can be included and set to 'true' if the seller wishes to use eBay's Global Shipping Program (GSP) to ship items internationally.
  With GSP, the seller ships the item to eBay's shipping partner, and that shipping partner handles all logistics of the international shipping leg.
  GSP is only available for listings on the eBay UK marketplace. eBay US has a similar program called eBay International Shipping,
  but there is currently no boolean field associated with this feature.
  """
  globalShippingSupported: Boolean
  """
  This field is only applicable to sellers enabled to sell 'Buy online, pick up in store' (BOPIS) inventory.
  This field is included and set to 'true' if the seller wishes to make the item available for pickup at a store location within close proximity to the buyer's location.
  See the [In-store pickup ](https://developer.ebay.com/api-docs/sell/static/inventory/in-store-pickup.html) topic for information on setting up BOPIS, including how to create store locations and load inventory to those stores.
  """
  inStorePickupSupported: Boolean
  """
  This container provides information about the shipping package that will be used to ship the item,
  and includes package type, weight, and dimensions. Package weight is required when calculating shipping
  is used, and shipping services generally have dimension and weight restrictions.
  """
  packageSpecifications: ShippingPackageSpec
  """
  This container provides information about where the item can be shipped, the shipping cost type, the shipping services offered,
  the handling time, applicable shipping discounts, and more.
  """
  shippingTerms: ShippingTerms
}

"""
This union type is used by the **FulfillmentTerms** and **BusinessPolicy** type to display fulfillment terms for a listing, including shipping cost model, available shipping services, shipping costs, handling time, combined shipping rules, and excluded shipping locations.
"""
union FulfillmentTermsPolicy = BusinessPolicy | FulfillmentTerms

"""
This interface is used to identify a source payment account for a payer or a destination payment account for a payee.
"""
interface FundAccount {
  """A unique identifier that identifies the domain or type of account."""
  domain: ID!
  """The unique identifier of the account used for fund transfers."""
  identifier: ID!
}

"""
This type includes detailed gift information if the order or line item was wrapped as a gift.
It captures elements such as the card template, gift message, image, and sender/recipient details.
"""
type GiftSummary {
  """Card template, referring to the design or layout of the gift card."""
  cardTemplate: String
  """Message included with the gift."""
  giftMessage: String
  """URL of the image representing the gift."""
  imageUrl: String
  """Recipient address details."""
  recipient: [PurchaseAddress!]
  """Sender address details."""
  sender: [PurchaseAddress!]
}

"""
This type is used to indicate which party handles shipment through the Global Shipping Program.
"""
type GlobalShippingAddOnService {
  """
  The unique identifier of the party that will handle fulfillment through the Global Shipping Program. As of now, the only valid value is `EBAY`.
  """
  poweredBy: ID!
}

"""This type is used to identify Google Pay as the payment method."""
type GooglePay implements PaymentMethodType {
  """The unique identifier of the Google Pay method."""
  code: ID!
  """The descriptive name of the Google Pay payment method."""
  descriptiveName: String!
  """The display name of the Google Pay payment method."""
  displayName: String!
}

"""
This type stores information related to government-issued IDs associated with the business and/or user for whom information is being returned.
"""
type GovernmentIssuedId {
  """
  The type of government-issued ID (e.g., BRN, CRN, ABRN, etc.,) associated with the user for whom information is being returned.
  """
  idType: String
  """
  The government ID number corresponding to the specified type of government-issued ID.
  """
  idValue: String
}

"""
This container is used by the seller to provide hazardous material information for the listing
"""
type HazardousMaterial {
  """
  Additional information seller provides about the hazardous material in this listing.
  """
  additionalInformation: String
  """
  This array specifies one or more pictogram codes that represent the possible hazards that a product poses.
  The pictograms that are stated on the product's Safety Data Sheet should be used.
    
  Use the [getHazardousMaterialsLabels](https://developer.ebay.com/api-docs/sell/metadata-test/resources/marketplace/methods/getHazardousMaterialsLabels)
  method to retrieve the codes that can be provided in this array.
    
  The pictogram(s) that the code(s) represent are painted on the listing.
    
  **Max number of pictogram codes allowed**: 4 pictograms.
  """
  pictogramCodes: [ID!]
  """
  The signal word for hazardous materials in the listing. If your product contains hazardous substances or mixtures.
  Example Value: Danger, Warning
  """
  signalWordCode: ID
  """
  This container is used by the seller to provide hazard statements for the listing. This field is required if hazmat
  information is supplied. This field is an empty list if there are no hazard statements.
    
  This should not be null unless an error has occurred. Please see the error section of the response for more details
  """
  statementCodes: [ID!]
}

"""This type indicates that the item is currently held at customs."""
type HeldAtCustoms implements PostPurchaseCaseReferralReason {
  """The machine-readable reason code: 'HELD_AT_CUSTOMS'."""
  code: String!
  """
  The human-readable text of the case referral reason.
  **Max length**: 100 characters
  **Format**: Alphanumeric
  """
  displayText: String!
}

"""A scalar representing a valid HTTP or HTTPS URL string value."""
scalar HttpOrHttpsUrl

"""
A scalar representing a valid HTTPS URL string value that enforces secure URL protocols.
**Format**: Must begin with 'https://' followed by a valid domain name and optional path components.
- Protocol must be HTTPS (not HTTP)
- Must contain a valid domain name
- May include an optional port number
- May include optional path, query parameters, and fragments
- Special characters in the URL must be properly encoded
"""
scalar HttpsUrl

"""
A scalar representing a unique identifier for idempotency purposes.
**Maximum length**: 32 characters.
"""
scalar IdempotencyKey

"""This type defines the priceline for Import Tax."""
type ImportTax implements PriceLine {
  """The monetary value associated with the priceline item."""
  amount: AmountSet!
  """
  The human-readable priceline name. 
  **Note**: In this case, the name will always be returned as 'IMPORT_TAX'.    
  """
  name: String!
}

"""
This type indicates the incorrect payment method that was used when the contract was created.
"""
type IncorrectPaymentMethodCancellation implements ContractCancellationReason {
  """
  The unique cancellation reason code for this use case. For this type, the value is `INCORRECT_PAYMENT_METHOD`.
  """
  code: String!
  """
  A human-readable description of the cancellation reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type indicates the incorrect shipping address was provided when the contract was created.
"""
type IncorrectShippingAddressCancellation implements ContractCancellationReason {
  """
  The unique cancellation reason code for this use case. For this type, the value is `INCORRECT_SHIPPING_ADDRESS`.
  """
  code: String!
  """
  A human-readable description of the cancellation reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type indicates the incorrect shipping method was selected when the contract was created.
"""
type IncorrectShippingMethodCancellation implements ContractCancellationReason {
  """
  The unique cancellation reason code for this use case. For this type, the value is `INCORRECT_SHIPPING_METHOD`.
  """
  code: String!
  """
  A human-readable description of the cancellation reason. This alphanumeric string is not localized and may change without notice.
    
  **Maximum length:** 100 characters
  """
  displayText: String!
}

"""
This type stores detailed personal information for the user for whom information is being returned.

**Note:** If the user requesting this data is not authorized to view some of the requested information, those fields containing sensitive/confidential information will be masked or return null values.
"""
type IndividualIdentityProfile {
  """
  Primary personal email address associated with the user.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  email: String @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/commerce.identity.email.readonly&eBayUser"])
  """
  First/given name of the user.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  firstName: String @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/commerce.identity.readonly&eBayUser"])
  """
  Last/family name of the user.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  lastName: String @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/commerce.identity.name.readonly&eBayUser"])
  """
  Middle name of the user, if provided.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  middleName: String @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/commerce.identity.name.readonly&eBayUser"])
  """
  Primary personal telephone number of the user.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  primaryPhone: Phone @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/commerce.identity.phone.readonly&eBayUser"])
  """
  Address of the user that was provided during account registration.
      
  **Note:** If the user requesting this data is not authorized to view this information, this field will return a null value.
  """
  profileAddress: ProfileAddress @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/commerce.identity.address.readonly&eBayUser"])
}

"""
This type represents the range of allowed percentage values for an input field.
"""
type InputPercentageRange {
  """Maximum allowed value for percentage."""
  maxValue: Int!
  """Minimum allowed value for percentage."""
  minValue: Int!
}

"""
This common type represents the length constraints for text input fields and is used across multiple violation types to define allowed character limits.
"""
type InputTextLengthRange {
  """The maximum number of characters allowed for input text."""
  maxLength: Int!
  """The minimum number of characters required for input text."""
  minLength: Int!
}

"""
This type represents a shipping carrier used for order inquiry. It includes the eBay-standard carrier code and, when applicable, the name of an unsupported carrier.
"""
input InquiryShipmentCarrierInput {
  """
  The eBay-standard code representing the shipping carrier. This value must match one of the supported eBay **carrierCodes**. If the carrier is not officially supported or recognized by eBay Marketplace, use the special value `UNSUPPORTED`. In that case, provide the carrier name in the **unsupportedCarrierName** field.
  """
  carrierCode: String!
  """
  The carrier name as provided by the user, when the carrier is not recognized by eBay Marketplace.
  **Note**: This field is only applicable if **carrierCode** is set to `UNSUPPORTED`.
  """
  unsupportedCarrierName: String
}

"""
This type is used to provide carrier and tracking details for the shipment associated with an order inquiry.
"""
input InquiryShipmentTrackingInput {
  """
  The standardized carrier code associated with the shipment (e.g., 'UPS', 'USPS', 'FEDEX').
  """
  shippingCarrier: InquiryShipmentCarrierInput!
  """
  The tracking number provided by the shipping carrier.
  **Minimum length**: 1
  **Maximum length**: 500
  **Format**: Alphanumeric
  """
  trackingNumber: String!
}

"""This type defines the priceline for International Shipping Price."""
type InternationalShippingPrice implements PriceLine {
  """The monetary value associated with the priceline item."""
  amount: AmountSet!
  """
  The human-readable priceline name. 
  **Note**: In this case, the name will always be returned as 'INTERNATIONAL_SHIPPING_PRICE'.  
  """
  name: String!
}

"""This type defines the priceline for International Shipping Tax."""
type InternationalShippingTax implements PriceLine {
  """The monetary value associated with the priceline item."""
  amount: AmountSet!
  """
  The human-readable priceline name. 
  **Note**: In this case, the name will always be returned as 'INTERNATIONAL_SHIPPING_TAX'.   
  """
  name: String!
}

"""
This type is used when currency conversion fails, provides details on why it failed. 
"""
type InvalidExchangeScenarioInputError implements BusinessError {
  """
  The unique identifier of the error, which will be INVALID_EXCHANGE_SCENARIO_INPUT when the input is invalid.
  """
  errorCode: String!
  """A human-readable description of the validation failure."""
  errorMessage: String!
}

"""
This type provides details of an external product that could not be used to create an eBay listing preview. Each invalid product includes a **description** field that explains why the external product details were unsuitable for creating a listing preview. The description is not localized and may change over time. This field is intended as a debugging aid for humans—-do not use **description** for client-side handling logic.
"""
type InvalidExternalProductDetails {
  """
  The external product details originally provided through the mutation request.
  """
  clientProvidedProductDetails: ExternalProductDetails!
  """
  A human-readable description of why the external product details could not be used to create an eBay listing preview. This field is intended as a debugging aid for humans--do not use description for client-side handling logic.
  """
  description: String!
}

"""
This type defines the business rule error that occurs when an offer message includes invalid content.
"""
type InvalidOfferMessage implements OfferBusinessRuleViolation {
  """
  The description of the business rule failure.
  **Maximum length**: 250 characters
  """
  ruleDescription: String!
}

"""
A scalar representing the payee for a transaction.
**Format**: String-encoded identifier for the payee.
**Usage**: Used to specify the payee in various transaction contexts.
Example: `BUYER` for the buyer and `SELLER` for the seller.
"""
scalar Invoicee

"""
An Item represents a specific, purchasable configuration within a listing. It includes a unique combination of identifying characteristics such global identifiers, listing terms, availability, price, and regulatory requirements necessary to complete a transaction. Every listing contains at least one item, providing a unified approach that works transparently across simple single-sku listings and complex multi-sku listing.
"""
type Item {
  """
  When present, the item is an auction with the contained details. When
  absent, the item is not available as an auction.
  """
  auctionDataSummary: AuctionDataSummary
  """ID of an item."""
  itemId: ID!
  """
  This container provides comprehensive access to all offer activity related to this item. This includes offer history, active offers requiring attention, current conversation statuses, and key statistics such as total offer count and the last accepted offer amount.
  """
  itemOfferOverview: ItemOfferOverview
  """
  The unique REST-based identifier of a purchasable item within an eBay listing. This identifier is used in eBay REST APIs to identify a purchasable item.
  # Format is "v1|<listingId>|<variationId> for multisku"
  # Format is "v1|<listingId>|0" for single sku
  """
  itemIdRestReference: ID
  """
  This object provides a Global Trade Item Number (GTIN) for a product or an eBay product ID (ePID) if defined for the item. For a multiple-SKU listing, the **traits** array is mandatory and identifies the unique traits of the variation within that multiple-SKU listing. Common unique traits within a multiple-SKU listing are 'Color' and 'Size'. For example, a 'Blue, Large' shirt. Each item in a multiple-SKU listing must have a unique combination of trait values.
  """
  itemSellerProduct: ItemSellerProduct
  """
  This object provides the pricing information, available quantity, and eco-participation fee (if applicable) for a purchasable item.
  """
  itemTerms: ItemTerms
  """
  The seller-defined Stock-Keeping Unit (SKU) value that is used to uniquely identify a purchaseable item in the listing. This field is mandatory for each variation defined for a multiple-variation listing, but it is optional for a single-SKU listing. If a seller would like the option to perform an action against a single-SKU listing using its SKU value instead of its listing ID, then they must include this value for the item.
  """
  sku: String
  """
  A list of user notes associated with this item. An empty list is returned if no user notes currently exist for this item.
  """
  userNotes: [UserNote!]! @authorize(scopes: ["https://api.ebay.com/oauth/api_scope/commerce.usernote&eBayUser"])
}

"""Input object for `itemBiddingActivity` query."""
input ItemBiddingActivityInput {
  """
  The unique identifier of the item for which the auction details are being requested.
  """
  itemId: ID!
}

"""Return payload for `itemBiddingActivity` query."""
type ItemBiddingActivityOutput {
  """Auction data for the requested auction item."""
  itemBiddingActivity: AuctionData!
}

"""
This type provides all details of an item commitment. An item commitment represents a buyer's confirmed intent to purchase an eBay item. This type includes key details such as the unique identifier of the item commitment, buyer information, seller information, price, and status.
"""
type ItemCommitment {
  """The unique identifier of an item commitment."""
  itemCommitmentId: ID!
  """
  This container shows any automated payment schedule details associated with the item commitment.
  **Note**: This container will only be exposed to the seller if applicable.
  """
  autoPaymentScheduleDetails: [AutoPaymentScheduleDetails!]
  """The buyer who committed to purchasing the item."""
  buyer: User!
  """
  This container is only returned if the item commitment has been cancelled, and includes the unique identifier of the cancellation.  
  """
  cancellation: ItemCommitmentCancellation
  """
  The unique identfier of the eBay marketplace where the item commitment was created.
  """
  committedMarketplace: Marketplace!
  """
  The exact date and time when the item commitment was initially created in the system. This marks the start of the item commitment lifecycle.   
  **Note**: Guaranteed to be non-null.
  """
  createdAt: DateTime!
  """
  This container shows any additional services related to the item commitment added by the buyer or seller.
  """
  itemCommitmentAddOnService: ItemCommitmentAddOnService
  """
  This container show details on the line item associated with the item commitment, including the identifier of the item, purchase quantity, how the item was purchased, and SKU value if defined.
  """
  lineItem: ContractListingItem!
  """
  This container shows detailed logistics information associated with the item commitment, describing how the purchased item(s) will be fulfilled, delivered, or made available to the buyer.
  **Note**: This container may be null or empty until the buyer selects one of the options under the **logisticsOptions** array.
  """
  logistics: PurchaseLogistics!
  """
  This array shows the set of logistics options available to the buyer for this item commitment. Each option includes method, cost, and estimated delivery time.
  """
  logisticsOptions: [ItemCommitmentLogisticsOptions!]
  """
  This container shows detailed information on any and all montetary transactions that occurred for the item commitment between any combination of buyer, seller, and eBay. Each entry represents a distinct payment-related detail within the item commitment lifecycle.
  """
  monetaryDetails: MonetaryDetails
  """
  This field is returned with a unique identifier of an order if there is an order associated with the item commitment. Unless an item commitment is cancelled or abandoned, an item commitment will become a paid order either directly or as part of a purchase quote. 
  """
  order: Order
  """
  This array shows the payment methods available to the buyer for this item commitment.
  """
  paymentOptions: [ItemCommitmentPaymentOption!]
  """
  This array is returned if the item commitment is associated with any purchase quote, which is a collection of two or more item commitments that will be paid for with one payment.
  """
  purchaseQuote: [PurchaseQuote!]
  """
  This container is only returned if there is a refund associated with the item commitment, and includes the unique identifier of the refund. 
  """
  refunds: [Refund!]
  """
  This container is only returned if there is a return request associated with the item commitment, and includes the unique identifier of the return request. 
  """
  returns: [OrderReturn!]
  """The seller who owns the eBay listing that spawned the item commitment."""
  seller: User!
  """
  This container provides Information on the current state of the item commitment. The information that one will see here will be dependent on the state of the item commitment.
  """
  state: ItemCommitmentState!
  """
  This container shows any custom tags added by the seller to the item commitment.
  **Note**: Custom tags can only be added by seller, so this container will only be exposed to the seller if the item commitment has one or more custom tags.
  """
  tags: PurchaseTags
  """
  This container shows total sales price of the eBay item associated with the item commitment, including any deposit for a motor vehicle. These monetary values will be shown in multiple currencies if the buyer or seller use a different currency than the default currency of the eBay marketplace.
  """
  totals: ItemCommitmentTotals!
  """
  The exact date and time when the item commitment was last modified or updated in the system. This timestamp captures any changes made to the item  commitment after initial creation, including change in state.
  **Note**: Guaranteed to be non-null.
  """
  updatedAt: DateTime!
}

"""
This type is used to express the state of an abandoned item commitment. An abandoned item commitment will not be fulfilled. This is a terminal, closed state, and no further action or modification is permitted.
"""
type ItemCommitmentAbandoned implements Labeled {
