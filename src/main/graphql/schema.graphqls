"""
The enumeration values in this type are used to enable active cross-border trading. In active cross-border trading, sellers selling on eBay US, eBay Canada, eBay UK, and eBay Ireland marketplaces can pay a small fee to have their listing exposed on other eBay marketplaces.
"""
enum CrossBorderTradingRegion {
  """
  This enumerated value is used by sellers selling on the eBay UK and eBay Ireland marketplaces if they want their listing to be exposed on North America marketplaces, including eBay US, US Motors, and eBay Canada (English and French versions) for a fee.
  """
  NORTH_AMERICA
  """
  This enumerated value is used by sellers selling on the eBay US and eBay Canada (English and French versions) marketplaces if they want their listing to be exposed on eBay UK and eBay Ireland marketplaces for a fee.
  """
  UNITED_KINGDOM
}

