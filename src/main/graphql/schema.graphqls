  - The date range for which bidding activity data are returned.
  - The maximum number of items that can appear on one page of the result set.
  
  When this container is omitted, by default the query returns:
  - A list of items for which the user has placed a bid during the previous 90-day window.
  - The first 20 results with pagination.
  """
  filter: BiddingActivityFilter
}

"""Your complete auction participation history response."""
type UserBiddingActivityOutput {
